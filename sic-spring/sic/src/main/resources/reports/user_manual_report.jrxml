	<parameter name="manualId" class="java.lang.String"/>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream"/>
	<parameter name="manualCode" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="manualTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="projectName" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="manualType" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="version" class="java.lang.String">
		<defaultValueExpression><![CDATA["1.0"]]></defaultValueExpression>
	</parameter>
	<parameter name="status" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="deliveryCode" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>

	<query language="sql"><![CDATA[SELECT 
                COALESCE(sec.section_code, 'SEC')                       AS "sectionCode",
                COALESCE(sec.section_title, 'หัวข้อ')                    AS "sectionTitle",
                COALESCE(sec.content, 'ไม่มีรายละเอียดเนื้อหา')             AS "content",
                COALESCE(sec.sort_order, 0)                             AS "sortOrder"
            FROM pm_user_manual_section sec
            WHERE sec.is_delete = false
              AND ($P{manualId} IS NULL OR $P{manualId} = '' OR sec.manual_id = CAST($P{manualId} AS uuid))
            ORDER BY sec.sort_order ASC, sec.created_date ASC;]]></query>

	<field name="sectionCode" class="java.lang.String"/>
	<field name="sectionTitle" class="java.lang.String"/>
	<field name="content" class="java.lang.String"/>
	<field name="sortOrder" class="java.lang.Integer"/>

