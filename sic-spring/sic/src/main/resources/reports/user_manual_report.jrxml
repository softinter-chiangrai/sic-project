							<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource(com.softinter.sicapi.util.ReportHelper.appendImages(com.softinter.sicapi.util.ReportHelper.extractContentBlocks($F{content} != null && !$F{content}.isBlank() ? $F{content} : ($P{lang}.equals("en") ? "No content provided." : "ไม่มีรายละเอียดเนื้อหา"), "-", 496), $P{attachmentGroupId}))]]></dataSourceExpression>
