<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DeliveryReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="e5f6a7b8-c9d0-1234-efab-567890123456">

    <!-- ========================================================
         STYLES DEFINITIONS
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="TableHeader" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B" backcolor="#F1F5F9"/>
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="deliveryId"       class="java.lang.String"/>
    <parameter name="exportDate"       class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="businessName"     class="java.lang.String"><defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression></parameter>
    <parameter name="logoStream"       class="java.io.InputStream"/>
    
    <parameter name="deliveryCode"     class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="deliveryTitle"    class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="projectName"      class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="contractNo"       class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="deliveryVersion"  class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="deliveryDate"     class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="status"           class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
    <parameter name="deliverySummary"  class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>

        <queryString>
        <![CDATA[
            SELECT 
                CONCAT('DELIVERABLE (', COALESCE(it.item_type, 'ITEM'), ')') AS "category",
                COALESCE(it.item_code, '-')                                 AS "code",
                COALESCE(it.item_title, '-')                                AS "title",
                COALESCE(it.item_status, 'DONE')                            AS "status",
                COALESCE(it.remark, '')                                     AS "remark"
            FROM pm_delivery_item it
            WHERE it.is_delete = false
              AND ($P{deliveryId} IS NULL OR $P{deliveryId} = '' OR it.delivery_id = CAST($P{deliveryId} AS uuid))
            UNION ALL
            SELECT 
                CONCAT('CHECKLIST (', COALESCE(chk.item_category, 'GENERAL'), ')') AS "category",
                '-'                                                         AS "code",
                COALESCE(chk.item_name, '-')                                AS "title",
                CASE WHEN chk.is_checked = true THEN 'PASS' ELSE 'PENDING' END AS "status",
                COALESCE(chk.remark, '')                                    AS "remark"
            FROM pm_delivery_checklist chk
            WHERE chk.is_delete = false
              AND ($P{deliveryId} IS NULL OR $P{deliveryId} = '' OR chk.delivery_id = CAST($P{deliveryId} AS uuid))
            ORDER BY "category" ASC;
        ]]>
    </queryString>

    <!-- ========================================================
         FIELDS (For Deliverables / Checklist Items Table)
         ======================================================== -->
    <field name="category"           class="java.lang.String"/>
    <field name="code"               class="java.lang.String"/>
    <field name="title"              class="java.lang.String"/>
    <field name="status"             class="java.lang.String"/>
    <field name="remark"             class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="260">
