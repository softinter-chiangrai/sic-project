	<parameter name="specificationId" class="java.lang.String"/>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
	</parameter>

	<query language="sql"><![CDATA[SELECT 
                s.specification_code                                 AS "specificationCode",
                s.title                                              AS "title",
                COALESCE(s.specification_type, 'System')             AS "specificationType",
                COALESCE(s.version, '1.0')                           AS "version",
                COALESCE(s.status, 'Draft')                          AS "status",
                COALESCE(s.priority, 'Medium')                       AS "priority",
                COALESCE(s.owner, '-')                               AS "owner",
                COALESCE(CAST(s.estimated_manday AS VARCHAR), '0')   AS "estimatedManday",
                COALESCE(p.project_name, '-')                        AS "projectName",
                COALESCE(r.title, '-')                               AS "requirementTitle",
                COALESCE(s.description, 'ไม่มีรายละเอียดเพิ่มเติม')          AS "description"
            FROM pm_specification s
            LEFT JOIN pm_customer_project p ON s.project_id = p.id
            LEFT JOIN pm_requirement r ON s.requirement_id = r.id
            WHERE s.is_delete = false
              AND ($P{specificationId} IS NULL OR $P{specificationId} = '' OR s.id = CAST($P{specificationId} AS uuid))
            ORDER BY s.created_date DESC
            LIMIT 1;]]></query>

	<field name="specificationCode" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="requirementTitle" class="java.lang.String"/>
	<field name="specificationType" class="java.lang.String"/>
	<field name="priority" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="owner" class="java.lang.String"/>
	<field name="estimatedManday" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>

