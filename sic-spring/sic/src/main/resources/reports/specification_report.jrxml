<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="SpecificationReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="c9d0e1f2-a3b4-5678-9012-cdefa3456789">

    <!-- ========================================================
         STYLES DEFINITIONS
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="specificationId" class="java.lang.String"/>
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>

        <queryString>
        <![CDATA[
            SELECT 
                s.specification_code                                 AS "specificationCode",
                s.title                                              AS "title",
                COALESCE(s.specification_type, 'System')             AS "specificationType",
                COALESCE(s.version, '1.0')                           AS "version",
                COALESCE(s.status, 'Draft')                          AS "status",
                COALESCE(s.priority, 'Medium')                       AS "priority",
                COALESCE(s.owner, '-')                               AS "owner",
                COALESCE(CAST(s.estimated_manday AS VARCHAR), '0')   AS "estimatedManday",
                COALESCE(p.project_name, '-')                        AS "projectName",
                COALESCE(r.title, '-')                               AS "requirementTitle",
                COALESCE(s.description, 'ไม่มีรายละเอียดเพิ่มเติม')          AS "description"
            FROM pm_specification s
            LEFT JOIN pm_customer_project p ON s.project_id = p.id
            LEFT JOIN pm_requirement r ON s.requirement_id = r.id
            WHERE s.is_delete = false
              AND ($P{specificationId} IS NULL OR $P{specificationId} = '' OR s.id = CAST($P{specificationId} AS uuid))
            ORDER BY s.created_date DESC
            LIMIT 1;
        ]]>
    </queryString>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="specificationCode"  class="java.lang.String"/>
    <field name="title"              class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="requirementTitle"   class="java.lang.String"/>
    <field name="specificationType"  class="java.lang.String"/>
    <field name="priority"           class="java.lang.String"/>
    <field name="status"             class="java.lang.String"/>
    <field name="owner"              class="java.lang.String"/>
    <field name="estimatedManday"    class="java.lang.String"/>
    <field name="description"        class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[($P{logoStream} != null ? $P{logoStream} : (this.getClass().getResourceAsStream("/images/softinter_logo.png") != null ? this.getClass().getResourceAsStream("/images/softinter_logo.png") : "../images/softinter_logo.png"))]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="DocTitle" x="230" y="0" width="285" height="26"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["เอกสารข้อกำหนดเชิงเทคนิค (Spec)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <text><![CDATA[Technical Specification Document]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="44" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Spec Main Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="28" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="75" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["หัวข้อ Spec:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="88" y="76" width="417" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{specificationCode} != null ? "[" + $F{specificationCode} + "] " : "") + ($F{title} != null ? $F{title} : "-")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Simple, Clean Sections & Natural Flow
         ======================================================== -->
    <detail>
        <band height="190" splitType="Stretch">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลทั่วไปของ Specification
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="6" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["1. ข้อมูลทั่วไปของข้อกำหนด (Specification Metadata)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="28" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Metadata Box -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="34" width="515" height="80" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>

            <!-- Row 1: Code & Status -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="38" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["รหัส Spec:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="105" y="38" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{specificationCode} != null ? $F{specificationCode} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="38" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["สถานะ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="365" y="38" width="143" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status} != null ? $F{status} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Project & Requirement -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="56" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["โครงการ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="105" y="56" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="56" width="115" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["อ้างอิง Requirement:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="390" y="56" width="118" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{requirementTitle} != null ? $F{requirementTitle} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Type & Priority -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="74" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ประเภท Spec:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="105" y="74" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{specificationType} != null ? $F{specificationType} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="74" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ความสำคัญ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="365" y="74" width="143" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{priority} != null ? $F{priority} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 4: Owner & Estimated Manday -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="92" width="115" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ผู้รับผิดชอบ (Owner):"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="130" y="92" width="123" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{owner} != null ? $F{owner} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="92" width="115" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ประมาณการ Manday:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="390" y="92" width="118" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{estimatedManday} != null ? $F{estimatedManday} : "0") + " " + "วัน"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: รายละเอียดข้อกำหนดเชิงเทคนิค (Description)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="124" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["2. รายละเอียดข้อกำหนดเชิงเทคนิค (Technical Specification Details)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="146" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Natural Flowing HTML Content without rigid fixed box -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="0" y="154" width="515" height="26"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2" markup="html"/>
                <textFieldExpression><![CDATA[$F{description} != null && !$F{description}.isBlank() ? $F{description} : "ไม่มีรายละเอียดเพิ่มเติม"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER (Must be placed before summary)
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="8" width="350" height="18"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="8" width="135" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[ + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ========================================================
         SUMMARY BAND: Sign-off Section (Will stay neatly together)
         ======================================================== -->
    <summary>
        <band height="180" splitType="Prevent">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: การลงนามและตรวจรับ Spec (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="10" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["3. การลงนามจัดทำและตรวจรับข้อกำหนด (Specification Sign-off)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="32" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Author / SA -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้ออกแบบ / จัดทำ (System Analyst / SA)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: System Analyst"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>

            <!-- Signatures: Lead / Reviewer -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="280" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้ตรวจรับข้อกำหนด (Tech Lead / PM)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
