<jasperReport name="SpecificationReport" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40" uuid="c9d0e1f2-a3b4-5678-9012-cdefa3456789">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SDLC"/>
