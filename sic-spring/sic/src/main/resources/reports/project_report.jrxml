<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="ProjectReport" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40" uuid="b2c3d4e5-f6a7-8901-bcde-fa2345678901">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SDLC"/>
	<style name="DocTitle" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="20.0" bold="true"/>
	<style name="DocSubtitle" forecolor="#64748B" fontName="TH Sarabun New" fontSize="13.0"/>
	<style name="SectionHeading" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="14.0" bold="true"/>
	<style name="Label" forecolor="#475569" fontName="TH Sarabun New" fontSize="13.0" bold="true"/>
	<style name="Value" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="13.0" bold="false"/>
	<style name="ValueBold" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="13.0" bold="true"/>
	<style name="ContentText" forecolor="#334155" fontName="TH Sarabun New" fontSize="13.0"/>
	<style name="FooterText" forecolor="#94A3B8" fontName="TH Sarabun New" fontSize="11.0"/>

	<parameter name="projectId" class="java.lang.String"/>
	<parameter name="lang" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
	</parameter>

	<query language="sql"><![CDATA[SELECT 
                p.project_code                                AS "projectCode",
                p.project_name                                AS "projectName",
                COALESCE(CASE WHEN $P{lang} = 'en' THEN c.company_name_en ELSE c.company_name_local END, c.company_name_en, c.company_name_local, '-') AS "customerName",
                COALESCE(p.status, '-')                       AS "status",
                COALESCE(p.priority, '-')                     AS "priority",
                COALESCE(TO_CHAR(p.start_date, 'DD/MM/YYYY'), '-') AS "startDate",
                COALESCE(TO_CHAR(p.planned_end_date, 'DD/MM/YYYY'), '-') AS "plannedEndDate",
                COALESCE(TO_CHAR(p.actual_end_date, 'DD/MM/YYYY'), '-') AS "actualEndDate",
                COALESCE(CAST(p.budget_manday AS VARCHAR), '0') AS "budgetManday",
                COALESCE(CAST(p.used_manday AS VARCHAR), '0')   AS "usedManday",
                CASE 
                    WHEN COALESCE(p.budget_manday, 0) > 0 
                    THEN CONCAT(CAST(ROUND(CAST(COALESCE(p.used_manday, 0) AS NUMERIC) / CAST(p.budget_manday AS NUMERIC) * 100) AS VARCHAR), '%')
                    ELSE '0%'
                END                                           AS "progress",
                COALESCE(p.description, CASE WHEN $P{lang} = 'en' THEN 'No additional details' ELSE 'ไม่มีรายละเอียดเพิ่มเติม' END) AS "description",
                TO_CHAR(p.created_date, 'DD/MM/YYYY HH24:MI') AS "createdDate",
                (SELECT STRING_AGG(su.file_name, ', ') FROM su_upload su
                    WHERE su.upload_group_id = p.attachment_group_id AND su.is_active = true) AS "attachmentNames",
                CAST((SELECT COUNT(*) FROM pm_requirement r WHERE r.project_id = p.id AND r.is_delete = false) AS VARCHAR) AS "totalRequirements",
                CAST((SELECT COUNT(*) FROM pm_specification s WHERE s.project_id = p.id AND s.is_delete = false) AS VARCHAR) AS "totalSpecifications",
                CAST((SELECT COUNT(*) FROM pm_phase ph WHERE ph.project_id = p.id AND ph.is_delete = false) AS VARCHAR) AS "totalPhases",
                CAST((SELECT COUNT(*) FROM pm_customer_contract cc WHERE cc.project_id = p.id AND cc.is_delete = false) AS VARCHAR) AS "totalContracts",
                CAST((SELECT COUNT(*) FROM pm_delivery d WHERE d.project_id = p.id AND d.is_delete = false) AS VARCHAR) AS "totalDeliveries",
                CAST((SELECT COUNT(*) FROM pm_invoice inv WHERE inv.project_id = p.id AND inv.is_delete = false) AS VARCHAR) AS "totalInvoices",
                CAST((SELECT COUNT(*) FROM pm_change_request cr WHERE cr.project_id = p.id AND cr.is_delete = false) AS VARCHAR) AS "totalChangeRequests",
                CAST((SELECT COUNT(*) FROM pm_ma_ticket mt WHERE mt.project_id = p.id AND mt.is_delete = false) AS VARCHAR) AS "totalMaTickets",
                CAST((SELECT COUNT(*) FROM pm_ma_renewal mr WHERE mr.project_id = p.id AND mr.is_delete = false) AS VARCHAR) AS "totalMaRenewals",
                CAST((SELECT COUNT(*) FROM pm_user_manual um WHERE um.project_id = p.id AND um.is_delete = false) AS VARCHAR) AS "totalUserManuals",
                CAST((SELECT COUNT(*) FROM pm_design_review dr WHERE dr.project_id = p.id AND dr.is_delete = false) AS VARCHAR) AS "totalDesignReviews",
                CAST((SELECT COUNT(*) FROM pm_diagram dg WHERE dg.project_id = p.id AND dg.is_delete = false) AS VARCHAR) AS "totalDiagrams",
                CAST((SELECT COUNT(*) FROM pm_bug bg WHERE bg.project_id = p.id AND bg.is_delete = false) AS VARCHAR) AS "totalBugs",
                CAST((SELECT COUNT(*) FROM pm_test_scenario ts WHERE ts.project_id = p.id AND ts.is_delete = false) AS VARCHAR) AS "totalTestScenarios",
                CAST((SELECT COUNT(*) FROM pm_test_case tc WHERE tc.project_id = p.id AND tc.is_delete = false) AS VARCHAR) AS "totalTestCases",
                CAST((SELECT COUNT(*) FROM pm_test_case tc WHERE tc.project_id = p.id AND tc.is_delete = false AND tc.test_status ILIKE 'pass%') AS VARCHAR) AS "passedTestCases",
                CAST((SELECT COUNT(*) FROM pm_test_case tc WHERE tc.project_id = p.id AND tc.is_delete = false AND tc.test_status ILIKE 'fail%') AS VARCHAR) AS "failedTestCases"
            FROM pm_customer_project p
            LEFT JOIN pm_customer c ON p.customer_id = c.id
            WHERE p.is_delete = false
              AND ($P{projectId} IS NULL OR $P{projectId} = '' OR p.id = CAST($P{projectId} AS uuid))
            ORDER BY p.created_date DESC
            LIMIT 1;]]></query>

	<field name="projectCode" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="customerName" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="priority" class="java.lang.String"/>
	<field name="startDate" class="java.lang.String"/>
	<field name="plannedEndDate" class="java.lang.String"/>
	<field name="actualEndDate" class="java.lang.String"/>
	<field name="budgetManday" class="java.lang.String"/>
	<field name="usedManday" class="java.lang.String"/>
	<field name="progress" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<field name="createdDate" class="java.lang.String"/>
	<field name="attachmentNames" class="java.lang.String"/>
	<field name="totalMaTickets" class="java.lang.String"/>
	<field name="totalMaRenewals" class="java.lang.String"/>
	<field name="totalUserManuals" class="java.lang.String"/>
	<field name="totalDesignReviews" class="java.lang.String"/>
	<field name="totalDiagrams" class="java.lang.String"/>
	<field name="totalBugs" class="java.lang.String"/>
	<field name="totalRequirements" class="java.lang.String"/>
	<field name="totalSpecifications" class="java.lang.String"/>
	<field name="totalPhases" class="java.lang.String"/>
	<field name="totalContracts" class="java.lang.String"/>
	<field name="totalDeliveries" class="java.lang.String"/>
	<field name="totalInvoices" class="java.lang.String"/>
	<field name="totalChangeRequests" class="java.lang.String"/>
	<field name="totalTestScenarios" class="java.lang.String"/>
	<field name="totalTestCases" class="java.lang.String"/>
	<field name="passedTestCases" class="java.lang.String"/>
	<field name="failedTestCases" class="java.lang.String"/>

