	<dataset name="BugsDataset" uuid="e00c0013-0013-0013-0013-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                bug_code                    AS "code",
                title                        AS "title",
                COALESCE(severity, '-')       AS "severity",
                COALESCE(priority, '-')        AS "priority",
                COALESCE(status, '-')           AS "status"
            FROM pm_bug
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="severity" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

