	<!-- ========================================================
	     SUB-DATASETS: แต่ละ module ของโครงการ ดึงข้อมูลด้วย SQL ของตัวเอง
	     ผ่าน connection เดียวกับ report หลัก (connectionExpression = $P{REPORT_CONNECTION})
	     กรองด้วย projectId ที่ส่งต่อมาจาก report หลัก
	     ======================================================== -->
	<dataset name="ContractsDataset" uuid="e00c0001-0001-0001-0001-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                contract_no                                                       AS "contractNo",
                COALESCE(contract_type, '-')                                      AS "contractType",
                COALESCE(TO_CHAR(contract_value, 'FM999,999,990.00'), '0.00')     AS "contractValue",
                COALESCE(sign_status, '-')                                        AS "signStatus",
                COALESCE(TO_CHAR(start_date, 'DD/MM/YYYY'), '-') || ' - ' || COALESCE(TO_CHAR(end_date, 'DD/MM/YYYY'), '-') AS "period"
            FROM pm_customer_contract
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="contractNo" class="java.lang.String"/>
		<field name="contractType" class="java.lang.String"/>
		<field name="contractValue" class="java.lang.String"/>
		<field name="signStatus" class="java.lang.String"/>
		<field name="period" class="java.lang.String"/>
	</dataset>

	<dataset name="RequirementsDataset" uuid="e00c0002-0002-0002-0002-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                requirement_code                    AS "code",
                title                                AS "title",
                COALESCE(requirement_type, '-')      AS "type",
                COALESCE(priority, '-')               AS "priority",
                COALESCE(status, '-')                 AS "status"
            FROM pm_requirement
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY requirement_code ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

	<dataset name="SpecificationsDataset" uuid="e00c0003-0003-0003-0003-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                specification_code                   AS "code",
                title                                 AS "title",
                COALESCE(specification_type, '-')     AS "type",
                COALESCE(priority, '-')                AS "priority",
                COALESCE(status, '-')                  AS "status"
            FROM pm_specification
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY specification_code ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

	<dataset name="PhasesDataset" uuid="e00c0004-0004-0004-0004-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(phase_code, '-')            AS "code",
                phase_name                            AS "name",
                COALESCE(TO_CHAR(start_date, 'DD/MM/YYYY'), '-') || ' - ' || COALESCE(TO_CHAR(end_date, 'DD/MM/YYYY'), '-') AS "period",
                COALESCE(status, '-')                 AS "status",
                CONCAT(COALESCE(progress, 0), '%')    AS "progress"
            FROM pm_phase
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY start_date ASC NULLS LAST]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="name" class="java.lang.String"/>
		<field name="period" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="progress" class="java.lang.String"/>
	</dataset>

	<dataset name="DeliveriesDataset" uuid="e00c0005-0005-0005-0005-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(delivery_code, '-')          AS "code",
                COALESCE(delivery_title, '-')          AS "title",
                COALESCE(delivery_type, '-')            AS "type",
                COALESCE(TO_CHAR(delivery_date, 'DD/MM/YYYY'), '-') AS "date",
                COALESCE(status, '-')                    AS "status"
            FROM pm_delivery
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY delivery_date ASC NULLS LAST]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="date" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

	<dataset name="InvoicesDataset" uuid="e00c0006-0006-0006-0006-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                invoice_no                                                    AS "invoiceNo",
                COALESCE(TO_CHAR(COALESCE(issue_date, invoice_date), 'DD/MM/YYYY'), '-') AS "issueDate",
                COALESCE(TO_CHAR(total_amount, 'FM999,999,990.00'), '0.00')   AS "totalAmount",
                COALESCE(payment_status, '-')                                  AS "paymentStatus",
                COALESCE(TO_CHAR(due_date, 'DD/MM/YYYY'), '-')                AS "dueDate"
            FROM pm_invoice
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY COALESCE(issue_date, invoice_date) ASC NULLS LAST]]></query>
		<field name="invoiceNo" class="java.lang.String"/>
		<field name="issueDate" class="java.lang.String"/>
		<field name="totalAmount" class="java.lang.String"/>
		<field name="paymentStatus" class="java.lang.String"/>
		<field name="dueDate" class="java.lang.String"/>
	</dataset>

	<dataset name="ChangeRequestsDataset" uuid="e00c0007-0007-0007-0007-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(cr_code, '-')     AS "code",
                title                       AS "title",
                COALESCE(priority, '-')      AS "priority",
                COALESCE(status, '-')         AS "status",
                COALESCE(change_level, '-')    AS "level"
            FROM pm_change_request
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="level" class="java.lang.String"/>
	</dataset>

	<dataset name="MaTicketsDataset" uuid="e00c0008-0008-0008-0008-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                ticket_no               AS "ticketNo",
                title                    AS "title",
                COALESCE(ticket_type, '-') AS "type",
                COALESCE(severity, '-')     AS "severity",
                COALESCE(status, '-')        AS "status"
            FROM pm_ma_ticket
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="ticketNo" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="severity" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

	<dataset name="MaRenewalsDataset" uuid="e00c0009-0009-0009-0009-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(renewal_no, '-') AS "renewalNo",
                COALESCE(TO_CHAR(current_end_date, 'DD/MM/YYYY'), '-') || ' -> ' || COALESCE(TO_CHAR(new_end_date, 'DD/MM/YYYY'), '-') AS "period",
                COALESCE(TO_CHAR(proposed_amount, 'FM999,999,990.00'), '0.00') AS "amount",
                COALESCE(status, '-') AS "status"
            FROM pm_ma_renewal
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="renewalNo" class="java.lang.String"/>
		<field name="period" class="java.lang.String"/>
		<field name="amount" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

	<dataset name="UserManualsDataset" uuid="e00c0010-0010-0010-0010-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(manual_code, '-')  AS "code",
                COALESCE(manual_title, '-')  AS "title",
                COALESCE(manual_type, '-')    AS "type",
                COALESCE(version, '-')         AS "version",
                COALESCE(status, '-')           AS "status"
            FROM pm_user_manual
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="version" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

	<dataset name="DesignReviewsDataset" uuid="e00c0011-0011-0011-0011-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(review_code, '-')      AS "code",
                COALESCE(title, '-')              AS "title",
                COALESCE(review_item_type, '-')    AS "targetType",
                COALESCE(severity, '-')             AS "severity",
                COALESCE(status, '-')                AS "status"
            FROM pm_design_review
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="targetType" class="java.lang.String"/>
		<field name="severity" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>

	<dataset name="DiagramsDataset" uuid="e00c0012-0012-0012-0012-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(diagram_code, '-') AS "code",
                name                          AS "name",
                COALESCE(diagram_type, '-')    AS "type"
            FROM pm_diagram
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY sort_order ASC, created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="name" class="java.lang.String"/>
