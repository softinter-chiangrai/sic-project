<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ProjectReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="b2c3d4e5-f6a7-8901-bcde-fa2345678901">

    <!-- ========================================================
         STYLES DEFINITIONS (Clean, Minimal & Elegant)
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="projectId" class="java.lang.String"/>
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>

        <queryString>
        <![CDATA[
            SELECT 
                p.project_code                                AS "projectCode",
                p.project_name                                AS "projectName",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(p.status, '-')                       AS "status",
                COALESCE(p.priority, '-')                     AS "priority",
                COALESCE(TO_CHAR(p.start_date, 'DD/MM/YYYY'), '-') AS "startDate",
                COALESCE(TO_CHAR(p.planned_end_date, 'DD/MM/YYYY'), '-') AS "plannedEndDate",
                COALESCE(TO_CHAR(p.actual_end_date, 'DD/MM/YYYY'), '-') AS "actualEndDate",
                COALESCE(CAST(p.budget_manday AS VARCHAR), '0') AS "budgetManday",
                COALESCE(CAST(p.used_manday AS VARCHAR), '0')   AS "usedManday",
                CASE 
                    WHEN COALESCE(p.budget_manday, 0) > 0 
                    THEN CONCAT(CAST(ROUND(CAST(COALESCE(p.used_manday, 0) AS NUMERIC) / CAST(p.budget_manday AS NUMERIC) * 100) AS VARCHAR), '%')
                    ELSE '0%'
                END                                           AS "progress",
                COALESCE(p.description, 'ไม่มีรายละเอียดเพิ่มเติม') AS "description",
                TO_CHAR(p.created_date, 'DD/MM/YYYY HH24:MI') AS "createdDate"
            FROM pm_customer_project p
            LEFT JOIN pm_customer c ON p.customer_id = c.id
            WHERE p.is_delete = false
              AND ($P{projectId} IS NULL OR $P{projectId} = '' OR p.id = CAST($P{projectId} AS uuid))
            ORDER BY p.created_date DESC
            LIMIT 1;
        ]]>
    </queryString>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="projectCode"     class="java.lang.String"/>
    <field name="projectName"     class="java.lang.String"/>
    <field name="customerName"    class="java.lang.String"/>
    <field name="status"          class="java.lang.String"/>
    <field name="priority"        class="java.lang.String"/>
    <field name="startDate"       class="java.lang.String"/>
    <field name="plannedEndDate"  class="java.lang.String"/>
    <field name="actualEndDate"   class="java.lang.String"/>
    <field name="budgetManday"    class="java.lang.String"/>
    <field name="usedManday"      class="java.lang.String"/>
    <field name="progress"        class="java.lang.String"/>
    <field name="description"     class="java.lang.String"/>
    <field name="createdDate"     class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[($P{logoStream} != null ? $P{logoStream} : (this.getClass().getResourceAsStream("/images/softinter_logo.png") != null ? this.getClass().getResourceAsStream("/images/softinter_logo.png") : "../images/softinter_logo.png"))]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="DocTitle" x="230" y="0" width="285" height="26"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["รายงานข้อมูลโครงการ (Project Report)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <text><![CDATA[Project Overview & Summary Report]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="44" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Project Name Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="28" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="75" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ชื่อโครงการ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="88" y="76" width="417" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{projectCode} != null ? "[" + $F{projectCode} + "] " : "") + ($F{projectName} != null ? $F{projectName} : "-")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Simple, Clean Sections & Natural Flow
         ======================================================== -->
    <detail>
        <band height="280" splitType="Stretch">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลทั่วไป (General Information)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="6" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["1. ข้อมูลทั่วไป (General Information)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="28" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Metadata Box 1 -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="34" width="515" height="64" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>

            <!-- Row 1: Code & Status -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="38" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["รหัสโครงการ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="105" y="38" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{projectCode} != null ? $F{projectCode} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="38" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["สถานะ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="360" y="38" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status} != null ? $F{status} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Customer & Priority -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="56" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ลูกค้า / องค์กร:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="105" y="56" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="56" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ความสำคัญ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="360" y="56" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{priority} != null ? $F{priority} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Created Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="74" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันที่สร้าง:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="105" y="74" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{createdDate} != null ? $F{createdDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: แผนงานและสถิติ (Timeline & Manday)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="110" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["2. แผนงานและระยะเวลา (Timeline & Workload)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="132" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Timeline Box -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="138" width="515" height="64" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>

            <!-- Row 1: Start Date & Planned End Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="142" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันที่เริ่มต้น:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="120" y="142" width="133" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{startDate} != null ? $F{startDate} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="142" width="125" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["แผนสิ้นสุด:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="400" y="142" width="108" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{plannedEndDate} != null ? $F{plannedEndDate} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Actual End Date & Progress -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="160" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["สิ้นสุดจริง:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="120" y="160" width="133" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{actualEndDate} != null ? $F{actualEndDate} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="160" width="125" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ความคืบหน้า (Manday):"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="400" y="160" width="108" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{progress} != null ? $F{progress} : "0%"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Budget & Used Manday -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="178" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["งบประมาณ Manday:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="120" y="178" width="133" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{budgetManday} != null ? $F{budgetManday} : "0") + " " + "วัน"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="178" width="125" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Manday ที่ใช้ไป:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="400" y="178" width="108" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{usedManday} != null ? $F{usedManday} : "0") + " " + "วัน"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: รายละเอียดขอบเขตโครงการ (Scope & Description)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="214" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["3. รายละเอียดและขอบเขตโครงการ (Scope & Description)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="236" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Natural Flowing HTML Content -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="0" y="244" width="515" height="26"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2" markup="html"/>
                <textFieldExpression><![CDATA[$F{description} != null && !$F{description}.isBlank() ? $F{description} : "ไม่มีรายละเอียดเพิ่มเติม"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER (Must be placed before summary)
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="8" width="350" height="18"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="8" width="135" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[ + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ========================================================
         SUMMARY BAND: Sign-off Section (Will stay neatly together)
         ======================================================== -->
    <summary>
        <band height="180" splitType="Prevent">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การลงนามรับรอง (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="10" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["4. การลงนามอนุมัติและรับรอง (Sign-off & Approvals)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="32" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Project Manager -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้รับผิดชอบโครงการ (Project Manager)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>

            <!-- Signatures: Customer / Approver -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="280" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้อนุมัติ / ตัวแทนลูกค้า (Authorized)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
