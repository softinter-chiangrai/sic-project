<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ProjectReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="b2c3d4e5-f6a7-8901-bcde-fa2345678901">

    <!-- ========================================================
         STYLES DEFINITIONS (Clean, Minimal & Elegant)
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream"/>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="projectCode"        class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="customerName"       class="java.lang.String"/>
    <field name="status"             class="java.lang.String"/>
    <field name="priority"           class="java.lang.String"/>
    <field name="startDate"          class="java.lang.String"/>
    <field name="plannedEndDate"     class="java.lang.String"/>
    <field name="actualEndDate"      class="java.lang.String"/>
    <field name="budgetManday"       class="java.lang.String"/>
    <field name="usedManday"         class="java.lang.String"/>
    <field name="progress"           class="java.lang.String"/>
    <field name="description"        class="java.lang.String"/>
    <field name="createdDate"        class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company Name -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[$P{logoStream}]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Document Name & Export Date -->
            <staticText>
                <reportElement style="DocTitle" x="230" y="0" width="285" height="24"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[รายงานสรุปข้อมูลโครงการ]]></text>
            </staticText>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Project Summary Report]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="42" width="285" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Clean Top Divider Line -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Project Main Title Banner (Clean Light Box) -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="26" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="10" y="77" width="60" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ชื่อโครงการ:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="72" y="77" width="433" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{projectCode} != null ? "[" + $F{projectCode} + "] " : "") + ($F{projectName} != null ? $F{projectName} : "-")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Simple, Clean Sections
         ======================================================== -->
    <detail>
        <band height="550">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลทั่วไป (General Information)
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" x="0" y="8" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[1. ข้อมูลทั่วไป (General Information)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="28" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: Code & Status -->
            <staticText>
                <reportElement style="Label" x="10" y="34" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[รหัสโครงการ:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="98" y="34" width="155" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{projectCode} != null ? $F{projectCode} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="34" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[สถานะ:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="358" y="34" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status} != null ? $F{status} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Customer & Priority -->
            <staticText>
                <reportElement style="Label" x="10" y="54" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ลูกค้า / องค์กร:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="98" y="54" width="155" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="54" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ความสำคัญ:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="358" y="54" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{priority} != null ? $F{priority} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Created Date -->
            <staticText>
                <reportElement style="Label" x="10" y="74" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[วันที่สร้าง:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="98" y="74" width="155" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{createdDate} != null ? $F{createdDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: แผนงานและสถิติ (Timeline & Manday)
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" x="0" y="106" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[2. แผนงานและระยะเวลา (Timeline & Workload)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="126" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: Start Date & Planned End Date -->
            <staticText>
                <reportElement style="Label" x="10" y="132" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[วันที่เริ่มต้น:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="118" y="132" width="135" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{startDate} != null ? $F{startDate} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="132" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[กำหนดสิ้นสุดตามแผน:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="378" y="132" width="130" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{plannedEndDate} != null ? $F{plannedEndDate} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Actual End Date & Progress -->
            <staticText>
                <reportElement style="Label" x="10" y="152" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[วันที่สิ้นสุดจริง:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="118" y="152" width="135" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{actualEndDate} != null ? $F{actualEndDate} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="152" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ความคืบหน้า:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="378" y="152" width="130" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{progress} != null ? $F{progress} : "0%"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Budget Manday & Used Manday -->
            <staticText>
                <reportElement style="Label" x="10" y="172" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Manday ตามแผน:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="118" y="172" width="135" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{budgetManday} != null ? $F{budgetManday} : "0") + " วัน"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="172" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Manday ใช้จริง:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="378" y="172" width="130" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{usedManday} != null ? $F{usedManday} : "0") + " วัน"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: รายละเอียดขอบเขตโครงการ (Scope & Description)
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" x="0" y="204" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[3. รายละเอียดและขอบเขตโครงการ (Scope & Description)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="224" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Clean Outline Box for Content -->
            <rectangle radius="3">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="232" width="515" height="130" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="10" y="238" width="495" height="118"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2"/>
                <textFieldExpression><![CDATA[$F{description} != null && !$F{description}.isBlank() ? $F{description} : "ไม่มีรายละเอียดเพิ่มเติม"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การลงนามรับรอง (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" positionType="Float" x="0" y="378" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[4. การลงนามอนุมัติและรับรอง (Sign-off & Approvals)]]></text>
            </staticText>
            <line>
                <reportElement positionType="Float" x="0" y="398" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Project Manager -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="410" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" positionType="Float" x="10" y="416" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ผู้รับผิดชอบโครงการ (Project Manager)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="465" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="487" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ตำแหน่ง: .....................................................]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="508" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[วันที่: ........ / ........ / ................]]></text>
            </staticText>

            <!-- Signatures: Customer / Approver -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="410" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" positionType="Float" x="280" y="416" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ผู้อนุมัติ / ตัวแทนลูกค้า (Authorized)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="465" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="487" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ตำแหน่ง: .....................................................]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="508" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[วันที่: ........ / ........ / ................]]></text>
            </staticText>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="10" width="350" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="10" width="135" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["หน้า " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
