		<band height="90" splitType="Stretch">
			<element kind="textField" textAdjust="StretchHeight" uuid="e00e0007-0001-0001-0001-a1b2c3d4e5f6" positionType="Float" x="0" y="6" width="515" height="22" blankWhenNull="true" vTextAlign="Bottom" style="SectionHeading">
				<expression><![CDATA[($P{lang}.equals("en") ? "10. Invoices" : "10. ใบแจ้งหนี้ (Invoices)")]]></expression>
			</element>
			<element kind="line" uuid="e00e0007-0002-0002-0002-a1b2c3d4e5f6" positionType="Float" x="0" y="28" width="515" height="1" forecolor="#CBD5E1">
				<pen lineWidth="0.6"/>
			</element>
			<element kind="component" uuid="e00e0007-0003-0003-0003-a1b2c3d4e5f6" positionType="Float" stretchType="ContainerHeight" x="0" y="34" width="515" height="16">
				<component kind="list">
					<datasetRun uuid="e00e0007-0004-0004-0004-a1b2c3d4e5f6" subDataset="InvoicesDataset">
						<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
						<parameter name="projectId">
							<expression><![CDATA[$P{projectId}]]></expression>
						</parameter>
						<parameter name="lang">
							<expression><![CDATA[$P{lang}]]></expression>
						</parameter>
					</datasetRun>
					<contents height="68" width="515">
						<element kind="textField" uuid="e00e0007-0005-0005-0005-a1b2c3d4e5f6" positionType="Float" x="0" y="0" width="515" height="16" textAdjust="StretchHeight" blankWhenNull="true" style="ValueBold">
							<expression><![CDATA["[" + $F{invoiceNo} + "]  " + ($P{lang}.equals("en") ? "Total: " : "ยอดรวม: ") + $F{totalAmount}]]></expression>
						</element>
						<element kind="textField" uuid="e00e0007-0006-0006-0006-a1b2c3d4e5f6" positionType="Float" x="0" y="16" width="515" height="14" textAdjust="StretchHeight" blankWhenNull="true" style="ContentText">
							<expression><![CDATA[($P{lang}.equals("en") ? "Issue Date: " : "วันที่ออก: ") + $F{issueDate} + "   " + ($P{lang}.equals("en") ? "Due: " : "ครบกำหนด: ") + $F{dueDate} + "   " + ($P{lang}.equals("en") ? "Payment: " : "สถานะการจ่าย: ") + $F{paymentStatus} + "   " + ($P{lang}.equals("en") ? "Billing: " : "ประเภทเรียกเก็บ: ") + $F{billingType} + "   " + ($P{lang}.equals("en") ? "Subtotal: " : "ก่อนภาษี: ") + $F{subtotalAmount}]]></expression>
						</element>
						<element kind="textField" textAdjust="StretchHeight" uuid="e00e0007-0007-0007-0007-a1b2c3d4e5f6" positionType="Float" x="0" y="30" width="515" height="14" blankWhenNull="true" style="Label">
							<expression><![CDATA[($F{remark} == null || $F{remark}.isBlank()) ? null : ($P{lang}.equals("en") ? "Remark:" : "หมายเหตุ:")]]></expression>
						</element>
						<!-- Text + inline images + tables in original order (real List component, unlimited rows) -->
				<element kind="component" uuid="d0ee951e-f1d6-49c0-ac1b-30e4480afec5" positionType="Float" x="0" y="44" width="515" height="14">
