	<dataset name="ContractsDataset" uuid="e00c0001-0001-0001-0001-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                contract_no                                                       AS "contractNo",
                COALESCE(contract_type, '-')                                      AS "contractType",
                COALESCE(TO_CHAR(contract_value, 'FM999,999,990.00'), '0.00')     AS "contractValue",
                COALESCE(sign_status, '-')                                        AS "signStatus",
                COALESCE(TO_CHAR(start_date, 'DD/MM/YYYY'), '-') || ' - ' || COALESCE(TO_CHAR(end_date, 'DD/MM/YYYY'), '-') AS "period",
                payment_terms                                                      AS "paymentTerms",
                scope_summary                                                       AS "scopeSummary"
            FROM pm_customer_contract
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="contractNo" class="java.lang.String"/>
		<field name="contractType" class="java.lang.String"/>
		<field name="contractValue" class="java.lang.String"/>
		<field name="signStatus" class="java.lang.String"/>
		<field name="period" class="java.lang.String"/>
		<field name="paymentTerms" class="java.lang.String"/>
		<field name="scopeSummary" class="java.lang.String"/>
	</dataset>
	<dataset name="RequirementsDataset" uuid="e00c0002-0002-0002-0002-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                requirement_code                    AS "code",
                title                                AS "title",
                COALESCE(requirement_type, '-')      AS "type",
                COALESCE(priority, '-')               AS "priority",
                COALESCE(status, '-')                 AS "status",
                description                            AS "description",
                business_value                          AS "businessValue",
                acceptance_criteria                      AS "acceptanceCriteria"
            FROM pm_requirement
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY requirement_code ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="businessValue" class="java.lang.String"/>
		<field name="acceptanceCriteria" class="java.lang.String"/>
	</dataset>
	<dataset name="SpecificationsDataset" uuid="e00c0003-0003-0003-0003-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                specification_code                   AS "code",
                title                                 AS "title",
                COALESCE(specification_type, '-')     AS "type",
                COALESCE(priority, '-')                AS "priority",
                COALESCE(status, '-')                  AS "status",
                description                              AS "description"
            FROM pm_specification
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY specification_code ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
	</dataset>
	<dataset name="PhasesDataset" uuid="e00c0004-0004-0004-0004-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(phase_code, '-')            AS "code",
                phase_name                            AS "name",
                COALESCE(TO_CHAR(start_date, 'DD/MM/YYYY'), '-') || ' - ' || COALESCE(TO_CHAR(end_date, 'DD/MM/YYYY'), '-') AS "period",
                COALESCE(status, '-')                 AS "status",
                CONCAT(COALESCE(progress, 0), '%')    AS "progress",
                description                             AS "description"
            FROM pm_phase
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY start_date ASC NULLS LAST]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="name" class="java.lang.String"/>
		<field name="period" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="progress" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
	</dataset>
	<dataset name="DeliveriesDataset" uuid="e00c0005-0005-0005-0005-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(delivery_code, '-')          AS "code",
                COALESCE(delivery_title, '-')          AS "title",
                COALESCE(delivery_type, '-')            AS "type",
                COALESCE(TO_CHAR(delivery_date, 'DD/MM/YYYY'), '-') AS "date",
                COALESCE(status, '-')                    AS "status",
                delivery_summary                           AS "deliverySummary",
                release_note                                AS "releaseNote",
                COALESCE(delivery_version, '-')               AS "deliveryVersion"
            FROM pm_delivery
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY delivery_date ASC NULLS LAST]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="date" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="deliverySummary" class="java.lang.String"/>
		<field name="deliveryVersion" class="java.lang.String"/>
		<field name="releaseNote" class="java.lang.String"/>
	</dataset>
	<dataset name="InvoicesDataset" uuid="e00c0006-0006-0006-0006-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                invoice_no                                                    AS "invoiceNo",
                COALESCE(TO_CHAR(COALESCE(issue_date, invoice_date), 'DD/MM/YYYY'), '-') AS "issueDate",
                COALESCE(TO_CHAR(total_amount, 'FM999,999,990.00'), '0.00')   AS "totalAmount",
                COALESCE(payment_status, '-')                                  AS "paymentStatus",
                COALESCE(TO_CHAR(due_date, 'DD/MM/YYYY'), '-')                AS "dueDate",
                remark                                                          AS "remark",
                COALESCE(billing_type, '-')                                      AS "billingType",
                COALESCE(TO_CHAR(subtotal_amount, 'FM999,999,990.00'), '0.00')   AS "subtotalAmount"
            FROM pm_invoice
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY COALESCE(issue_date, invoice_date) ASC NULLS LAST]]></query>
		<field name="invoiceNo" class="java.lang.String"/>
		<field name="issueDate" class="java.lang.String"/>
		<field name="totalAmount" class="java.lang.String"/>
		<field name="paymentStatus" class="java.lang.String"/>
		<field name="dueDate" class="java.lang.String"/>
		<field name="billingType" class="java.lang.String"/>
		<field name="subtotalAmount" class="java.lang.String"/>
		<field name="remark" class="java.lang.String"/>
	</dataset>
	<dataset name="ChangeRequestsDataset" uuid="e00c0007-0007-0007-0007-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(cr_code, '-')     AS "code",
                title                       AS "title",
                COALESCE(priority, '-')      AS "priority",
                COALESCE(status, '-')         AS "status",
                COALESCE(change_level, '-')    AS "level",
                description                     AS "description",
                COALESCE(change_reason, '-')     AS "changeReason"
            FROM pm_change_request
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="level" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="changeReason" class="java.lang.String"/>
	</dataset>
	<dataset name="MaTicketsDataset" uuid="e00c0008-0008-0008-0008-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                ticket_no               AS "ticketNo",
                title                    AS "title",
                COALESCE(ticket_type, '-') AS "type",
                COALESCE(severity, '-')     AS "severity",
                COALESCE(status, '-')        AS "status",
                description                   AS "description",
                resolution_summary              AS "resolutionSummary"
            FROM pm_ma_ticket
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="ticketNo" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="severity" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="resolutionSummary" class="java.lang.String"/>
	</dataset>
	<dataset name="MaRenewalsDataset" uuid="e00c0009-0009-0009-0009-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(renewal_no, '-') AS "renewalNo",
                COALESCE(TO_CHAR(current_end_date, 'DD/MM/YYYY'), '-') || ' -> ' || COALESCE(TO_CHAR(new_end_date, 'DD/MM/YYYY'), '-') AS "period",
                COALESCE(TO_CHAR(proposed_amount, 'FM999,999,990.00'), '0.00') AS "amount",
                COALESCE(status, '-') AS "status",
                remark AS "remark"
            FROM pm_ma_renewal
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="renewalNo" class="java.lang.String"/>
		<field name="period" class="java.lang.String"/>
		<field name="amount" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="remark" class="java.lang.String"/>
	</dataset>
	<dataset name="UserManualsDataset" uuid="e00c0010-0010-0010-0010-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                CAST(id AS VARCHAR)          AS "manualId",
                COALESCE(manual_code, '-')  AS "code",
                COALESCE(manual_title, '-')  AS "title",
                COALESCE(manual_type, '-')    AS "type",
                COALESCE(version, '-')         AS "version",
                COALESCE(status, '-')           AS "status"
            FROM pm_user_manual
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="manualId" class="java.lang.String"/>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
		<field name="version" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
	</dataset>
	<dataset name="UserManualSectionsDataset" uuid="e00c0014-0014-0014-0014-a1b2c3d4e5f6">
		<parameter name="manualId" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(section_title, '-') AS "sectionTitle",
                content                         AS "content"
            FROM pm_user_manual_section
            WHERE manual_id = CAST($P{manualId} AS uuid) AND is_delete = false
            ORDER BY sort_order ASC]]></query>
		<field name="sectionTitle" class="java.lang.String"/>
		<field name="content" class="java.lang.String"/>
	</dataset>
	<dataset name="DesignReviewsDataset" uuid="e00c0011-0011-0011-0011-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(review_code, '-')      AS "code",
                COALESCE(title, '-')              AS "title",
                COALESCE(review_item_type, '-')    AS "targetType",
                COALESCE(severity, '-')             AS "severity",
                COALESCE(status, '-')                AS "status",
                description                            AS "description",
                COALESCE(assigned_to, '-')               AS "assignedTo",
                COALESCE(TO_CHAR(due_date, 'DD/MM/YYYY'), '-') AS "dueDate"
            FROM pm_design_review
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="targetType" class="java.lang.String"/>
		<field name="severity" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="assignedTo" class="java.lang.String"/>
		<field name="dueDate" class="java.lang.String"/>
	</dataset>
	<dataset name="DiagramsDataset" uuid="e00c0012-0012-0012-0012-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                COALESCE(diagram_code, '-') AS "code",
                name                          AS "name",
                COALESCE(diagram_type, '-')    AS "type"
            FROM pm_diagram
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY sort_order ASC, created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="name" class="java.lang.String"/>
		<field name="type" class="java.lang.String"/>
	</dataset>
	<dataset name="BugsDataset" uuid="e00c0013-0013-0013-0013-a1b2c3d4e5f6">
		<parameter name="projectId" class="java.lang.String"/>
		<parameter name="lang" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
                bug_code                    AS "code",
                title                        AS "title",
                COALESCE(severity, '-')       AS "severity",
                COALESCE(priority, '-')        AS "priority",
                COALESCE(status, '-')           AS "status",
                description                      AS "description",
                steps_to_reproduce                AS "stepsToReproduce",
                COALESCE(environment, '-')          AS "environment"
            FROM pm_bug
            WHERE project_id = CAST($P{projectId} AS uuid) AND is_delete = false
            ORDER BY created_date ASC]]></query>
		<field name="code" class="java.lang.String"/>
		<field name="title" class="java.lang.String"/>
		<field name="severity" class="java.lang.String"/>
		<field name="priority" class="java.lang.String"/>
		<field name="status" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="stepsToReproduce" class="java.lang.String"/>
		<field name="environment" class="java.lang.String"/>
	</dataset>
	<parameter name="projectId" class="java.lang.String"/>
	<parameter name="lang" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
                p.project_code                                AS "projectCode",
                p.project_name                                AS "projectName",
                COALESCE(CASE WHEN $P{lang} = 'en' THEN c.company_name_en ELSE c.company_name_local END, c.company_name_en, c.company_name_local, '-') AS "customerName",
                COALESCE(p.status, '-')                       AS "status",
                COALESCE(p.priority, '-')                     AS "priority",
                COALESCE(TO_CHAR(p.start_date, 'DD/MM/YYYY'), '-') AS "startDate",
                COALESCE(TO_CHAR(p.planned_end_date, 'DD/MM/YYYY'), '-') AS "plannedEndDate",
                COALESCE(CAST(p.budget_manday AS VARCHAR), '0') AS "budgetManday",
                COALESCE(CAST(p.used_manday AS VARCHAR), '0')   AS "usedManday",
                CASE 
                    WHEN COALESCE(p.budget_manday, 0) > 0 
                    THEN CONCAT(CAST(ROUND(CAST(COALESCE(p.used_manday, 0) AS NUMERIC) / CAST(p.budget_manday AS NUMERIC) * 100) AS VARCHAR), '%')
                    ELSE '0%'
                END                                           AS "progress",
                COALESCE(p.description, CASE WHEN $P{lang} = 'en' THEN 'No additional details' ELSE 'ไม่มีรายละเอียดเพิ่มเติม' END) AS "description",
                TO_CHAR(p.created_date, 'DD/MM/YYYY HH24:MI') AS "createdDate",
                (SELECT STRING_AGG(su.file_name || ' (' || COALESCE(UPPER(substring(su.file_name from '\.([^.]+)$')) || ', ', '') || pg_size_pretty(su.file_size) || ')', ', ') FROM su_upload su
                    WHERE su.upload_group_id = p.attachment_group_id AND su.is_active = true) AS "attachmentNames",
                CAST((SELECT COUNT(*) FROM pm_requirement r WHERE r.project_id = p.id AND r.is_delete = false) AS VARCHAR) AS "totalRequirements",
                CAST((SELECT COUNT(*) FROM pm_specification s WHERE s.project_id = p.id AND s.is_delete = false) AS VARCHAR) AS "totalSpecifications",
                CAST((SELECT COUNT(*) FROM pm_phase ph WHERE ph.project_id = p.id AND ph.is_delete = false) AS VARCHAR) AS "totalPhases",
                CAST((SELECT COUNT(*) FROM pm_customer_contract cc WHERE cc.project_id = p.id AND cc.is_delete = false) AS VARCHAR) AS "totalContracts",
                CAST((SELECT COUNT(*) FROM pm_delivery d WHERE d.project_id = p.id AND d.is_delete = false) AS VARCHAR) AS "totalDeliveries",
                CAST((SELECT COUNT(*) FROM pm_invoice inv WHERE inv.project_id = p.id AND inv.is_delete = false) AS VARCHAR) AS "totalInvoices",
                CAST((SELECT COUNT(*) FROM pm_change_request cr WHERE cr.project_id = p.id AND cr.is_delete = false) AS VARCHAR) AS "totalChangeRequests",
                CAST((SELECT COUNT(*) FROM pm_ma_ticket mt WHERE mt.project_id = p.id AND mt.is_delete = false) AS VARCHAR) AS "totalMaTickets",
                CAST((SELECT COUNT(*) FROM pm_ma_renewal mr WHERE mr.project_id = p.id AND mr.is_delete = false) AS VARCHAR) AS "totalMaRenewals",
                CAST((SELECT COUNT(*) FROM pm_user_manual um WHERE um.project_id = p.id AND um.is_delete = false) AS VARCHAR) AS "totalUserManuals",
                CAST((SELECT COUNT(*) FROM pm_design_review dr WHERE dr.project_id = p.id AND dr.is_delete = false) AS VARCHAR) AS "totalDesignReviews",
                CAST((SELECT COUNT(*) FROM pm_diagram dg WHERE dg.project_id = p.id AND dg.is_delete = false) AS VARCHAR) AS "totalDiagrams",
                CAST((SELECT COUNT(*) FROM pm_bug bg WHERE bg.project_id = p.id AND bg.is_delete = false) AS VARCHAR) AS "totalBugs",
                CAST((SELECT COUNT(*) FROM pm_test_scenario ts WHERE ts.project_id = p.id AND ts.is_delete = false) AS VARCHAR) AS "totalTestScenarios",
                CAST((SELECT COUNT(*) FROM pm_test_case tc WHERE tc.project_id = p.id AND tc.is_delete = false) AS VARCHAR) AS "totalTestCases",
                CAST((SELECT COUNT(*) FROM pm_test_case tc WHERE tc.project_id = p.id AND tc.is_delete = false AND tc.test_status ILIKE 'pass%') AS VARCHAR) AS "passedTestCases",
                CAST((SELECT COUNT(*) FROM pm_test_case tc WHERE tc.project_id = p.id AND tc.is_delete = false AND tc.test_status ILIKE 'fail%') AS VARCHAR) AS "failedTestCases"
            FROM pm_customer_project p
            LEFT JOIN pm_customer c ON p.customer_id = c.id
            WHERE p.is_delete = false
              AND ($P{projectId} IS NULL OR $P{projectId} = '' OR p.id = CAST($P{projectId} AS uuid))
            ORDER BY p.created_date DESC
            LIMIT 1;]]></query>
	<field name="projectCode" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="customerName" class="java.lang.String"/>
