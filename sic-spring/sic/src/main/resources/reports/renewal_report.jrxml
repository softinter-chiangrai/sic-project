	<parameter name="renewalId" class="java.lang.String"/>
	<parameter name="lang" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
	</parameter>

	<query language="sql"><![CDATA[SELECT 
                r.renewal_no                                 AS "renewalNo",
                COALESCE(ct.contract_no, '-')                AS "contractNo",
                COALESCE(CASE WHEN $P{lang} = 'en' THEN c.company_name_en ELSE c.company_name_local END, c.company_name_en, c.company_name_local, '-') AS "customerName",
                COALESCE(p.project_name, '-')                AS "projectName",
                COALESCE(TO_CHAR(r.current_end_date, 'DD/MM/YYYY'), '-') AS "currentEndDate",
                COALESCE(TO_CHAR(r.new_start_date, 'DD/MM/YYYY'), '-')   AS "newStartDate",
                COALESCE(TO_CHAR(r.new_end_date, 'DD/MM/YYYY'), '-')     AS "newEndDate",
                COALESCE(TO_CHAR(r.proposed_amount, 'FM999,999,999,990.00'), '0.00') AS "proposedAmount",
                COALESCE(CAST(r.status AS VARCHAR), 'DRAFT') AS "status",
                COALESCE(r.remark, 'ไม่มีหมายเหตุเพิ่มเติม')         AS "remark",
                (SELECT STRING_AGG(su.file_name || ' (' || COALESCE(UPPER(substring(su.file_name from '\.([^.]+)$')) || ', ', '') || pg_size_pretty(su.file_size) || ')', ', ') FROM su_upload su
                    WHERE su.upload_group_id = r.attachment_group_id AND su.is_active = true) AS "attachmentNames"
            FROM pm_ma_renewal r
            LEFT JOIN pm_customer c ON r.customer_id = c.id
            LEFT JOIN pm_customer_project p ON r.project_id = p.id
            LEFT JOIN pm_customer_contract ct ON r.contract_id = ct.id
            WHERE r.is_delete = false
              AND ($P{renewalId} IS NULL OR $P{renewalId} = '' OR r.id = CAST($P{renewalId} AS uuid))
            ORDER BY r.created_date DESC
            LIMIT 1;]]></query>

	<field name="renewalNo" class="java.lang.String"/>
	<field name="contractNo" class="java.lang.String"/>
	<field name="customerName" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="currentEndDate" class="java.lang.String"/>
	<field name="newStartDate" class="java.lang.String"/>
	<field name="newEndDate" class="java.lang.String"/>
	<field name="proposedAmount" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="remark" class="java.lang.String"/>

