<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="RenewalReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="d4e5f6a7-b8c9-0123-defa-456789012345">

    <!-- ========================================================
         STYLES DEFINITIONS
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="renewalId" class="java.lang.String"/>
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>

        <queryString>
        <![CDATA[
            SELECT 
                r.renewal_no                                 AS "renewalNo",
                COALESCE(ct.contract_no, '-')                AS "contractNo",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(p.project_name, '-')                AS "projectName",
                COALESCE(TO_CHAR(r.current_end_date, 'DD/MM/YYYY'), '-') AS "currentEndDate",
                COALESCE(TO_CHAR(r.new_start_date, 'DD/MM/YYYY'), '-')   AS "newStartDate",
                COALESCE(TO_CHAR(r.new_end_date, 'DD/MM/YYYY'), '-')     AS "newEndDate",
                COALESCE(TO_CHAR(r.proposed_amount, 'FM999,999,999,990.00'), '0.00') AS "proposedAmount",
                COALESCE(CAST(r.status AS VARCHAR), 'DRAFT') AS "status",
                COALESCE(r.remark, 'ไม่มีหมายเหตุเพิ่มเติม')         AS "remark"
            FROM pm_ma_renewal r
            LEFT JOIN pm_customer c ON r.customer_id = c.id
            LEFT JOIN pm_customer_project p ON r.project_id = p.id
            LEFT JOIN pm_customer_contract ct ON r.contract_id = ct.id
            WHERE r.is_delete = false
              AND ($P{renewalId} IS NULL OR $P{renewalId} = '' OR r.id = CAST($P{renewalId} AS uuid))
            ORDER BY r.created_date DESC
            LIMIT 1;
        ]]>
    </queryString>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="renewalNo"          class="java.lang.String"/>
    <field name="contractNo"         class="java.lang.String"/>
    <field name="customerName"       class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="currentEndDate"     class="java.lang.String"/>
    <field name="newStartDate"       class="java.lang.String"/>
    <field name="newEndDate"         class="java.lang.String"/>
    <field name="proposedAmount"     class="java.lang.String"/>
    <field name="status"             class="java.lang.String"/>
    <field name="remark"             class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[($P{logoStream} != null ? $P{logoStream} : (this.getClass().getResourceAsStream("/images/softinter_logo.png") != null ? this.getClass().getResourceAsStream("/images/softinter_logo.png") : "../images/softinter_logo.png"))]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="DocTitle" x="230" y="0" width="285" height="26"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ใบเสนอต่อสัญญาบริการบำรุงรักษา (MA)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <text><![CDATA[MA Contract Renewal Proposal]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="44" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Renewal Main Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="28" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="80" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["เลขที่ใบเสนอต่อ MA:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="95" y="76" width="410" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{renewalNo} != null ? $F{renewalNo} : "-") + " [" + "สถานะ: " + ($F{status} != null ? $F{status} : "DRAFT") + "]"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Natural Multi-Page Flow
         ======================================================== -->
    <detail>
        <band height="280" splitType="Stretch">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลสัญญาเดิมและโครงการ
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="6" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["1. ข้อมูลสัญญาเดิมและโครงการ (Contract & Project Metadata)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="28" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Metadata Box 1 -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="34" width="515" height="46" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>

            <!-- Row 1 -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="38" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["เลขที่สัญญาเดิม:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="110" y="38" width="145" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{contractNo} != null ? $F{contractNo} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="38" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ลูกค้า / องค์กร:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="358" y="38" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2 -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="56" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["โครงการ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="110" y="56" width="145" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="56" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันสิ้นสุดสัญญาเดิม:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="370" y="56" width="138" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{currentEndDate} != null ? $F{currentEndDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: ข้อเสนอการต่อสัญญาใหม่
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="92" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["2. ข้อเสนอระยะเวลาและมูลค่าการต่อสัญญา (Renewal Term & Pricing)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="114" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Metadata Box 2 -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="120" width="515" height="46" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>

            <!-- Row 1 -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="124" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันเริ่มต้นรอบใหม่:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="118" y="124" width="135" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{newStartDate} != null ? $F{newStartDate} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="124" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันสิ้นสุดรอบใหม่:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="378" y="124" width="130" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{newEndDate} != null ? $F{newEndDate} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2 -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="142" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["มูลค่าเสนอต่อสัญญา:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="118" y="142" width="135" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{proposedAmount} != null ? $F{proposedAmount} : "0.00") + " " + "บาท"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="142" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["สถานะเอกสาร:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="378" y="142" width="130" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status} != null ? $F{status} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: หมายเหตุและข้อกำหนดเพิ่มเติม (Remark)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="178" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["3. เงื่อนไขและหมายเหตุเพิ่มเติม (Terms & Remarks)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="200" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Natural Flowing HTML Content -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="0" y="208" width="515" height="26"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2" markup="html"/>
                <textFieldExpression><![CDATA[$F{remark} != null && !$F{remark}.isBlank() ? $F{remark} : "การต่อสัญญาบริการบำรุงรักษาครอบคลุมการแก้ไขปัญหา การให้คำปรึกษา และการปรับปรุงความเสถียรของระบบตามขอบเขตงานเดิม"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER (Must come before summary)
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="8" width="350" height="18"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="8" width="135" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[ + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ========================================================
         SUMMARY BAND: Sign-off Section (Will stay neatly together)
         ======================================================== -->
    <summary>
        <band height="180" splitType="Prevent">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การลงนามยืนยัน (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="10" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["4. การลงนามอนุมัติและยืนยันการต่อสัญญา (Sign-off & Confirmation)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="32" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Proposer -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้เสนอการต่อสัญญา (Account Manager)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>

            <!-- Signatures: Client Confirmation -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="280" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ลูกค้าผู้มีอำนาจอนุมัติ (Customer Authorized)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
