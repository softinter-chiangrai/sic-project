<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="RenewalReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="d4e5f6a7-b8c9-0123-defa-456789012345">

    <!-- ========================================================
         STYLES DEFINITIONS
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream"/>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="renewalNo"          class="java.lang.String"/>
    <field name="contractNo"         class="java.lang.String"/>
    <field name="customerName"       class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="currentEndDate"     class="java.lang.String"/>
    <field name="newStartDate"       class="java.lang.String"/>
    <field name="newEndDate"         class="java.lang.String"/>
    <field name="proposedAmount"     class="java.lang.String"/>
    <field name="status"             class="java.lang.String"/>
    <field name="remark"             class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[$P{logoStream}]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="DocTitle" x="230" y="0" width="285" height="26"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("ใบเสนอต่อสัญญาบริการบำรุงรักษา (MA)")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <text><![CDATA[MA Contract Renewal Proposal]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="44" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-"))]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Renewal Main Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="28" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="80" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("เลขที่ใบเสนอต่อ MA:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="95" y="76" width="410" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{renewalNo} != null ? $F{renewalNo} : "-") + " [" + com.softinter.sicapi.util.ReportHelper.thaify("สถานะ: ") + ($F{status} != null ? $F{status} : "DRAFT") + "]"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Simple, Clean Sections
         ======================================================== -->
    <detail>
        <band height="550">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลสัญญาเดิมและโครงการ
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" x="0" y="6" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("1. ข้อมูลสัญญาเดิมและโครงการ (Contract & Project Details)")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="28" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: Contract No & Customer -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="32" width="95" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("เลขที่สัญญาเดิม:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="110" y="32" width="145" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{contractNo} != null ? $F{contractNo} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="32" width="85" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("ลูกค้า / องค์กร:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="358" y="32" width="150" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Project & Current End Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="54" width="95" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("โครงการ:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="110" y="54" width="145" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="54" width="95" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("วันสิ้นสุดสัญญาเดิม:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="370" y="54" width="138" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{currentEndDate} != null ? $F{currentEndDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: ข้อเสนอการต่อสัญญาใหม่
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" x="0" y="88" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("2. ข้อเสนอระยะเวลาและมูลค่าการต่อสัญญา (Renewal Term & Pricing)")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="110" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: New Start Date & New End Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="114" width="105" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("วันเริ่มต้นรอบใหม่:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="118" y="114" width="135" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{newStartDate} != null ? $F{newStartDate} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="114" width="105" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("วันสิ้นสุดรอบใหม่:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="378" y="114" width="130" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{newEndDate} != null ? $F{newEndDate} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Proposed Amount & Status -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="136" width="105" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("มูลค่าเสนอต่อสัญญา:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="118" y="136" width="135" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{proposedAmount} != null ? $F{proposedAmount} : "0.00") + " " + com.softinter.sicapi.util.ReportHelper.thaify("บาท")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="136" width="105" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("สถานะเอกสาร:")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="378" y="136" width="130" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{status} != null ? $F{status} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: หมายเหตุและข้อกำหนดเพิ่มเติม (Remark)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="172" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("3. เงื่อนไขและหมายเหตุเพิ่มเติม (Terms & Remarks)")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="194" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="202" width="515" height="150" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="10" y="208" width="495" height="138"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2"/>
                <textFieldExpression><![CDATA[$F{remark} != null && !$F{remark}.isBlank() ? $F{remark} : com.softinter.sicapi.util.ReportHelper.thaify("การต่อสัญญาบริการบำรุงรักษาครอบคลุมการแก้ไขปัญหา การให้คำปรึกษา และการปรับปรุงความเสถียรของระบบตามขอบเขตงานเดิม")]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การลงนามยืนยัน (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="373" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("4. การลงนามอนุมัติและยืนยันการต่อสัญญา (Sign-off & Confirmation)")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="395" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Proposer -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="407" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="413" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[com.softinter.sicapi.util.ReportHelper.thaify("ผู้เสนอการต่อสัญญา (Account Manager)")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="462" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="484" width="225" height="18"/>
