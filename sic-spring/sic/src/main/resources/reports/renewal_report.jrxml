<jasperReport name="RenewalReport" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40" uuid="d4e5f6a7-b8c9-0123-defa-456789012345">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SDLC"/>
	<style name="DocTitle" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="20.0" bold="true"/>
