<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TicketReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="a7b8c9d0-e1f2-3456-abcd-789012345678">

    <!-- ========================================================
         STYLES DEFINITIONS
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="ticketId" class="java.lang.String"/>
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>

        <queryString>
        <![CDATA[
            SELECT 
                t.ticket_no                                  AS "ticketNo",
                t.title                                      AS "title",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(p.project_name, '-')                AS "projectName",
                COALESCE(ct.contract_no, '-')                AS "contractNo",
                COALESCE(CAST(t.ticket_type AS VARCHAR), 'GENERAL') AS "ticketType",
                COALESCE(CAST(t.severity AS VARCHAR), 'MEDIUM')   AS "severity",
                COALESCE(CAST(t.status AS VARCHAR), 'OPEN')       AS "status",
                COALESCE(t.reported_by, '-')                 AS "reportedBy",
                COALESCE(TO_CHAR(t.reported_date, 'DD/MM/YYYY HH24:MI'), '-') AS "reportedDate",
                COALESCE(t.assigned_to, 'Unassigned')        AS "assignedTo",
                COALESCE(TO_CHAR(t.resolved_date, 'DD/MM/YYYY HH24:MI'), '-') AS "resolvedDate",
                COALESCE(t.description, 'ไม่มีรายละเอียดเพิ่มเติม')          AS "description",
                COALESCE(t.resolution_summary, 'ไม่มีสรุปการแก้ไข')        AS "resolutionSummary"
            FROM pm_ma_ticket t
            LEFT JOIN pm_customer c ON t.customer_id = c.id
            LEFT JOIN pm_customer_project p ON t.project_id = p.id
            LEFT JOIN pm_customer_contract ct ON t.contract_id = ct.id
            WHERE t.is_delete = false
              AND ($P{ticketId} IS NULL OR $P{ticketId} = '' OR t.id = CAST($P{ticketId} AS uuid))
            ORDER BY t.created_date DESC
            LIMIT 1;
        ]]>
    </queryString>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="ticketNo"           class="java.lang.String"/>
    <field name="title"              class="java.lang.String"/>
    <field name="customerName"       class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="ticketType"         class="java.lang.String"/>
    <field name="severity"           class="java.lang.String"/>
    <field name="status"             class="java.lang.String"/>
    <field name="reportedBy"         class="java.lang.String"/>
    <field name="reportedDate"       class="java.lang.String"/>
    <field name="assignedTo"         class="java.lang.String"/>
    <field name="resolvedDate"       class="java.lang.String"/>
    <field name="description"        class="java.lang.String"/>
    <field name="resolutionSummary"  class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[($P{logoStream} != null ? $P{logoStream} : (this.getClass().getResourceAsStream("/images/softinter_logo.png") != null ? this.getClass().getResourceAsStream("/images/softinter_logo.png") : "../images/softinter_logo.png"))]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="DocTitle" x="230" y="0" width="285" height="26"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ใบแจ้งงานบริการและสนับสนุน (MA)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <text><![CDATA[Support Ticket & Incident Report]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="44" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Ticket Main Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="28" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="75" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["เลขที่ Ticket:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="88" y="76" width="417" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{ticketNo} != null ? "[" + $F{ticketNo} + "] " : "") + ($F{title} != null ? $F{title} : "-")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Simple, Clean Sections
         ======================================================== -->
    <detail>
        <band height="550">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูล Ticket และโครงการ
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" x="0" y="6" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["1. ข้อมูลการแจ้งเรื่องและโครงการ (Ticket & Project Metadata)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="28" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: Code & Status -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="32" width="90" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["รหัส Ticket:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="105" y="32" width="148" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{ticketNo} != null ? $F{ticketNo} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="32" width="90" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["สถานะงาน:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="365" y="32" width="143" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{status} != null ? $F{status} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Customer & Project -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="54" width="90" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ลูกค้า / องค์กร:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="105" y="54" width="148" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="54" width="90" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["โครงการ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="365" y="54" width="143" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Type & Severity -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="90" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ประเภทงาน:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="105" y="76" width="148" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{ticketType} != null ? $F{ticketType} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="76" width="95" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ระดับความรุนแรง:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="370" y="76" width="138" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{severity} != null ? $F{severity} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 4: Reported By & Reported Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="98" width="90" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้แจ้งเรื่อง:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="105" y="98" width="148" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{reportedBy} != null ? $F{reportedBy} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="98" width="95" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่แจ้งเรื่อง:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="370" y="98" width="138" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{reportedDate} != null ? $F{reportedDate} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 5: Assigned To & Resolved Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="120" width="95" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้รับผิดชอบงาน:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="110" y="120" width="143" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{assignedTo} != null ? $F{assignedTo} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="270" y="120" width="85" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่แก้ไขเสร็จ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="358" y="120" width="150" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[$F{resolvedDate} != null ? $F{resolvedDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: รายละเอียดปัญหาที่ได้รับแจ้ง (Description)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" x="0" y="148" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["2. รายละเอียดปัญหา / อาการที่พบ (Issue Description)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="170" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="176" width="515" height="85" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="10" y="182" width="495" height="73"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2"/>
                <textFieldExpression><![CDATA[$F{description} != null && !$F{description}.isBlank() ? $F{description} : "ไม่มีรายละเอียดเพิ่มเติม"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: สรุปผลการแก้ไขปัญหา (Resolution Summary)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="270" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["3. สรุปผลและแนวทางการแก้ไขปัญหา (Resolution & Action Taken)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="292" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="298" width="515" height="85" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="10" y="304" width="495" height="73"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2"/>
                <textFieldExpression><![CDATA[$F{resolutionSummary} != null && !$F{resolutionSummary}.isBlank() ? $F{resolutionSummary} : "อยู่ระหว่างการดำเนินการแก้ไขปัญหา"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การลงนามปิดงาน (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="392" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["4. การลงนามรับรองผลการแก้ไข (Resolution Sign-off)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="414" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Engineer -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="424" width="245" height="115" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="430" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วิศวกรผู้แก้ไข (Support Engineer)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="475" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="496" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: Support Engineer"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="515" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>

            <!-- Signatures: Client Acceptance -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="424" width="245" height="115" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="280" y="430" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้รับการแก้ไข / ผู้แจ้ง (Customer Acceptance)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="475" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="496" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="515" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="10" width="350" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="10" width="135" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[ + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
