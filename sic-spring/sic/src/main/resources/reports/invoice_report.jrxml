                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["จำนวนเงินรวมทั้งสิ้น (Total Net Amount)"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="320" y="212" width="185" height="24"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{totalAmount} != null ? $F{totalAmount} : "0.00"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: หมายเหตุและการชำระเงิน (Payment Terms)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="250" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["3. เงื่อนไขการชำระเงินและหมายเหตุ (Payment Terms & Remarks)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="272" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Natural Flowing HTML Content -->
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="0" y="280" width="515" height="26"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2" markup="html"/>
                <textFieldExpression><![CDATA[$F{remark} != null && !$F{remark}.isBlank() ? $F{remark} : "กรุณาโอนเงินเข้าบัญชีบริษัท ซอฟต์อินเตอร์ จำกัด และส่งหลักฐานการชำระเงินเพื่อออกใบเสร็จรับเงิน"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER (Must come before summary)
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="10" width="350" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="10" width="135" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[ + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ========================================================
         SUMMARY BAND: Sign-off Section (Will stay neatly together)
         ======================================================== -->
    <summary>
        <band height="180" splitType="Prevent">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การอนุมัติและลงนาม (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="10" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["4. การลงนามผู้ออกเอกสาร (Authorized Signature)"]]></textFieldExpression>
            </textField>
