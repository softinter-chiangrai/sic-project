                <reportElement style="Label" positionType="Float" x="10" y="56" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["สัญญาอ้างอิง:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="110" y="56" width="145" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{contractNo} != null ? $F{contractNo} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="56" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ประเภทการเรียกเก็บ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="358" y="56" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{billingType} != null ? $F{billingType} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 3 -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="74" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันที่ออกใบแจ้งหนี้:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="110" y="74" width="145" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{issueDate} != null ? $F{issueDate} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="74" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["กำหนดชำระ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="358" y="74" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{dueDate} != null ? $F{dueDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: รายละเอียดค่าบริการและการคำนวณเงิน
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="110" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["2. รายการสรุปยอดเงินและภาษี (Financial Summary)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="132" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Table Header -->
            <rectangle radius="2">
                <reportElement style="TableHeader" positionType="Float" x="0" y="138" width="515" height="24"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="TableHeader" positionType="Float" x="10" y="138" width="300" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["รายการ (Description)"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="TableHeader" positionType="Float" x="320" y="138" width="185" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["จำนวนเงิน (บาท)"]]></textFieldExpression>
            </textField>

            <!-- Table Row 1: Subtotal -->
            <rectangle>
                <reportElement positionType="Float" x="0" y="162" width="515" height="24" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.4" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="164" width="300" height="20"/>
                <textElement verticalAlignment="Bottom"/>
