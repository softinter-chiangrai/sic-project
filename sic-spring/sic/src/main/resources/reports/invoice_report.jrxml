	<parameter name="invoiceId" class="java.lang.String"/>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
	</parameter>
	<parameter name="invoiceNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerName" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="projectName" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="contractNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="billingType" class="java.lang.String">
		<defaultValueExpression><![CDATA["MILESTONE"]]></defaultValueExpression>
	</parameter>
	<parameter name="issueDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="dueDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="paymentStatus" class="java.lang.String">
		<defaultValueExpression><![CDATA["UNPAID"]]></defaultValueExpression>
	</parameter>
	<parameter name="subtotalAmount" class="java.lang.String">
		<defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="vatRate" class="java.lang.String">
		<defaultValueExpression><![CDATA["7.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="vatAmount" class="java.lang.String">
		<defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="totalAmount" class="java.lang.String">
		<defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="remark" class="java.lang.String">
		<defaultValueExpression><![CDATA["กรุณาโอนเงินเข้าบัญชีบริษัท ซอฟต์อินเตอร์ จำกัด และส่งหลักฐานการชำระเงินเพื่อออกใบเสร็จรับเงิน"]]></defaultValueExpression>
	</parameter>

	<query language="sql"><![CDATA[SELECT
                COALESCE(item.item_name, '-')                                     AS "itemName",
                COALESCE(item.description, '')                                    AS "itemDescription",
                COALESCE(TO_CHAR(item.amount, 'FM999,999,999,990.00'), '0.00')    AS "itemAmount"
            FROM pm_invoice_item item
            WHERE item.is_delete = false
              AND ($P{invoiceId} IS NULL OR $P{invoiceId} = '' OR item.invoice_id = CAST($P{invoiceId} AS uuid))
            ORDER BY item.sort_order ASC, item.created_date ASC;]]></query>
	<field name="itemName" class="java.lang.String"/>
	<field name="itemDescription" class="java.lang.String"/>
	<field name="itemAmount" class="java.lang.String"/>

