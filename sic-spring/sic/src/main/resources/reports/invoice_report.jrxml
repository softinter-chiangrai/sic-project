<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="InvoiceReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="f1a2b3c4-d5e6-7890-abcd-ef1234567890">

    <!-- ========================================================
         STYLES DEFINITIONS (Clean, Minimal & Elegant)
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    <style name="TableHeader" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B" backcolor="#F1F5F9" mode="Opaque"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoPath" class="java.lang.String">
        <defaultValueExpression><![CDATA["images/softinter_logo.png"]]></defaultValueExpression>
    </parameter>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="invoiceNo"          class="java.lang.String"/>
    <field name="customerName"       class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="contractNo"         class="java.lang.String"/>
    <field name="billingType"        class="java.lang.String"/>
    <field name="issueDate"          class="java.lang.String"/>
    <field name="dueDate"            class="java.lang.String"/>
    <field name="subtotalAmount"     class="java.lang.String"/>
    <field name="vatRate"            class="java.lang.String"/>
    <field name="vatAmount"          class="java.lang.String"/>
    <field name="totalAmount"        class="java.lang.String"/>
    <field name="paidAmount"         class="java.lang.String"/>
    <field name="paymentStatus"      class="java.lang.String"/>
    <field name="remark"             class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[this.getClass().getClassLoader().getResourceAsStream($P{logoPath})]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <staticText>
                <reportElement style="DocTitle" x="230" y="0" width="285" height="24"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[ใบแจ้งหนี้ / ใบเรียกเก็บเงิน]]></text>
            </staticText>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Invoice & Billing Notice]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="42" width="285" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Invoice Main Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="26" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="10" y="77" width="80" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[เลขที่ใบแจ้งหนี้:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="95" y="77" width="410" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{invoiceNo} != null ? $F{invoiceNo} : "-") + " [สถานะการชำระ: " + ($F{paymentStatus} != null ? $F{paymentStatus} : "UNPAID") + "]"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Simple, Clean Sections
         ======================================================== -->
    <detail>
        <band height="550">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลคู่ค้าและโครงการ
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" x="0" y="8" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[1. ข้อมูลผู้รับบริการและโครงการ (Customer & Project Information)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="28" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: Customer & Project -->
            <staticText>
                <reportElement style="Label" x="10" y="34" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ชื่อลูกค้า / องค์กร:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="110" y="34" width="145" height="18"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="34" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[โครงการ:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="358" y="34" width="150" height="18"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Contract & Billing Type -->
            <staticText>
                <reportElement style="Label" x="10" y="54" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[สัญญาอ้างอิง:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="110" y="54" width="145" height="18"/>
                <textFieldExpression><![CDATA[$F{contractNo} != null ? $F{contractNo} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="54" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ประเภทการเรียกเก็บ:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="358" y="54" width="150" height="18"/>
                <textFieldExpression><![CDATA[$F{billingType} != null ? $F{billingType} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Issue Date & Due Date -->
            <staticText>
                <reportElement style="Label" x="10" y="74" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[วันที่ออกใบแจ้งหนี้:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="110" y="74" width="145" height="18"/>
                <textFieldExpression><![CDATA[$F{issueDate} != null ? $F{issueDate} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="74" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[กำหนดชำระ:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="358" y="74" width="150" height="18"/>
                <textFieldExpression><![CDATA[$F{dueDate} != null ? $F{dueDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: รายละเอียดค่าบริการและการคำนวณเงิน
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" x="0" y="106" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[2. รายการสรุปยอดเงินและภาษี (Financial Summary)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="126" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Table Header -->
            <rectangle radius="2">
                <reportElement style="TableHeader" x="0" y="132" width="515" height="22"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="TableHeader" x="10" y="132" width="300" height="22"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[รายการ (Description)]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="320" y="132" width="185" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[จำนวนเงิน (บาท)]]></text>
            </staticText>

            <!-- Table Row 1: Subtotal -->
            <rectangle>
                <reportElement x="0" y="154" width="515" height="22" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.4" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Value" x="10" y="156" width="300" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[มูลค่าบริการก่อนภาษี (Subtotal)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="320" y="156" width="185" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{subtotalAmount} != null ? $F{subtotalAmount} : "0.00"]]></textFieldExpression>
            </textField>

            <!-- Table Row 2: VAT -->
            <rectangle>
                <reportElement x="0" y="176" width="515" height="22" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.4" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="10" y="178" width="300" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ภาษีมูลค่าเพิ่ม (VAT " + ($F{vatRate} != null ? $F{vatRate} : "7.00") + "%):"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="320" y="178" width="185" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{vatAmount} != null ? $F{vatAmount} : "0.00"]]></textFieldExpression>
            </textField>

            <!-- Table Row 3: Total Amount -->
            <rectangle>
                <reportElement x="0" y="198" width="515" height="26" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.6" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="10" y="202" width="300" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[ยอดรวมสุทธิทั้งสิ้น (Grand Total)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="320" y="202" width="185" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{totalAmount} != null ? $F{totalAmount} + " บาท" : "0.00 บาท"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: หมายเหตุและช่องทางการชำระเงิน
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" positionType="Float" x="0" y="238" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[3. หมายเหตุและข้อกำหนดการชำระเงิน (Payment Instructions)]]></text>
            </staticText>
            <line>
                <reportElement positionType="Float" x="0" y="258" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="266" width="515" height="90" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="10" y="272" width="495" height="78"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2"/>
                <textFieldExpression><![CDATA[$F{remark} != null && !$F{remark}.isBlank() ? $F{remark} : "กรุณาโอนเงินเข้าบัญชีบริษัท ซอฟต์อินเตอร์ จำกัด และส่งหลักฐานการชำระเงินเพื่อออกใบเสร็จรับเงิน"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การอนุมัติและลงนาม (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" positionType="Float" x="0" y="375" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[4. การลงนามผู้ออกเอกสาร (Authorized Signature)]]></text>
            </staticText>
            <line>
                <reportElement positionType="Float" x="0" y="395" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Issuer -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="407" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" positionType="Float" x="10" y="413" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ผู้ออกเอกสาร (Finance & Billing)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="462" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="484" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ตำแหน่ง: เจ้าหน้าที่การเงิน]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="505" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[วันที่: ........ / ........ / ................]]></text>
            </staticText>

            <!-- Signatures: Payer Acceptance -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="407" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" positionType="Float" x="280" y="413" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ผู้รับวางบิล / จ่ายเงิน (Customer Accounts Payable)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="462" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="484" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ตำแหน่ง: .....................................................]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="505" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[วันที่: ........ / ........ / ................]]></text>
            </staticText>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="10" width="350" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="10" width="135" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["หน้า " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
