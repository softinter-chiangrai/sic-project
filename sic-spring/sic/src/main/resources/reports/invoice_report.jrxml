<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="InvoiceReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="f6a7b8c9-d0e1-2345-fabc-678901234567">

    <!-- ========================================================
         STYLES DEFINITIONS
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="TableHeader" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B" backcolor="#F1F5F9"/>
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="invoiceId" class="java.lang.String"/>
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>

        <queryString>
        <![CDATA[
            SELECT 
                inv.invoice_no                               AS "invoiceNo",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(p.project_name, '-')                AS "projectName",
                COALESCE(ct.contract_no, '-')                AS "contractNo",
                COALESCE(CAST(inv.billing_type AS VARCHAR), 'MILESTONE') AS "billingType",
                COALESCE(TO_CHAR(inv.subtotal_amount, 'FM999,999,999,990.00'), '0.00') AS "subtotalAmount",
                COALESCE(CAST(inv.vat_rate AS VARCHAR), '7.00') AS "vatRate",
                COALESCE(TO_CHAR(inv.vat_amount, 'FM999,999,999,990.00'), '0.00') AS "vatAmount",
                COALESCE(TO_CHAR(inv.total_amount, 'FM999,999,999,990.00'), '0.00') AS "totalAmount",
                COALESCE(TO_CHAR(inv.issue_date, 'DD/MM/YYYY'), '-') AS "issueDate",
                COALESCE(TO_CHAR(inv.due_date, 'DD/MM/YYYY'), '-')   AS "dueDate",
                COALESCE(CAST(inv.payment_status AS VARCHAR), 'UNPAID') AS "paymentStatus",
                COALESCE(inv.remark, 'ไม่มีหมายเหตุเพิ่มเติม')         AS "remark"
            FROM pm_invoice inv
            LEFT JOIN pm_customer c ON inv.customer_id = c.id
            LEFT JOIN pm_customer_project p ON inv.project_id = p.id
            LEFT JOIN pm_customer_contract ct ON inv.contract_id = ct.id
            WHERE inv.is_delete = false
              AND ($P{invoiceId} IS NULL OR $P{invoiceId} = '' OR inv.id = CAST($P{invoiceId} AS uuid))
            ORDER BY inv.created_date DESC
            LIMIT 1;
        ]]>
    </queryString>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="invoiceNo"          class="java.lang.String"/>
    <field name="customerName"       class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="contractNo"         class="java.lang.String"/>
    <field name="billingType"        class="java.lang.String"/>
    <field name="subtotalAmount"     class="java.lang.String"/>
    <field name="vatRate"            class="java.lang.String"/>
    <field name="vatAmount"          class="java.lang.String"/>
    <field name="totalAmount"        class="java.lang.String"/>
    <field name="issueDate"          class="java.lang.String"/>
    <field name="dueDate"            class="java.lang.String"/>
    <field name="paymentStatus"      class="java.lang.String"/>
    <field name="remark"             class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[($P{logoStream} != null ? $P{logoStream} : (this.getClass().getResourceAsStream("/images/softinter_logo.png") != null ? this.getClass().getResourceAsStream("/images/softinter_logo.png") : "../images/softinter_logo.png"))]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <textField isBlankWhenNull="true">
                <reportElement style="DocTitle" x="230" y="0" width="285" height="26"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ใบแจ้งหนี้ / ใบเรียกเก็บเงิน"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <text><![CDATA[Invoice & Billing Notice]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="44" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Invoice Main Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="28" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="80" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["เลขที่ใบแจ้งหนี้:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="95" y="76" width="410" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{invoiceNo} != null ? $F{invoiceNo} : "-") + " [" + "สถานะการชำระ: " + ($F{paymentStatus} != null ? $F{paymentStatus} : "UNPAID") + "]"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Natural Multi-Page Flow
         ======================================================== -->
    <detail>
        <band height="320" splitType="Stretch">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลคู่ค้าและโครงการ
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="6" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["1. ข้อมูลลูกค้าและโครงการ (Customer & Project Metadata)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="28" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Metadata Box -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="34" width="515" height="64" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>

            <!-- Row 1 -->
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="38" width="95" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ชื่อลูกค้า / องค์กร:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="110" y="38" width="145" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="38" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["โครงการ:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="358" y="38" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2 -->
