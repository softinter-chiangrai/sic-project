	<parameter name="requirementId" class="java.lang.String"/>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>
	<query language="sql"><![CDATA[SELECT 
                r.requirement_code                            AS "requirementCode",
                r.title                                       AS "title",
                COALESCE(p.project_name, '-')                 AS "projectName",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(r.version, '-')                      AS "version",
                COALESCE(r.requirement_type, '-')             AS "requirementType",
                COALESCE(r.source, '-')                       AS "source",
                COALESCE(r.priority, '-')                     AS "priority",
                COALESCE(r.business_value, '-')               AS "businessValue",
                COALESCE(r.status, '-')                       AS "status",
                COALESCE(r.created_by, '-')                   AS "createdBy",
                TO_CHAR(r.created_date, 'DD/MM/YYYY HH24:MI') AS "createdDate",
                COALESCE(r.description, 'ไม่มีรายละเอียดเพิ่มเติม')          AS "description",
                COALESCE(r.acceptance_criteria, 'ไม่มีเงื่อนไขการยอมรับเพิ่มเติม') AS "acceptanceCriteria"
            FROM pm_requirement r
            LEFT JOIN pm_customer_project p ON r.project_id = p.id
            LEFT JOIN pm_customer c ON p.customer_id = c.id
            WHERE r.is_delete = false
              AND ($P{requirementId} IS NULL OR $P{requirementId} = '' OR r.id = CAST($P{requirementId} AS uuid))
            ORDER BY r.created_date DESC
            LIMIT 1;]]></query>
	<field name="requirementCode" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
