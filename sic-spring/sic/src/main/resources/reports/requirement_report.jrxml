<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="RequirementReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="b8c9d0e1-f2a3-4567-8901-bcdefa234567">

	<style name="DocTitle" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="20.0" isBold="true"/>
	<style name="DocSubtitle" forecolor="#64748B" fontName="TH Sarabun New" fontSize="13.0"/>
	<style name="SectionHeading" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="14.0" isBold="true"/>
	<style name="Label" forecolor="#475569" fontName="TH Sarabun New" fontSize="13.0" isBold="true"/>
	<style name="Value" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="13.0" isBold="false"/>
	<style name="ValueBold" forecolor="#1E293B" fontName="TH Sarabun New" fontSize="13.0" isBold="true"/>
	<style name="ContentText" forecolor="#334155" fontName="TH Sarabun New" fontSize="13.0"/>
	<style name="FooterText" forecolor="#94A3B8" fontName="TH Sarabun New" fontSize="11.0"/>

	<parameter name="requirementId" class="java.lang.String"/>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>

	<queryString><![CDATA[
            SELECT 
                r.requirement_code                            AS "requirementCode",
                r.title                                       AS "title",
                COALESCE(p.project_name, '-')                 AS "projectName",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(r.version, '-')                      AS "version",
                COALESCE(r.requirement_type, '-')             AS "requirementType",
                COALESCE(r.source, '-')                       AS "source",
                COALESCE(r.priority, '-')                     AS "priority",
                COALESCE(r.business_value, '-')               AS "businessValue",
                COALESCE(r.status, '-')                       AS "status",
                COALESCE(r.created_by, '-')                   AS "createdBy",
                TO_CHAR(r.created_date, 'DD/MM/YYYY HH24:MI') AS "createdDate",
                COALESCE(r.description, 'ไม่มีรายละเอียดเพิ่มเติม')          AS "description",
                COALESCE(r.acceptance_criteria, 'ไม่มีเงื่อนไขการยอมรับเพิ่มเติม') AS "acceptanceCriteria"
            FROM pm_requirement r
            LEFT JOIN pm_customer_project p ON r.project_id = p.id
            LEFT JOIN pm_customer c ON p.customer_id = c.id
            WHERE r.is_delete = false
              AND ($P{requirementId} IS NULL OR $P{requirementId} = '' OR r.id = CAST($P{requirementId} AS uuid))
            ORDER BY r.created_date DESC
            LIMIT 1;
    ]]></queryString>

	<field name="requirementCode" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="version" class="java.lang.String"/>
	<field name="requirementType" class="java.lang.String"/>
	<field name="priority" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="createdBy" class="java.lang.String"/>
	<field name="createdDate" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<field name="acceptanceCriteria" class="java.lang.String"/>

	<!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
	<title>
        <band height="105">
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[($P{logoStream} != null ? $P{logoStream} : (this.getClass().getResourceAsStream("/images/softinter_logo.png") != null ? this.getClass().getResourceAsStream("/images/softinter_logo.png") : "../images/softinter_logo.png"))]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="20"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement style="DocTitle" x="230" y="0" width="285" height="26"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["เอกสารข้อกำหนดความต้องการ"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <text><![CDATA[Requirement Specification Document]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="44" width="285" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="28" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" x="10" y="76" width="65" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["หัวข้อ Req:"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="78" y="76" width="427" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[($F{requirementCode} != null ? "[" + $F{requirementCode} + "] " : "") + ($F{title} != null ? $F{title} : "-")]]></textFieldExpression>
            </textField>
        </band>
	</title>

	<!-- ========================================================
         DETAIL BAND — Natural Multi-Page Flow
         ======================================================== -->
	<detail>
		<band height="320" splitType="Stretch">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลทั่วไป (General Information)
                 ──────────────────────────────────────────────────────── -->
			<textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="6" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["1. ข้อมูลทั่วไป (General Information)"]]></textFieldExpression>
            </textField>
			<line>
                <reportElement positionType="Float" x="0" y="28" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="34" width="515" height="80" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>

            <!-- Row 1 -->
			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="38" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["รหัส Req:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="105" y="38" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{requirementCode} != null ? $F{requirementCode} : "-"]]></textFieldExpression>
            </textField>

			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="38" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["สถานะ:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="ValueBold" positionType="Float" x="365" y="38" width="143" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status} != null ? $F{status} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2 -->
			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="56" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["โครงการ:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="105" y="56" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="56" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["เวอร์ชัน:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="365" y="56" width="143" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{version} != null ? $F{version} : "v1.0"]]></textFieldExpression>
            </textField>

            <!-- Row 3 -->
			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="74" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ประเภท:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="105" y="74" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{requirementType} != null ? $F{requirementType} : "-"]]></textFieldExpression>
            </textField>

			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="74" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ความสำคัญ:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="365" y="74" width="143" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{priority} != null ? $F{priority} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 4 -->
			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="92" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["ผู้จัดทำ:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="105" y="92" width="148" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{createdBy} != null ? $F{createdBy} : "-"]]></textFieldExpression>
            </textField>

			<textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="270" y="92" width="90" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันที่จัดทำ:"]]></textFieldExpression>
            </textField>
			<textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="365" y="92" width="143" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{createdDate} != null ? $F{createdDate} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: รายละเอียดความต้องการ (Description)
                 ──────────────────────────────────────────────────────── -->
			<textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="124" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["2. รายละเอียดความต้องการ (Requirement Description)"]]></textFieldExpression>
            </textField>
			<line>
                <reportElement positionType="Float" x="0" y="146" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="0" y="154" width="515" height="26"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2" markup="html"/>
                <textFieldExpression><![CDATA[$F{description} != null && !$F{description}.isBlank() ? $F{description} : "ไม่มีรายละเอียดเพิ่มเติม"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: เกณฑ์การยอมรับและการทดสอบ (Acceptance Criteria)
                 ──────────────────────────────────────────────────────── -->
			<textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="190" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["3. เกณฑ์การยอมรับและการทดสอบ (Acceptance Criteria)"]]></textFieldExpression>
            </textField>
			<line>
                <reportElement positionType="Float" x="0" y="212" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="0" y="220" width="515" height="26"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2" markup="html"/>
                <textFieldExpression><![CDATA[$F{acceptanceCriteria} != null && !$F{acceptanceCriteria}.isBlank() ? $F{acceptanceCriteria} : "ไม่มีเงื่อนไขการยอมรับเพิ่มเติม"]]></textFieldExpression>
            </textField>
		</band>
	</detail>

	<!-- ========================================================
         PAGE FOOTER (Must come before summary)
         ======================================================== -->
	<pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="8" width="350" height="18"/>
                <textElement verticalAlignment="Bottom"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="8" width="135" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA[ + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
	</pageFooter>

	<!-- ========================================================
         SUMMARY BAND: Sign-off Section (Will stay neatly together)
         ======================================================== -->
    <summary>
        <band height="180" splitType="Prevent">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การลงนามจัดทำและตรวจรับ (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <textField isBlankWhenNull="true">
                <reportElement style="SectionHeading" positionType="Float" x="0" y="10" width="515" height="22"/>
                <textElement verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["4. การลงนามจัดทำและตรวจรับ (Sign-off)"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="32" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Prepared By -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="10" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้จัดทำ (Prepared By)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="10" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>

            <!-- Signatures: Approved By -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="42" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Label" positionType="Float" x="280" y="48" width="225" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ผู้ตรวจรับ / ผู้อนุมัติ (Approved By)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="98" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="120" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["ตำแหน่ง: ....................................................."]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="280" y="140" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Bottom"/>
                <textFieldExpression><![CDATA["วันที่: ........ / ........ / ................"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
