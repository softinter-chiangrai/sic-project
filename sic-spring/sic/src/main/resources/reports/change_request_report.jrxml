	<parameter name="changeRequestId" class="java.lang.String"/>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
	</parameter>

	<query language="sql"><![CDATA[SELECT 
                SUBSTRING(CAST(cr.id AS text), 1, 8)          AS "crCode",
                cr.title                                      AS "title",
                COALESCE(p.project_name, '-')                 AS "projectName",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(cr.target_type, '-')                 AS "targetType",
                COALESCE(cr.change_reason, '-')               AS "changeReason",
                COALESCE(cr.target_version, '-')              AS "targetVersion",
                COALESCE(cr.status, '-')                      AS "status",
                COALESCE(cr.requester_id, '-')                AS "requesterId",
                COALESCE(cr.assignee_id, '-')                 AS "assigneeId",
                COALESCE(cr.approved_by, '-')                 AS "approvedBy",
                TO_CHAR(cr.approved_at, 'DD/MM/YYYY HH24:MI') AS "approvedAt",
                TO_CHAR(cr.created_date, 'DD/MM/YYYY HH24:MI') AS "createdDate",
                COALESCE(cr.description, 'ไม่มีรายละเอียดเพิ่มเติม') AS "description"
            FROM pm_change_request cr
            LEFT JOIN pm_customer_project p ON cr.project_id = p.id
            LEFT JOIN pm_customer c ON p.customer_id = c.id
            WHERE cr.is_delete = false
              AND ($P{changeRequestId} IS NULL OR $P{changeRequestId} = '' OR cr.id = CAST($P{changeRequestId} AS uuid))
            ORDER BY cr.created_date DESC
            LIMIT 1;]]></query>

	<field name="crCode" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="customerName" class="java.lang.String"/>
	<field name="targetType" class="java.lang.String"/>
	<field name="changeReason" class="java.lang.String"/>
	<field name="targetVersion" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="requesterId" class="java.lang.String"/>
	<field name="assigneeId" class="java.lang.String"/>
	<field name="approvedBy" class="java.lang.String"/>
	<field name="approvedAt" class="java.lang.String"/>
	<field name="createdDate" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>

