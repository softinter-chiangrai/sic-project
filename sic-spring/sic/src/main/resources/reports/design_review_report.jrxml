	<parameter name="designReviewId" class="java.lang.String"/>
	<parameter name="businessId" class="java.lang.String"/>
	<parameter name="lang" class="java.lang.String"><defaultValueExpression><![CDATA["th"]]></defaultValueExpression></parameter>
	<parameter name="exportDate" class="java.lang.String"><defaultValueExpression><![CDATA["-"]]></defaultValueExpression></parameter>
	<parameter name="logoStream" class="java.io.InputStream"><defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression></parameter>

	<query language="sql"><![CDATA[SELECT
                COALESCE(r.review_code, SUBSTRING(CAST(r.id AS text), 1, 8)) AS "reviewCode",
                COALESCE(r.title, '-')                  AS "title",
                COALESCE(p.project_code, '-')           AS "projectCode",
                COALESCE(p.project_name, '-')           AS "projectName",
                COALESCE(r.review_item_type, '-')       AS "reviewItemType",
                COALESCE(r.reviewer, '-')               AS "reviewer",
                COALESCE(r.assigned_to, '-')            AS "assignedTo",
                COALESCE(r.severity, '-')               AS "severity",
                COALESCE(r.status, '-')                 AS "status",
                COALESCE(TO_CHAR(r.due_date, 'DD/MM/YYYY'), '-') AS "dueDate",
                COALESCE(r.figma_url, '-')              AS "figmaUrl",
                COALESCE(r.description, '-')            AS "description",
                (SELECT STRING_AGG(
                        TO_CHAR(c.created_date AT TIME ZONE 'Asia/Bangkok', 'DD/MM/YYYY HH24:MI') || ' | '
                        || COALESCE(NULLIF(TRIM(CASE WHEN $P{lang} = 'en'
                                THEN CONCAT(sp.first_name_en, ' ', sp.last_name_en)
                                ELSE CONCAT(sp.first_name_local, ' ', sp.last_name_local) END), ''), c.created_by, '-')
                        || ' [' || COALESCE(c.comment_type, '-') || ' / ' || COALESCE(c.severity, '-') || ' / ' || COALESCE(c.status, '-') || ']: '
                        || c.comment_text, E'\n' ORDER BY c.created_date)
                   FROM pm_review_comment c
                   LEFT JOIN su_profile sp ON sp.user_id = c.created_by AND sp.is_delete = false
                  WHERE c.review_id = r.id AND c.is_delete = false) AS "comments"
            FROM pm_design_review r
            LEFT JOIN pm_customer_project p ON p.id = r.project_id
            WHERE r.is_delete = false
              AND r.id = CAST($P{designReviewId} AS uuid)
              AND ($P{businessId} IS NULL OR $P{businessId} = '' OR r.business_id = CAST(NULLIF($P{businessId}, '') AS uuid))]]></query>

	<field name="reviewCode" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="projectCode" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="reviewItemType" class="java.lang.String"/>
	<field name="reviewer" class="java.lang.String"/>
	<field name="assignedTo" class="java.lang.String"/>
	<field name="severity" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="dueDate" class="java.lang.String"/>
	<field name="figmaUrl" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<field name="comments" class="java.lang.String"/>

