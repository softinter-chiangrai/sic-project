	<parameter name="contractId" class="java.lang.String"/>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream">
        <defaultValueExpression><![CDATA[this.getClass().getResourceAsStream("/images/softinter_logo.png")]]></defaultValueExpression>
    </parameter>
	<query language="sql"><![CDATA[SELECT 
                ct.contract_no                               AS "contractNo",
                COALESCE(ct.contract_type, 'General')        AS "contractType",
                COALESCE(c.company_name_local, c.company_name_en, '-') AS "customerName",
                COALESCE(p.project_name, '-')                AS "projectName",
                COALESCE(TO_CHAR(ct.contract_value, 'FM999,999,999,990.00'), '0.00') AS "contractValue",
                COALESCE(TO_CHAR(ct.start_date, 'DD/MM/YYYY'), '-') AS "startDate",
                COALESCE(TO_CHAR(ct.end_date, 'DD/MM/YYYY'), '-')   AS "endDate",
                COALESCE(ct.sign_status, '-')                AS "signStatus",
                COALESCE(ct.renewal_status, 'NONE')          AS "renewalStatus",
                COALESCE(ct.payment_terms, '-')              AS "paymentTerms",
                COALESCE(ct.scope_summary, 'ไม่มีรายละเอียดขอบเขตงาน') AS "scopeSummary"
            FROM pm_customer_contract ct
            LEFT JOIN pm_customer c ON ct.customer_id = c.id
            LEFT JOIN pm_customer_project p ON ct.id = p.contract_id
            WHERE ct.is_delete = false
              AND ($P{contractId} IS NULL OR $P{contractId} = '' OR ct.id = CAST($P{contractId} AS uuid))
            ORDER BY ct.created_date DESC
            LIMIT 1;]]></query>
	<field name="contractNo" class="java.lang.String"/>
	<field name="contractType" class="java.lang.String"/>
	<field name="customerName" class="java.lang.String"/>
	<field name="projectName" class="java.lang.String"/>
	<field name="contractValue" class="java.lang.String"/>
	<field name="startDate" class="java.lang.String"/>
	<field name="endDate" class="java.lang.String"/>
	<field name="signStatus" class="java.lang.String"/>
	<field name="renewalStatus" class="java.lang.String"/>
	<field name="paymentTerms" class="java.lang.String"/>
	<field name="scopeSummary" class="java.lang.String"/>
