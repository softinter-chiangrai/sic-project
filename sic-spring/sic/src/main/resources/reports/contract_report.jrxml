	</parameter>
	<query language="sql"><![CDATA[SELECT
            pm_current_version_label('CONTRACT', ct.id) AS "docVersion", 
                ct.contract_no                               AS "contractNo",
                COALESCE(ct.contract_type, 'General')        AS "contractType",
                COALESCE(CASE WHEN $P{lang} = 'en' THEN c.company_name_en ELSE c.company_name_local END, c.company_name_en, c.company_name_local, '-') AS "customerName",
                COALESCE(p.project_name, '-')                AS "projectName",
                COALESCE(TO_CHAR(ct.contract_value, 'FM999,999,999,990.00'), '0.00') AS "contractValue",
                COALESCE(TO_CHAR(ct.start_date, 'DD/MM/YYYY'), '-') AS "startDate",
                COALESCE(TO_CHAR(ct.end_date, 'DD/MM/YYYY'), '-')   AS "endDate",
                COALESCE(ct.sign_status, '-')                AS "signStatus",
                COALESCE(ct.renewal_status, 'NONE')          AS "renewalStatus",
                COALESCE(ct.payment_terms, '-')              AS "paymentTerms",
                COALESCE(ct.scope_summary, 'ไม่มีรายละเอียดขอบเขตงาน') AS "scopeSummary",
                (SELECT STRING_AGG(su.file_name || ' (' || COALESCE(UPPER(substring(su.file_name from '\.([^.]+)$')) || ', ', '') || pg_size_pretty(su.file_size) || ')', ', ') FROM su_upload su
                    WHERE su.upload_group_id = ct.attachment_group_id AND su.is_active = true) AS "attachmentNames"
            FROM pm_customer_contract ct
            LEFT JOIN pm_customer c ON ct.customer_id = c.id
            LEFT JOIN pm_customer_project p ON ct.id = p.contract_id
            WHERE ct.is_delete = false
              AND ($P{contractId} IS NULL OR $P{contractId} = '' OR ct.id = CAST($P{contractId} AS uuid))
            ORDER BY ct.created_date DESC
            LIMIT 1;]]></query>
