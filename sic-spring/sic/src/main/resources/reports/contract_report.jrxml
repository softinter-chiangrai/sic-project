<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ContractReport"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              uuid="c1d2e3f4-a5b6-7890-bcde-fa2345678901">

    <!-- ========================================================
         STYLES DEFINITIONS (Clean, Minimal & Elegant)
         ======================================================== -->
    <style name="DocTitle" fontName="TH Sarabun New" fontSize="20" isBold="true" forecolor="#1E293B"/>
    <style name="DocSubtitle" fontName="TH Sarabun New" fontSize="13" forecolor="#64748B"/>
    
    <style name="SectionHeading" fontName="TH Sarabun New" fontSize="14" isBold="true" forecolor="#1E293B"/>
    
    <style name="Label" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#475569"/>
    <style name="Value" fontName="TH Sarabun New" fontSize="13" isBold="false" forecolor="#1E293B"/>
    <style name="ValueBold" fontName="TH Sarabun New" fontSize="13" isBold="true" forecolor="#1E293B"/>
    
    <style name="ContentText" fontName="TH Sarabun New" fontSize="13" forecolor="#334155"/>
    <style name="FooterText" fontName="TH Sarabun New" fontSize="11" forecolor="#94A3B8"/>

    <!-- ========================================================
         PARAMETERS
         ======================================================== -->
    <parameter name="exportDate" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="businessName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
    </parameter>
    <parameter name="logoStream" class="java.io.InputStream"/>

    <!-- ========================================================
         FIELDS
         ======================================================== -->
    <field name="contractNo"         class="java.lang.String"/>
    <field name="projectName"        class="java.lang.String"/>
    <field name="customerName"       class="java.lang.String"/>
    <field name="contractType"       class="java.lang.String"/>
    <field name="startDate"          class="java.lang.String"/>
    <field name="endDate"            class="java.lang.String"/>
    <field name="contractValue"      class="java.lang.String"/>
    <field name="billingCycle"       class="java.lang.String"/>
    <field name="paymentTerms"       class="java.lang.String"/>
    <field name="scopeSummary"       class="java.lang.String"/>
    <field name="renewalStatus"      class="java.lang.String"/>

    <!-- ========================================================
         TITLE BAND — Clean Minimal Header
         ======================================================== -->
    <title>
        <band height="105">
            <!-- Left: Logo & Company -->
            <image scaleImage="RetainShape" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="105" height="38"/>
                <imageExpression><![CDATA[$P{logoStream}]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="DocSubtitle" x="0" y="40" width="220" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD.]]></text>
            </staticText>

            <!-- Right: Title & Date -->
            <staticText>
                <reportElement style="DocTitle" x="230" y="0" width="285" height="24"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[เอกสารสรุปสัญญาว่าจ้าง]]></text>
            </staticText>
            <staticText>
                <reportElement style="DocSubtitle" x="230" y="24" width="285" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Customer Contract Summary]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="FooterText" x="230" y="42" width="285" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["วันที่ออกเอกสาร: " + ($P{exportDate} != null ? $P{exportDate} : "-")]]></textFieldExpression>
            </textField>

            <!-- Divider -->
            <line>
                <reportElement x="0" y="68" width="515" height="1" forecolor="#CBD5E1"/>
                <graphicElement><pen lineWidth="0.8"/></graphicElement>
            </line>

            <!-- Contract Main Banner -->
            <rectangle radius="3">
                <reportElement x="0" y="74" width="515" height="26" backcolor="#F8FAFC" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="10" y="77" width="60" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[เลขที่สัญญา:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="72" y="77" width="433" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{contractNo} != null ? $F{contractNo} : "-") + " (" + ($F{contractType} != null ? $F{contractType} : "General") + ")"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ========================================================
         DETAIL BAND — Simple, Clean Sections
         ======================================================== -->
    <detail>
        <band height="550">
            <!-- ────────────────────────────────────────────────────────
                 SECTION 1: ข้อมูลทั่วไปของสัญญา
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" x="0" y="8" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[1. ข้อมูลทั่วไปของสัญญา (Contract Information)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="28" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: Contract No & Sign Status -->
            <staticText>
                <reportElement style="Label" x="10" y="34" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[เลขที่สัญญา:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="98" y="34" width="155" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{contractNo} != null ? $F{contractNo} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="34" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[สถานะการลงนาม:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="358" y="34" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{signStatus} != null ? $F{signStatus} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Customer & Project -->
            <staticText>
                <reportElement style="Label" x="10" y="54" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[คู่สัญญา (ลูกค้า):]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="98" y="54" width="155" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{customerName} != null ? $F{customerName} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="54" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[โครงการที่เกี่ยวข้อง:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="358" y="54" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{projectName} != null ? $F{projectName} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 3: Contract Value & Renewal Status -->
            <staticText>
                <reportElement style="Label" x="10" y="74" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[มูลค่าสัญญา:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="ValueBold" x="98" y="74" width="155" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{contractValue} != null ? $F{contractValue} + " บาท" : "0.00 บาท"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="74" width="85" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[สถานะการต่อสัญญา:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="358" y="74" width="150" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{renewalStatus} != null ? $F{renewalStatus} : "-"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 2: ระยะเวลาและเงื่อนไขการชำระเงิน
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" x="0" y="106" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[2. ระยะเวลาและเงื่อนไขการชำระเงิน (Duration & Payment Terms)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="126" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Row 1: Start Date & End Date -->
            <staticText>
                <reportElement style="Label" x="10" y="132" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[วันเริ่มต้นสัญญา:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="118" y="132" width="135" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{startDate} != null ? $F{startDate} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="270" y="132" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[วันสิ้นสุดสัญญา:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="378" y="132" width="130" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{endDate} != null ? $F{endDate} : "-"]]></textFieldExpression>
            </textField>

            <!-- Row 2: Payment Terms Box -->
            <staticText>
                <reportElement style="Label" x="10" y="154" width="105" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[เงื่อนไขการชำระเงิน:]]></text>
            </staticText>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Value" positionType="Float" x="118" y="154" width="390" height="30"/>
                <textElement verticalAlignment="Top"/>
                <textFieldExpression><![CDATA[$F{paymentTerms} != null && !$F{paymentTerms}.isBlank() ? $F{paymentTerms} : "ตามข้อตกลงมาตรฐาน"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 3: สรุปขอบเขตงานตามสัญญา (Scope Summary)
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" positionType="Float" x="0" y="196" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[3. สรุปขอบเขตงานและข้อกำหนดสัญญา (Scope Summary)]]></text>
            </staticText>
            <line>
                <reportElement positionType="Float" x="0" y="216" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <rectangle radius="3">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="224" width="515" height="135" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="ContentText" positionType="Float" x="10" y="230" width="495" height="123"/>
                <textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="1_1_2"/>
                <textFieldExpression><![CDATA[$F{scopeSummary} != null && !$F{scopeSummary}.isBlank() ? $F{scopeSummary} : "ไม่มีรายละเอียดขอบเขตงานเพิ่มเติม"]]></textFieldExpression>
            </textField>


            <!-- ────────────────────────────────────────────────────────
                 SECTION 4: การลงนามสัญญา (Sign-off)
                 ──────────────────────────────────────────────────────── -->
            <staticText>
                <reportElement style="SectionHeading" positionType="Float" x="0" y="375" width="515" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[4. การลงนามรับรองสัญญา (Contract Execution)]]></text>
            </staticText>
            <line>
                <reportElement positionType="Float" x="0" y="395" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>

            <!-- Signatures: Provider -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="0" y="407" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" positionType="Float" x="10" y="413" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ผู้ให้บริการ (Service Provider)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="462" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="484" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ตำแหน่ง: กรรมการผู้มีอำนาจลงนาม]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="10" y="505" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[วันที่: ........ / ........ / ................]]></text>
            </staticText>

            <!-- Signatures: Client -->
            <rectangle radius="3">
                <reportElement positionType="Float" x="270" y="407" width="245" height="125" backcolor="#FAFAFA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" positionType="Float" x="280" y="413" width="225" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ผู้ว่าจ้าง / ลูกค้า (Client / Customer)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="462" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[(..................................................................)]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="484" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[ตำแหน่ง: ผู้มีอำนาจลงนาม]]></text>
            </staticText>
            <staticText>
                <reportElement style="Value" positionType="Float" x="280" y="505" width="225" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[วันที่: ........ / ........ / ................]]></text>
            </staticText>
        </band>
    </detail>

    <!-- ========================================================
         PAGE FOOTER
         ======================================================== -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="4" width="515" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.6"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="FooterText" x="0" y="10" width="350" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[SOFTINTER CO., LTD. • SIC Enterprise Platform]]></text>
            </staticText>
            <textField>
                <reportElement style="FooterText" x="380" y="10" width="135" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["หน้า " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
