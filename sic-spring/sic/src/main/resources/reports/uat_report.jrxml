	<!-- ========================================================
         DETAIL BAND — Top-to-Bottom Flow per Test Case
         ======================================================== -->
	<detail>
		<band height="180" splitType="Stretch">
			<!-- 1. Test Case Header Banner -->
			<element kind="rectangle" uuid="ca2d3e4f-5a6b-7c8d-9e0f-1a2b3c4d5e6f" positionType="Float" mode="Opaque" x="0" y="6" width="515" height="24" backcolor="#F1F5F9" radius="3">
				<pen lineWidth="0.5" lineColor="#CBD5E1"/>
			</element>

			<!-- Header: Code & Title -->
			<element kind="textField" uuid="cb2d3e4f-5a6b-7c8d-9e0f-1a2b3c4d5e6f" positionType="Float" x="8" y="7" width="280" height="22" blankWhenNull="true" vTextAlign="Middle" style="ValueBold">
				<expression><![CDATA[($F{testCaseCode} != null ? "[" + $F{testCaseCode} + "] " : "") + ($F{title} != null ? $F{title} : "-")]]></expression>
			</element>

			<!-- Header: Priority & Tester -->
			<element kind="textField" uuid="dc3e4f5a-6b7c-8d9e-0f1a-2b3c4d5e6f7a" positionType="Float" x="290" y="7" width="155" height="22" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle" style="FooterText">
				<expression><![CDATA[($P{lang}.equals("en") ? "Priority: " : "ความสำคัญ: ") + ($F{priority} != null ? $F{priority} : "-") + ($P{lang}.equals("en") ? " | Tester: " : " | ผู้ตรวจ: ") + ($F{tester} != null ? $F{tester} : "-")]]></expression>
			</element>

			<!-- Header: Status Badge -->
			<element kind="textField" uuid="cb8d9e0f-1a2b-3c4d-5e6f-7a8b9c0d1e2f" positionType="Float" x="450" y="7" width="58" height="22" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle" style="ValueBold">
				<expression><![CDATA[$F{testStatus} != null ? $F{testStatus}.toUpperCase() : "PENDING"]]></expression>
			</element>

			<!-- 2. Test Steps Section (Unified Block) -->
			<element kind="textField" uuid="af6b7c8d-9e0f-1a2b-3c4d-5e6f7a8b9c0d" positionType="Float" x="4" y="35" width="507" height="18" markup="none" blankWhenNull="true" style="ValueBold">
					<expression><![CDATA[$P{lang}.equals("en") ? "Test Steps:" : "ขั้นตอนการทดสอบ (Test Steps):"]]></expression>
				</element>
				<!-- Text + inline images + tables in original order (real List component, unlimited rows) -->
				<element kind="component" uuid="678e2f2d-7298-4aed-aa90-9010d25737e2" positionType="Float" x="4" y="53" width="507" height="20">
					<component kind="list">
						<datasetRun uuid="f4dcd62c-3f08-4452-89f4-7c43bb529dee" subDataset="ContentBlocksDataset">
							<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource(com.softinter.sicapi.util.ReportHelper.extractContentBlocks($F{testStep}, "-", 505))]]></dataSourceExpression>
						</datasetRun>
						<contents height="16" width="507">
							<element kind="textField" uuid="83efc9fa-9e73-4888-8633-1fc93bf632c4" x="0" y="0" width="507" height="16" textAdjust="StretchHeight" markup="none" blankWhenNull="true" hTextAlign="Left" vTextAlign="Top" style="ContentText">
								<printWhenExpression><![CDATA[$F{text} != null]]></printWhenExpression>
								<paragraph lineSpacing="1_1_2" style="ContentText"/>
