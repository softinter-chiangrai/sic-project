		<!-- Project Info Box -->
		<element kind="rectangle" uuid="b13e9a72-1a2b-48a5-926f-47b2ae601b2a" mode="Opaque" x="0" y="72" width="515" height="52" backcolor="#F8FAFC" radius="4">
			<pen lineWidth="0.5" lineColor="#E2E8F0"/>
		</element>
