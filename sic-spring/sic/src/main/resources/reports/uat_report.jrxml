			<expression><![CDATA["SOFTINTER CO., LTD. — Test Management Report"]]></expression>
		</element>
		<element kind="textField" uuid="af4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d" x="365" y="8" width="150" height="15" hTextAlign="Right" style="FooterText">
			<expression><![CDATA[($P{lang}.equals("en") ? "Page " : "หน้า ") + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>

	<!-- ========================================================
         SUMMARY BAND — Sign-Off Section (Standard Template)
         ======================================================== -->
	<summary height="190" splitType="Prevent">
		<!-- Section Header: Sign-off -->
		<element kind="textField" uuid="921ca47b-4d5c-48ca-913b-2a567c82a4c9" x="0" y="10" width="515" height="22" blankWhenNull="true" vTextAlign="Bottom" style="SectionHeading">
			<expression><![CDATA[($P{lang}.equals("en") ? "Sign-off & Approval" : "การรับรองและอนุมัติผลการตรวจรับระบบ (UAT Sign-off & Approval)")]]></expression>
		</element>
		<element kind="line" uuid="3d2194c7-4d5c-47b2-843e-958a1b24ca02" x="0" y="32" width="515" height="1" forecolor="#CBD5E1">
			<pen lineWidth="0.6"/>
