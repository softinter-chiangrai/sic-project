		</element>

		<!-- 3. Fail -->
		<element kind="textField" uuid="f6a7b89c-0d1e-2f3a-4b5c-6d7e8f9a0b1c" x="173" y="136" width="85" height="18" hTextAlign="Center" vTextAlign="Middle" style="Label">
