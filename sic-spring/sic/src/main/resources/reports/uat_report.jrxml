	<!-- ========================================================
         COLUMN HEADER
         ======================================================== -->
	<columnHeader height="0"/>

	<!-- ========================================================
         DETAIL BAND — Top-to-Bottom Flow per Test Case
         ======================================================== -->
	<detail>
		<band height="115" splitType="Stretch">
			<!-- 1. Test Case Header Banner -->
			<element kind="rectangle" uuid="ca2d3e4f-5a6b-7c8d-9e0f-1a2b3c4d5e6f" positionType="Float" mode="Opaque" x="0" y="6" width="515" height="24" backcolor="#F1F5F9" radius="3">
				<pen lineWidth="0.5" lineColor="#CBD5E1"/>
			</element>

			<!-- Header: Code & Title -->
			<element kind="textField" uuid="cb2d3e4f-5a6b-7c8d-9e0f-1a2b3c4d5e6f" positionType="Float" x="8" y="7" width="280" height="22" blankWhenNull="true" vTextAlign="Middle" style="ValueBold">
				<expression><![CDATA[($F{testCaseCode} != null ? "[" + $F{testCaseCode} + "] " : "") + ($F{title} != null ? $F{title} : "-")]]></expression>
			</element>

			<!-- Header: Priority & Tester -->
			<element kind="textField" uuid="dc3e4f5a-6b7c-8d9e-0f1a-2b3c4d5e6f7a" positionType="Float" x="290" y="7" width="155" height="22" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle" style="FooterText">
				<expression><![CDATA[($P{lang}.equals("en") ? "Priority: " : "ความสำคัญ: ") + ($F{priority} != null ? $F{priority} : "-") + ($P{lang}.equals("en") ? " | Tester: " : " | ผู้ตรวจ: ") + ($F{tester} != null ? $F{tester} : "-")]]></expression>
			</element>

			<!-- Header: Status Badge -->
			<element kind="textField" uuid="cb8d9e0f-1a2b-3c4d-5e6f-7a8b9c0d1e2f" positionType="Float" x="450" y="7" width="58" height="22" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle" style="ValueBold">
				<expression><![CDATA[$F{testStatus} != null ? $F{testStatus}.toUpperCase() : "PENDING"]]></expression>
			</element>

			<!-- 2. Test Steps Section (Unified Block) -->
			<element kind="textField" uuid="af6b7c8d-9e0f-1a2b-3c4d-5e6f7a8b9c0d" positionType="Float" x="4" y="35" width="507" height="20" textAdjust="StretchHeight" markup="styled" blankWhenNull="true" style="ContentText">
				<expression><![CDATA[com.softinter.sicapi.util.ReportHelper.formatSection($P{lang}.equals("en") ? "Test Steps:" : "ขั้นตอนการทดสอบ (Test Steps):", $F{testStep})]]></expression>
			</element>

			<!-- 3. Expected Result Section (Unified Block) -->
			<element kind="textField" uuid="ba7c8d9e-0f1a-2b3c-4d5e-6f7a8b9c0d1e" positionType="Float" x="4" y="60" width="507" height="20" textAdjust="StretchHeight" markup="styled" blankWhenNull="true" style="ContentText">
				<expression><![CDATA[com.softinter.sicapi.util.ReportHelper.formatSection($P{lang}.equals("en") ? "Expected Result:" : "ผลลัพธ์ที่คาดหวัง (Expected Result):", $F{expectedResult})]]></expression>
			</element>

			<!-- 4. Actual Result Section (Unified Block) -->
			<element kind="textField" uuid="ce0f1a2b-3c4d-5e6f-7a8b-9c0d1e2f3a4b" positionType="Float" x="4" y="85" width="507" height="20" textAdjust="StretchHeight" markup="styled" blankWhenNull="true" style="ContentText">
				<expression><![CDATA[com.softinter.sicapi.util.ReportHelper.formatSection($P{lang}.equals("en") ? "Actual Result:" : "ผลลัพธ์ที่ได้จริง (Actual Result):", $F{actualResult})]]></expression>
			</element>

			<!-- 5. Divider Line between Test Cases -->
			<element kind="line" uuid="921ca47b-1b2a-48ca-913b-2a567c82a4c9" positionType="Float" x="0" y="110" width="515" height="1" forecolor="#CBD5E1">
				<pen lineWidth="0.8"/>
			</element>
		</band>
	</detail>

	<!-- ========================================================
         PAGE FOOTER (Must come before summary)
         ======================================================== -->
	<pageFooter height="25">
		<element kind="line" uuid="ed2f3a4b-5c6d-7e8f-9a0b-1c2d3e4f5a6b" x="0" y="4" width="515" height="1" forecolor="#CBD5E1">
			<pen lineWidth="0.5"/>
		</element>
