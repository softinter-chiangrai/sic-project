			<expression><![CDATA[($P{lang}.equals("en") ? "Project:" : "โครงการ:")]]></expression>
		</element>
		<element kind="textField" uuid="2a5c1a8c-5e4b-92bc-a8e5-659858df341a" x="80" y="78" width="230" height="18" blankWhenNull="true" style="ValueBold">
			<expression><![CDATA[$P{projectName} != null ? $P{projectName} : "-"]]></expression>
		</element>
		<element kind="textField" uuid="5c1a8c5e-4b92-bca8-e565-9858df341a2b" x="320" y="78" width="50" height="18" style="Label">
			<expression><![CDATA[($P{lang}.equals("en") ? "Customer:" : "ลูกค้า:")]]></expression>
		</element>
		<element kind="textField" uuid="1a8c5e4b-92bc-a8e5-6598-58df341a2b5c" x="370" y="78" width="135" height="18" blankWhenNull="true" style="Value">
			<expression><![CDATA[$P{customerName} != null ? $P{customerName} : "-"]]></expression>
		</element>
		<element kind="textField" uuid="7a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d" x="10" y="98" width="70" height="18" style="Label">
			<expression><![CDATA[($P{lang}.equals("en") ? "Test Type:" : "ประเภทการทดสอบ:")]]></expression>
		</element>
		<element kind="textField" uuid="9b0c1d2e-3f4a-5b6c-7d8e-9f0a1b2c3d4e" x="80" y="98" width="230" height="18" blankWhenNull="true" style="Value">
			<expression><![CDATA[($P{lang}.equals("en") ?
				($P{testTypeFilter} != null && $P{testTypeFilter}.equals("SIT") ? "System Integration Testing (SIT)" : ($P{testTypeFilter} != null && $P{testTypeFilter}.equals("ALL") ? "All Test Results (ALL)" : "User Acceptance Testing (UAT)")) :
				($P{testTypeFilter} != null && $P{testTypeFilter}.equals("SIT") ? "การทดสอบระบบภายใน (SIT)" : ($P{testTypeFilter} != null && $P{testTypeFilter}.equals("ALL") ? "รายงานผลการทดสอบทั้งหมด (ALL)" : "การตรวจรับระบบโดยผู้ใช้ (UAT)")))]]></expression>
		</element>

		<!-- Statistics Summary Grid -->
		<element kind="rectangle" uuid="a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d" mode="Opaque" x="0" y="130" width="515" height="58" backcolor="#F8FAFC" radius="4">
			<pen lineWidth="0.5" lineColor="#E2E8F0"/>
		</element>

		<!-- Stat Cards: 6 Equal Columns, Vertically & Horizontally Centered, Standard Theme Colors -->
		<!-- 1. Total Cases -->
		<element kind="textField" uuid="b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e" x="3" y="136" width="85" height="18" hTextAlign="Center" vTextAlign="Middle" style="Label">
			<expression><![CDATA[($P{lang}.equals("en") ? "Total Cases" : "เคสทั้งหมด")]]></expression>
		</element>
		<element kind="textField" uuid="c3d4e5f6-a7b8-9c0d-1e2f-3a4b5c6d7e8f" x="3" y="156" width="85" height="26" hTextAlign="Center" vTextAlign="Middle" style="StatNumber">
			<expression><![CDATA[$P{totalCases} != null ? $P{totalCases} : "0"]]></expression>
		</element>

		<!-- 2. Pass -->
		<element kind="textField" uuid="d4e5f6a7-b89c-0d1e-2f3a-4b5c6d7e8f9a" x="88" y="136" width="85" height="18" hTextAlign="Center" vTextAlign="Middle" style="Label">
			<expression><![CDATA[($P{lang}.equals("en") ? "Pass" : "ผ่าน (Pass)")]]></expression>
