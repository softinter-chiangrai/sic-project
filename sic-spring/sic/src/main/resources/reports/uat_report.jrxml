					<expression><![CDATA["Scenario: [" + ($F{scenarioCode} != null ? $F{scenarioCode} : "-") + "] " + ($F{scenarioName} != null ? $F{scenarioName} : "-")]]></expression>
				</element>
			</band>
		</groupHeader>
	</group>

