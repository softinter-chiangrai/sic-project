	<style name="FooterText" forecolor="#94A3B8" fontName="TH Sarabun New" fontSize="11.0"/>

	<parameter name="projectId" class="java.lang.String"/>
	<parameter name="projectName" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerName" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="exportDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
	</parameter>
	<parameter name="businessName" class="java.lang.String">
		<defaultValueExpression><![CDATA["SOFTINTER CO., LTD."]]></defaultValueExpression>
	</parameter>
	<parameter name="logoStream" class="java.io.InputStream"/>
	<parameter name="totalCases" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="passCount" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="failCount" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="blockedCount" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="pendingCount" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="passRate" class="java.lang.String">
		<defaultValueExpression><![CDATA["0%"]]></defaultValueExpression>
	</parameter>
	<parameter name="testTypeFilter" class="java.lang.String">
		<defaultValueExpression><![CDATA["UAT"]]></defaultValueExpression>
	</parameter>
	<parameter name="scenarioId" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>

	<query language="sql"><![CDATA[SELECT 
                COALESCE(sc.scenario_code, '-') AS "scenarioCode",
                COALESCE(sc.scenario_name, 'General Test Cases') AS "scenarioName",
                COALESCE(tc.test_case_code, '-') AS "testCaseCode",
                COALESCE(tc.title, '-') AS "title",
                COALESCE(tc.priority, 'Medium') AS "priority",
                COALESCE(tc.test_step, '-') AS "testStep",
                COALESCE(tc.expected_result, '-') AS "expectedResult",
                COALESCE(tc.actual_result, '-') AS "actualResult",
                COALESCE(tc.test_status, 'Pending') AS "testStatus",
                COALESCE(tc.tester, '-') AS "tester"
            FROM pm_test_case tc
            LEFT JOIN pm_test_scenario sc ON sc.id = tc.scenario_id AND sc.is_delete = false
            WHERE tc.is_delete = false
              AND ($P{projectId} IS NULL OR $P{projectId} = '' OR tc.project_id = CAST($P{projectId} AS uuid) OR sc.project_id = CAST($P{projectId} AS uuid))
              AND ($P{scenarioId} IS NULL OR $P{scenarioId} = '' OR tc.scenario_id = CAST($P{scenarioId} AS uuid))
              AND (
                  ($P{testTypeFilter} = 'UAT' AND (tc.test_type = 'UAT' OR (tc.test_type IS NULL AND sc.test_type = 'UAT')))
                  OR ($P{testTypeFilter} = 'SIT' AND (tc.test_type = 'SIT' OR (tc.test_type IS NULL AND (sc.test_type = 'SIT' OR sc.test_type IS NULL))))
                  OR ($P{testTypeFilter} IS NULL OR $P{testTypeFilter} = '' OR $P{testTypeFilter} = 'ALL')
              )
            ORDER BY sc.scenario_code ASC, tc.test_case_code ASC;]]></query>

	<field name="scenarioCode" class="java.lang.String"/>
	<field name="scenarioName" class="java.lang.String"/>
	<field name="testCaseCode" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="priority" class="java.lang.String"/>
	<field name="testStep" class="java.lang.String"/>
	<field name="expectedResult" class="java.lang.String"/>
	<field name="actualResult" class="java.lang.String"/>
	<field name="testStatus" class="java.lang.String"/>
	<field name="tester" class="java.lang.String"/>

