	<query language="sql"><![CDATA[SELECT 
                CONCAT('DELIVERABLE (', COALESCE(it.item_type, 'ITEM'), ')') AS "category",
                COALESCE(it.item_code, '-')                                 AS "code",
                COALESCE(it.item_title, '-')                                AS "title",
                COALESCE(it.item_status, 'DONE')                            AS "status",
                COALESCE(it.remark, '')                                     AS "remark"
            FROM pm_delivery_item it
            WHERE it.is_delete = false
              AND ($P{deliveryId} IS NULL OR $P{deliveryId} = '' OR it.delivery_id = CAST($P{deliveryId} AS uuid))
            UNION ALL
            SELECT 
                CONCAT('CHECKLIST (', COALESCE(chk.item_category, 'GENERAL'), ')') AS "category",
                '-'                                                         AS "code",
                COALESCE(chk.item_name, '-')                                AS "title",
                CASE WHEN chk.is_checked = true THEN 'PASS' ELSE 'PENDING' END AS "status",
                COALESCE(chk.remark, '')                                    AS "remark"
            FROM pm_delivery_checklist chk
            WHERE chk.is_delete = false
              AND ($P{deliveryId} IS NULL OR $P{deliveryId} = '' OR chk.delivery_id = CAST($P{deliveryId} AS uuid))
            ORDER BY "category" ASC;]]></query>

