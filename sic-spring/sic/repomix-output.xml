           "LEFT JOIN FETCH p.country " +
           "LEFT JOIN FETCH c.district " +
           "LEFT JOIN FETCH c.subDistrict " +
           "WHERE c.businessId = :businessId AND c.isDelete = false AND c.isActive = true")
