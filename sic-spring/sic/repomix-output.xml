    @Modifying
    @Query("UPDATE SuChatLog c SET c.isRead = true WHERE c.senderId = :senderId AND c.receiverId = :receiverId AND c.isRead = false")
    int markAsRead(@Param("senderId") String senderId, @Param("receiverId") String receiverId);
