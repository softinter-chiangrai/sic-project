        this.nameEn = nameEn;
        this.nameLocal = nameLocal;
        this.routePath = routePath;
        this.sortOrder = sortOrder;
        this.isActive = isActive;
        this.rowVersion = rowVersion;
        this.state = state;
        this.add = isAdd;
        this.back = isBack;
        this.print = isPrint;
        this.remove = isRemove;
        this.save = isSave;
        this.search = isSearch;
    }
