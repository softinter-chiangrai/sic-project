		<query language="sql"><![CDATA[SELECT "text", "imageData", "imgWidth", "align", "tableRow", "cols", c1, c2, c3, c4, c5, c6
            FROM pm_rich_blocks(CAST($P{html} AS text), CAST($P{extra} AS text), CAST($P{fallback} AS text)) ORDER BY seq]]></query>
