	</parameter>

	<query language="sql"><![CDATA[WITH items AS (
                SELECT row_number() OVER (ORDER BY item.sort_order ASC, item.created_date ASC) AS rn, item.*
                  FROM pm_invoice_item item
                 WHERE item.is_delete = false
                   AND ($P{invoiceId} IS NULL OR $P{invoiceId} = '' OR item.invoice_id = CAST($P{invoiceId} AS uuid))
            )
            SELECT ord, "itemNo", "itemCode", "itemName", "itemDescription", "quantity", "unitPrice", "discount", "itemAmount" FROM (
                SELECT rn AS ord,
                       rn::text                                                                           AS "itemNo",
                       COALESCE(item_code, '')                                                            AS "itemCode",
                       COALESCE(item_name, '-')                                                           AS "itemName",
                       COALESCE(description, '')                                                          AS "itemDescription",
                       trim_scale(COALESCE(quantity, 1))::text                                            AS "quantity",
                       TO_CHAR(COALESCE(unit_price, amount, 0), 'FM999,999,999,990.00')                   AS "unitPrice",
                       CASE WHEN COALESCE(discount, 0) = 0 THEN '-' ELSE TO_CHAR(discount, 'FM999,999,999,990.00') END AS "discount",
                       TO_CHAR(COALESCE(amount, 0), 'FM999,999,999,990.00')                               AS "itemAmount"
                  FROM items
                UNION ALL
                -- blank rows so the table always fills the page like a printed invoice form
                SELECT 100000 + g, '', '', '', '', '', '', '', ''
                  FROM generate_series(1, GREATEST(0, 6 - (SELECT count(*) FROM items))) g
            ) rows
            ORDER BY ord]]></query>
	<field name="ord" class="java.lang.Long"/>
	<field name="itemNo" class="java.lang.String"/>
	<field name="itemCode" class="java.lang.String"/>
	<field name="itemName" class="java.lang.String"/>
	<field name="itemDescription" class="java.lang.String"/>
	<field name="quantity" class="java.lang.String"/>
	<field name="unitPrice" class="java.lang.String"/>
	<field name="discount" class="java.lang.String"/>
	<field name="itemAmount" class="java.lang.String"/>

