# ==============================================================================
# SIC Project - Environment Variables Template
# Copy this file to .env and adjust values as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_PORT=54320
POSTGRES_USER=administrator
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres

# Database names & credentials for microservices
SIC_APP_DB_NAME=sic_app
SIC_APP_DB_USER=sic-app
SIC_APP_DB_PASSWORD=change_me

KEYCLOAK_DB_NAME=sic_auth
KEYCLOAK_DB_USER=sic-auth
KEYCLOAK_DB_PASSWORD=change_me

# ------------------------------------------------------------------------------
# 2. Keycloak (Authentication)
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=administrator
KEYCLOAK_ADMIN_PASSWORD=change_me
APP_KEYCLOAK_AUTH_SERVER_URL=http://sic-auth:8080
APP_KEYCLOAK_REALM=sic-project
APP_KEYCLOAK_RESOURCE=sic-app

# ------------------------------------------------------------------------------
# 3. SeaweedFS (Object Storage)
# ------------------------------------------------------------------------------
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8081
SEAWEEDFS_S3_PORT=8888
SEAWEEDFS_ACCESS_KEY=seaweedfs
SEAWEEDFS_SECRET_KEY=change_me
APP_STORAGE_S3_ENDPOINT=http://sic-seaweedfs:8333
APP_STORAGE_S3_BUCKET=public-files
APP_STORAGE_S3_DOCUMENT_BUCKET=documents

# ------------------------------------------------------------------------------
# 4. Report Service
# ------------------------------------------------------------------------------
REPORT_SERVICE_PORT=8082
REPORT_SERVICE_URL=http://sic-report-service:80
REPORT_SERVICE_TOKEN=change_me

# ------------------------------------------------------------------------------
# 5. Spring Boot Backend API
# ------------------------------------------------------------------------------
SPRING_SERVER_PORT=5265

# AI API Keys
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_DEFAULT_MODEL=gemini-2.5-flash-lite
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-2.5-flash-lite

# Figma Integration
FIGMA_CLIENT_ID=your_figma_client_id
FIGMA_CLIENT_SECRET=your_figma_client_secret
FIGMA_REDIRECT_URI=http://localhost:4200/feature/pm/design-review

# ------------------------------------------------------------------------------
# 6. Frontend App (Angular SSR)
# ------------------------------------------------------------------------------
APP_PORT=4200
GITHUB_TOKEN=your_github_personal_access_token_here


# Mail (SMTP, Gmail app password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
