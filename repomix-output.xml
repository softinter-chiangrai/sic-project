        <!-- Change Reason -->
        <div>
          <sic-combobox
            label="สาเหตุการเปลี่ยนแปลง"
            formControlName="changeReason"
            [apiUrl]="environment.apiBaseUrl + '/api/db/parameter/lov?group=PM&parameterCode=CHANGE_REASON'"
            valueField="value"
            textField="text"
