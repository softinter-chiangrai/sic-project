          <input type="hidden" formControlName="assigneeId" />
          @if (form.get('assigneeId')?.touched && form.get('assigneeId')?.errors?.['required']) {
            <p class="text-red-500 text-xs mt-1">กรุณาเลือกผู้รับมอบหมาย</p>
          }
        </div>

        <!-- Hidden projectId -->
        <input type="hidden" formControlName="projectId" />
      </div>

      <!-- Approval Flow Selection -->
      <div class="border-t border-[var(--border)] pt-4 mt-2">
        <div class="text-sm font-medium text-[var(--text-active)] mb-2 flex items-center gap-2">
          <i class="bi bi-check2-circle text-[var(--crm-primary)]"></i>
