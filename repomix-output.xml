    {{ isEdit ? 'แก้ไข Task' : 'สร้าง Task ใหม่' }}
  </h2>

  <form [formGroup]="form" (ngSubmit)="onSubmit()" class="space-y-4">

    <!-- Task Code & Name -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-[var(--text)]">รหัส Task <span class="text-red-500">*</span></label>
        <input type="text" formControlName="taskCode" class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] outline-none transition-all" />
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--text)]">ชื่อ Task <span class="text-red-500">*</span></label>
        <input type="text" formControlName="taskName" class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] outline-none transition-all" />
      </div>
    </div>

    <!-- Description -->
    <div>
      <label class="block text-sm font-medium text-[var(--text)]">คำอธิบาย</label>
      <textarea formControlName="description" rows="3" class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] outline-none transition-all"></textarea>
    </div>

    <!-- ✅ ผู้รับผิดชอบ (หลายคน) -->
    <div>
      <label class="block text-sm font-medium text-[var(--text)] mb-1">ผู้รับผิดชอบร่วม</label>
      
      <!-- Combobox เลือกทีละคน -->
      <sic-combobox
        #assigneeCombobox
        [apiUrl]="assignedToApiUrl"
        valueField="value"
        textField="text"
        placeholder="พิมพ์หรือเลือกผู้รับผิดชอบ..."
        [clearable]="true"
        [excludeValues]="assigneeIds.value || []"
        (selectionChanged)="onAssigneeSelect($event)"
      ></sic-combobox>

      <!-- แสดงรายชื่อที่เลือกเป็น Chips -->
      <div class="mt-2 flex flex-wrap gap-2">
        @for (userId of assigneeIds.value || []; track userId) {
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-medium bg-[var(--crm-primary)]/10 text-[var(--crm-primary)] border border-[var(--crm-primary)]/20">
            {{ getAssigneeName(userId) }}
            <button type="button" (click)="removeAssignee(userId)" class="ml-1 text-[var(--crm-primary)] hover:text-[var(--crm-danger)] transition-colors" title="ลบ">
              <i class="bi bi-x-lg text-xs"></i>
            </button>
          </span>
        }
        @if ((assigneeIds.value || []).length === 0) {
          <span class="text-sm text-[var(--text-muted)]">ยังไม่มีผู้รับผิดชอบร่วม</span>
        }
      </div>
    </div>

    <!-- Start Date + Time -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <sic-datepicker
          label="วันที่เริ่ม"
          formControlName="startDate"
          [required]="true"
          placeholder="เลือกวันที่เริ่ม"
        ></sic-datepicker>
        @if (form.get('startDate')?.touched && form.get('startDate')?.invalid) {
          <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุวันที่เริ่ม</p>
        }
      </div>
      <div>
        <sic-timepicker
          label="เวลาเริ่ม"
          formControlName="startTime"
          placeholder="เลือกเวลา"
        ></sic-timepicker>
      </div>
    </div>

    <!-- End Date + Time -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <sic-datepicker
          label="วันที่สิ้นสุด"
          formControlName="endDate"
          [required]="true"
          placeholder="เลือกวันที่สิ้นสุด"
        ></sic-datepicker>
        @if (form.get('endDate')?.touched && form.get('endDate')?.invalid) {
          <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุวันที่สิ้นสุด</p>
        }
      </div>
      <div>
        <sic-timepicker
          label="เวลาสิ้นสุด"
          formControlName="endTime"
          placeholder="เลือกเวลา"
        ></sic-timepicker>
      </div>
    </div>

    <!-- Estimate Manday & Priority -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-[var(--text)]">Manday โดยประมาณ <span class="text-red-500">*</span></label>
        <input type="number" formControlName="estimateManday" class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] outline-none transition-all" />
        @if (form.get('estimateManday')?.touched && form.get('estimateManday')?.invalid) {
          <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุ Manday (มากกว่า 0)</p>
