      <div
        class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3"
      >
        <sic-input
          label="เลข Ticket"
          formControlName="ticketNo"
          [required]="true"
          placeholder="MA-001"
        ></sic-input>
        @if (form.get('ticketNo')?.touched && form.get('ticketNo')?.invalid) {
          <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุเลข Ticket</p>
        }
