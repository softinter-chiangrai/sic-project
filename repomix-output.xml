        <div class="md:col-span-2">
          <p class="text-xs text-[var(--text-muted)] uppercase tracking-wider">เงื่อนไขการยอมรับ</p>
          <p class="text-sm text-[var(--text)] mt-1">{{ req.acceptanceCriteria || '-' }}</p>
        </div>
      </div>
  }

  <!-- ===== QUICK ACTIONS ===== -->
  <div>
    <h2 class="text-lg font-semibold text-[var(--text-active)] mb-3 flex items-center gap-2">
      <i class="bi bi-grid-3x3-gap-fill text-[var(--crm-primary)]"></i>
      สร้างเอกสารที่เกี่ยวข้อง
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
      <!-- ปุ่มสร้าง Diagram (รวม DFD + ER) -->
      <button
        (click)="createDiagram()"
        class="flex flex-col items-center justify-center gap-1 px-3 py-3 rounded-lg border border-[var(--border)] bg-[var(--sidebar)] hover:bg-[var(--sidebar-hover)] transition-all text-sm text-[var(--text)]"
      >
        <i class="bi bi-diagram-3 text-xl text-[var(--crm-primary)]"></i>
        <span>Diagram</span>
      </button>
      <!-- ปุ่มอื่น ๆ ตามเดิม -->
      <button
        (click)="createSpec()"
        class="flex flex-col items-center justify-center gap-1 px-3 py-3 rounded-lg border border-[var(--border)] bg-[var(--sidebar)] hover:bg-[var(--sidebar-hover)] transition-all text-sm text-[var(--text)]"
      >
        <i class="bi bi-file-text text-xl text-[var(--crm-primary)]"></i>
        <span>Specification</span>
      </button>

      <button
        (click)="createDesignReview()"
        class="flex flex-col items-center justify-center gap-1 px-3 py-3 rounded-lg border border-[var(--border)] bg-[var(--sidebar)] hover:bg-[var(--sidebar-hover)] transition-all text-sm text-[var(--text)]"
      >
        <i class="bi bi-check2-square text-xl text-[var(--crm-primary)]"></i>
        <span>Design Review</span>
      </button>
      <button
        (click)="createTask()"
        class="flex flex-col items-center justify-center gap-1 px-3 py-3 rounded-lg border border-[var(--border)] bg-[var(--sidebar)] hover:bg-[var(--sidebar-hover)] transition-all text-sm text-[var(--text)]"
      >
        <i class="bi bi-list-task text-xl text-[var(--crm-primary)]"></i>
        <span>Task</span>
      </button>
      <button
        (click)="createTest()"
        class="flex flex-col items-center justify-center gap-1 px-3 py-3 rounded-lg border border-[var(--border)] bg-[var(--sidebar)] hover:bg-[var(--sidebar-hover)] transition-all text-sm text-[var(--text)]"
      >
        <i class="bi bi-clipboard-data text-xl text-[var(--crm-primary)]"></i>
        <span>Test Case</span>
      </button>
      <button
        (click)="createBug()"
        class="flex flex-col items-center justify-center gap-1 px-3 py-3 rounded-lg border border-[var(--border)] bg-[var(--sidebar)] hover:bg-[var(--sidebar-hover)] transition-all text-sm text-[var(--text)]"
      >
        <i class="bi bi-bug text-xl text-[var(--crm-danger)]"></i>
        <span>Bug</span>
      </button>
    </div>
  </div>

  <!-- ===== RELATED ITEMS ===== -->
  <div>
    <h2 class="text-lg font-semibold text-[var(--text-active)] mb-3 flex items-center gap-2">
      <i class="bi bi-link-45deg text-[var(--crm-primary)]"></i>
      ความสัมพันธ์ (Trace Links)
    </h2>

    @if (traceLinks().length === 0) {
      <div
        class="text-center py-8 text-[var(--text-muted)] border border-dashed border-[var(--border)] rounded-xl"
      >
        <i class="bi bi-inbox text-4xl block mb-2 opacity-30"></i>
        <p>ยังไม่มีเอกสารที่เชื่อมโยงกับ Requirement นี้</p>
        <p class="text-sm">ใช้ปุ่มด้านบนเพื่อสร้างเอกสารใหม่</p>
      </div>
    } @else {
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Diagrams (DFD + ER) -->
        @if (diagrams().length > 0) {
          <sic-card>
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
              <span class="font-semibold text-[var(--text-active)] flex items-center gap-2">
                <i class="bi bi-diagram-3 text-[var(--crm-primary)]"></i>
                Diagrams
              </span>
              <span class="text-xs text-[var(--text-muted)]">{{ diagrams().length }} รายการ</span>
            </div>
            <ul class="mt-2 space-y-1">
              @for (item of diagrams(); track item.id) {
                <li>
                  <a
                    [routerLink]="item.link"
                    class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-2"
                  >
                    <span class="font-mono text-xs">{{ item.code }}</span>
                    <span
                      class="inline-block px-2 py-0.5 rounded text-xs font-medium"
                      [class.bg-blue-100]="item.type === 'DFD'"
                      [class.text-blue-700]="item.type === 'DFD'"
                      [class.bg-emerald-100]="item.type === 'ER'"
                      [class.text-emerald-700]="item.type === 'ER'"
                    >
                      {{ item.type }}
                    </span>
                    <span>{{ item.name }}</span>
                  </a>
                </li>
              }
            </ul>
          </sic-card>
        }

        <!-- Specification -->
        @if (specList().length > 0) {
          <sic-card>
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
              <span class="font-semibold text-[var(--text-active)] flex items-center gap-2">
                <i class="bi bi-file-text text-[var(--crm-primary)]"></i>
                Specification
              </span>
              <span class="text-xs text-[var(--text-muted)]">{{ specList().length }} รายการ</span>
            </div>
            <ul class="mt-2 space-y-1">
              @for (item of specList(); track item.id) {
                <li>
                  <a
                    [routerLink]="item.link"
                    class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-2"
                  >
                    <span class="font-mono text-xs">{{ item.code }}</span>
                    <span>{{ item.name }}</span>
                  </a>
                </li>
              }
            </ul>
          </sic-card>
        }

        <!-- Task -->
        @if (taskList().length > 0) {
          <sic-card>
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
              <span class="font-semibold text-[var(--text-active)] flex items-center gap-2">
                <i class="bi bi-list-task text-[var(--crm-primary)]"></i>
                Task
              </span>
              <span class="text-xs text-[var(--text-muted)]">{{ taskList().length }} รายการ</span>
            </div>
            <ul class="mt-2 space-y-1">
              @for (item of taskList(); track item.id) {
                <li>
                  <a
                    [routerLink]="item.link"
                    class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-2"
                  >
                    <span class="font-mono text-xs">{{ item.code }}</span>
                    <span>{{ item.name }}</span>
                  </a>
                </li>
              }
            </ul>
          </sic-card>
        }

        <!-- Test Case -->
        @if (testList().length > 0) {
          <sic-card>
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
              <span class="font-semibold text-[var(--text-active)] flex items-center gap-2">
                <i class="bi bi-clipboard-data text-[var(--crm-primary)]"></i>
                Test Case
              </span>
              <span class="text-xs text-[var(--text-muted)]">{{ testList().length }} รายการ</span>
            </div>
            <ul class="mt-2 space-y-1">
              @for (item of testList(); track item.id) {
                <li>
                  <a
                    [routerLink]="item.link"
                    class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-2"
                  >
                    <span class="font-mono text-xs">{{ item.code }}</span>
                    <span>{{ item.name }}</span>
                  </a>
                </li>
              }
            </ul>
          </sic-card>
        }

        <!-- Bug -->
        @if (bugList().length > 0) {
          <sic-card>
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
              <span class="font-semibold text-[var(--text-active)] flex items-center gap-2">
                <i class="bi bi-bug text-[var(--crm-danger)]"></i>
                Bug
              </span>
              <span class="text-xs text-[var(--text-muted)]">{{ bugList().length }} รายการ</span>
            </div>
            <ul class="mt-2 space-y-1">
              @for (item of bugList(); track item.id) {
                <li>
                  <a
                    [routerLink]="item.link"
                    class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-2"
                  >
                    <span class="font-mono text-xs">{{ item.code }}</span>
                    <span>{{ item.name }}</span>
                  </a>
                </li>
              }
            </ul>
          </sic-card>
        }

        <!-- Change Request -->
        @if (changeRequestList().length > 0) {
          <sic-card>
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
              <span class="font-semibold text-[var(--text-active)] flex items-center gap-2">
                <i class="bi bi-arrow-left-right text-[var(--crm-primary)]"></i>
                Change Request
              </span>
              <span class="text-xs text-[var(--text-muted)]"
                >{{ changeRequestList().length }} รายการ</span
              >
            </div>
            <ul class="mt-2 space-y-1">
              @for (item of changeRequestList(); track item.id) {
                <li>
                  <a
                    [routerLink]="item.link"
                    class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-2"
                  >
                    <span class="font-mono text-xs">{{ item.code }}</span>
                    <span>{{ item.name }}</span>
                  </a>
                </li>
              }
            </ul>
          </sic-card>
        }

        <!-- Design Review -->
        @if (designReviewList().length > 0) {
          <sic-card>
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
              <span class="font-semibold text-[var(--text-active)] flex items-center gap-2">
                <i class="bi bi-check2-square text-[var(--crm-primary)]"></i>
                Design Review
              </span>
              <span class="text-xs text-[var(--text-muted)]"
                >{{ designReviewList().length }} รายการ</span
              >
            </div>
            <ul class="mt-2 space-y-1">
              @for (item of designReviewList(); track item.id) {
                <li>
                  <a
                    [routerLink]="item.link"
                    class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-2"
                  >
                    <span class="font-mono text-xs">{{ item.code }}</span>
                    <span>{{ item.name }}</span>
                  </a>
                </li>
              }
            </ul>
          </sic-card>
        }
      </div>
    }
  </div>
</div>
</file>

