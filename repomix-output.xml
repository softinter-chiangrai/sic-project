          ></sic-input>
        </div>

        <!-- Description -->
        <div class="md:col-span-2">
          <sic-input-area
            label="คำอธิบายรายละเอียดการเปลี่ยนแปลง"
            formControlName="description"
            [rows]="3"
            placeholder="อธิบายรายละเอียดการเปลี่ยนแปลงที่ต้องการ"
