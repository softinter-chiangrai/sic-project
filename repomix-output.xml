            >
              เลขสัญญา
              @if (sortBy() === 'contractNo') {
                <i
                  class="bi text-xs ml-1 text-[var(--crm-primary)]"
                  [class.bi-chevron-up]="sortDir() === 'asc'"
                  [class.bi-chevron-down]="sortDir() === 'desc'"
                ></i>
              }
            </th>
            <th
              (click)="onSortChange('contractType')"
              class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider cursor-pointer hover:text-[var(--text-active)] transition-colors whitespace-nowrap min-w-[140px]"
            >
              ประเภท
              @if (sortBy() === 'contractType') {
                <i
                  class="bi text-xs ml-1 text-[var(--crm-primary)]"
                  [class.bi-chevron-up]="sortDir() === 'asc'"
                  [class.bi-chevron-down]="sortDir() === 'desc'"
                ></i>
              }
            </th>
            <th
              (click)="onSortChange('customerName')"
              class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider cursor-pointer hover:text-[var(--text-active)] transition-colors whitespace-nowrap min-w-[150px]"
            >
              ลูกค้า
              @if (sortBy() === 'customerName') {
                <i
                  class="bi text-xs ml-1 text-[var(--crm-primary)]"
                  [class.bi-chevron-up]="sortDir() === 'asc'"
                  [class.bi-chevron-down]="sortDir() === 'desc'"
                ></i>
              }
            </th>
            <th
              (click)="onSortChange('projectName')"
              class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider cursor-pointer hover:text-[var(--text-active)] transition-colors whitespace-nowrap min-w-[130px]"
            >
              โครงการ
              @if (sortBy() === 'projectName') {
                <i
                  class="bi text-xs ml-1 text-[var(--crm-primary)]"
                  [class.bi-chevron-up]="sortDir() === 'asc'"
                  [class.bi-chevron-down]="sortDir() === 'desc'"
                ></i>
              }
            </th>
            <th
              (click)="onSortChange('contractValue')"
              class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider cursor-pointer hover:text-[var(--text-active)] transition-colors whitespace-nowrap min-w-[120px]"
            >
              มูลค่า
              @if (sortBy() === 'contractValue') {
                <i
                  class="bi text-xs ml-1 text-[var(--crm-primary)]"
                  [class.bi-chevron-up]="sortDir() === 'asc'"
                  [class.bi-chevron-down]="sortDir() === 'desc'"
                ></i>
              }
            </th>
            <th
              class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider whitespace-nowrap min-w-[140px] hidden md:table-cell"
            >
              ระยะเวลา
            </th>
            <th
              (click)="onSortChange('signStatus')"
              class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider cursor-pointer hover:text-[var(--text-active)] transition-colors whitespace-nowrap min-w-[100px]"
            >
              สถานะลงนาม
              @if (sortBy() === 'signStatus') {
                <i
                  class="bi text-xs ml-1 text-[var(--crm-primary)]"
                  [class.bi-chevron-up]="sortDir() === 'asc'"
                  [class.bi-chevron-down]="sortDir() === 'desc'"
                ></i>
              }
            </th>
            <th
              class="px-4 py-3 text-center text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider whitespace-nowrap min-w-[260px]"
            >
              จัดการ
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--border)]">
          @for (contract of paginatedContracts(); track contract.id) {
            <tr class="hover:bg-[var(--sidebar-hover)] transition-colors">
              <td class="px-4 py-3">
                <span
                  class="inline-block px-2 py-0.5 rounded text-xs font-semibold font-mono tracking-wide text-[var(--crm-primary)] bg-[var(--crm-primary)]/10"
                >
                  {{ contract.contractNo }}
                </span>
              </td>
              <td class="px-4 py-3">
                <span class="text-[var(--text-active)]">{{ contract.contractType }}</span>
              </td>
              <td class="px-4 py-3">
                <span class="text-[var(--text-active)]">{{ contract.customerName }}</span>
              </td>
              <td class="px-4 py-3">
                <button
                  (click)="goToProject(contract.projectId)"
                  class="text-[var(--crm-primary)] hover:underline transition-colors"
                >
                  {{ contract.projectName }}
                </button>
              </td>
              <td class="px-4 py-3 font-mono text-[var(--text-active)]">
                {{ formatCurrency(contract.contractValue) }}
              </td>
              <td class="px-4 py-3 text-sm text-[var(--text-muted)] font-mono hidden md:table-cell">
                {{ formatDate(contract.startDate) }} - {{ formatDate(contract.endDate) }}
              </td>
              <td class="px-4 py-3">
                <span
                  [class]="
                    getStatusClass(contract.signStatus) +
                    ' inline-block px-2.5 py-0.5 rounded-full text-xs font-medium'
                  "
                >
                  {{ getStatusText(contract.signStatus) }}
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-center gap-1.5 flex-wrap">
                  <!-- ปุ่มแก้ไข -->
                  <button
                    (click)="goToEdit(contract.id)"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-all"
                    title="แก้ไข"
                  >
                    <i class="bi bi-pencil"></i>
                  </button>

                  <!-- แทนที่ปุ่มต่อสัญญาเดิม (บรรทัดที่ ~140) -->
                  <button
                    (click)="goToRenew(contract.id)"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/10 transition-all"
                    title="ต่อสัญญา"
                  >
                    <i class="bi bi-arrow-repeat text-sm"></i>
                  </button>
                  <button
                    (click)="deleteContract(contract)"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-all"
                    title="ลบสัญญา"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          } @empty {
            <tr>
              <td colspan="8" class="px-4 py-12 text-center">
                <div class="flex flex-col items-center gap-3">
                  <i class="bi bi-inbox text-5xl text-[var(--text-muted)] opacity-30"></i>
                  <p class="text-lg font-medium text-[var(--text-active)]">ไม่พบข้อมูลสัญญา</p>
                  <p class="text-sm text-[var(--text-muted)]">ปรับคำค้นหาหรือเพิ่มสัญญาใหม่</p>
                  <button
                    (click)="goToAdd()"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
                  >
                    <i class="bi bi-plus-lg"></i>
                    เพิ่มสัญญา
                  </button>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  <!-- PAGINATION -->
  @if (totalItems() > 0) {
    <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
      <div class="text-sm text-[var(--text-muted)]">
        แสดง
        <strong class="text-[var(--text-active)]">{{
          (currentPage() - 1) * pageSize() + 1
        }}</strong>
        -
        <strong class="text-[var(--text-active)]">{{
          Math.min(currentPage() * pageSize(), totalItems())
        }}</strong>
        จาก
        <strong class="text-[var(--text-active)]">{{ totalItems() }}</strong>
        รายการ
      </div>

      <div class="flex gap-1">
        <button
          (click)="onPageChange(currentPage() - 1)"
          [disabled]="!hasPrevious()"
          class="min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] hover:border-[var(--crm-primary)] disabled:opacity-30 disabled:cursor-not-allowed transition-all"
        >
          <i class="bi bi-chevron-left"></i>
        </button>

        @for (page of pageNumbers(); track page) {
          <button
            (click)="onPageChange(page)"
            [class]="
              page === currentPage()
                ? 'min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg bg-[var(--crm-primary)] text-white font-medium transition-all'
                : 'min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] hover:border-[var(--crm-primary)] transition-all'
            "
          >
            {{ page }}
          </button>
        }

        <button
          (click)="onPageChange(currentPage() + 1)"
          [disabled]="!hasNext()"
          class="min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] hover:border-[var(--crm-primary)] disabled:opacity-30 disabled:cursor-not-allowed transition-all"
        >
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
    </div>
  }
</div>
</file>

