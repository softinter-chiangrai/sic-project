            <p class="text-2xl font-bold text-[var(--text-active)] mt-1">{{ stat.value }}</p>
          </div>
          <div
            class="w-10 h-10 rounded-xl flex items-center justify-center"
            [style.background]="stat.color + '20'"
          >
            <i class="bi text-lg" [class]="stat.icon" [style.color]="stat.color"></i>
          </div>
        </div>
      </div>
    }
  </div>

  <!-- ===== THREE COLUMN LAYOUT ===== -->
