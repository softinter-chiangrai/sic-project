    <div>
      <h1 class="text-2xl font-semibold text-[var(--text-active)] flex items-center gap-2">
        <i class="bi bi-layers text-[var(--crm-primary)]"></i>
        Phases & Milestones
      </h1>
      <sic-text color="muted">จัดการระยะและเหตุการณ์สำคัญของโครงการ</sic-text>
    </div>
    <sic-button color="primary" (click)="openCreatePhase()">
      <i class="bi bi-plus-lg"></i> เพิ่ม Phase
    </sic-button>
  </sic-flex>

  <!-- ✅ ใช้ phasesQuery.isPending() และ phasesQuery.error() โดยตรง -->
