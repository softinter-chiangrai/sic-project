              <p class="text-sm font-medium text-[var(--text-active)]">{{ originalContract.projectId || '-' }}</p>
            </div>
            <div>
              <p class="text-xs text-[var(--text-muted)] uppercase tracking-wider">วันที่เริ่ม</p>
              <p class="text-sm font-medium text-[var(--text-active)]">{{ formatDate(originalContract.startDate) }}</p>
            </div>
            <div>
              <p class="text-xs text-[var(--text-muted)] uppercase tracking-wider">วันที่สิ้นสุด</p>
              <p class="text-sm font-medium text-[var(--text-active)]">{{ formatDate(originalContract.endDate) }}</p>
            </div>
            <div>
              <p class="text-xs text-[var(--text-muted)] uppercase tracking-wider">มูลค่า</p>
              <p class="text-sm font-medium text-[var(--text-active)]">{{ formatCurrency(originalContract.contractValue) }}</p>
            </div>
            <div>
              <p class="text-xs text-[var(--text-muted)] uppercase tracking-wider">สถานะการต่อ</p>
              <p class="text-sm font-medium text-[var(--text-active)]">{{ originalContract.renewalStatus || 'ยังไม่ต่อ' }}</p>
            </div>
          </div>
        </div>

        <div class="border-t border-[var(--border)] my-4"></div>

        <!-- ข้อมูลสัญญาใหม่ -->
        <div class="bg-[var(--sidebar)] rounded-xl border border-[var(--border)] p-5 shadow-sm">
          <div class="text-sm font-semibold text-[var(--text-active)] mb-3 flex items-center gap-2">
            <i class="bi bi-pencil-square text-[var(--crm-primary)]"></i>
            ข้อมูลสัญญาใหม่
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- วันที่เริ่มใหม่ -->
            <div>
              <sic-datepicker
                label="วันที่เริ่ม (ใหม่)"
                formControlName="newStartDate"
                [required]="true"
                placeholder="เลือกวันที่เริ่ม"
                dateFormat="DD/MM/YYYY"
              ></sic-datepicker>
              @if (form.get('newStartDate')?.touched && form.get('newStartDate')?.invalid) {
                <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุวันที่เริ่ม</p>
              }
            </div>

            <!-- วันที่สิ้นสุดใหม่ -->
            <div>
              <sic-datepicker
                label="วันที่สิ้นสุด (ใหม่)"
                formControlName="newEndDate"
                [required]="true"
                placeholder="เลือกวันที่สิ้นสุด"
                dateFormat="DD/MM/YYYY"
              ></sic-datepicker>
              @if (form.get('newEndDate')?.touched && form.get('newEndDate')?.invalid) {
                <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุวันที่สิ้นสุด</p>
              }
              @if (form.hasError('endDateInvalid')) {
                <p class="text-xs text-[var(--crm-danger)] mt-1">
                  วันที่สิ้นสุดต้องมากกว่าวันที่เริ่ม
                </p>
              }
            </div>

            <!-- มูลค่าใหม่ -->
            <div>
              <sic-input
                label="มูลค่าสัญญา (ใหม่)"
                type="text"
                formControlName="newContractValue"
                [required]="true"
                placeholder="0.00"
              ></sic-input>
              @if (form.get('newContractValue')?.touched && form.get('newContractValue')?.invalid) {
                <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุมูลค่า</p>
              }
            </div>

            <!-- สถานะการต่อ -->
            <div>
              <label class="block text-sm font-medium text-[var(--text-active)] mb-1"
                >สถานะการต่อสัญญา</label
              >
              <select
                formControlName="renewalStatus"
                class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20"
              >
                <option value="ต่อแล้ว">ต่อแล้ว</option>
                <option value="รอต่อ">รอต่อ</option>
                <option value="ยังไม่ต่อ">ยังไม่ต่อ</option>
                <option value="ยกเลิก">ยกเลิก</option>
              </select>
            </div>
          </div>

          <!-- หมายเหตุ -->
          <div class="mt-4">
            <sic-input-area
              label="หมายเหตุการต่อสัญญา"
              formControlName="renewalRemark"
              [rows]="2"
              placeholder="ระบุเหตุผลหรือรายละเอียดเพิ่มเติม (ถ้ามี)"
            ></sic-input-area>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex gap-4 pt-2">
          <div class="flex-1">
            <sic-button [fullWidth]="true" [type]="'button'" variant="secondary" (click)="onBack()">
              <i class="bi bi-arrow-left"></i>
              ย้อนกลับ
            </sic-button>
          </div>
          <div class="flex-[2]">
            <sic-button
              [fullWidth]="true"
              [type]="'submit'"
              variant="primary"
              [disabled]="isSaving || form.invalid"
            >
              @if (isSaving) {
                <i class="bi bi-arrow-repeat animate-spin"></i>
                กำลังบันทึก...
              } @else {
                <i class="bi bi-check-lg"></i>
                ยืนยันการต่อสัญญา
              }
            </sic-button>
          </div>
        </div>
      </div>
    </form>
  </div>
}
</file>

<file path="sic-app/src/app/feature/pm/rt/pmrt04/pmrt04.component.html">
<!-- src/app/feature/pm/rt/pmrt04/pmrt04.component.html -->

<div class="space-y-5 p-0.5">
  <!-- HEADER -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-semibold text-[var(--text-active)] flex items-center gap-2">
        <i class="bi bi-file-earmark-text text-[var(--crm-primary)]"></i>
        @if (filterCustomerName()) {
          สัญญาของ: {{ filterCustomerName() }}
        } @else {
          รายการสัญญา
        }
      </h1>
      <span
        class="text-sm text-[var(--text-muted)] bg-[var(--bg)] px-3 py-0.5 rounded-full border border-[var(--border)]"
      >
        {{ totalItems() }} รายการ
      </span>
    </div>

    <div class="flex gap-2">
      @if (filterCustomerId()) {
        <button
          (click)="goBackToCustomer()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] transition-all"
        >
          <i class="bi bi-arrow-left"></i>
          กลับ
        </button>
      }
      <button
        (click)="goToAdd()"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all hover:shadow-md"
      >
        <i class="bi bi-plus-lg"></i>
        เพิ่มสัญญา
      </button>
    </div>
  </div>

  <!-- FILTERS -->
  <div class="flex flex-wrap gap-3 items-center">
    <div class="relative flex-1 min-w-[200px]">
      <i
        class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] text-sm"
      ></i>
      <input
        type="text"
        class="w-full pl-9 pr-9 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] transition-all"
        placeholder="ค้นหาเลขสัญญา, ลูกค้า, ประเภท..."
        [value]="searchTerm()"
        (input)="onSearch($event)"
      />
      @if (searchTerm()) {
        <button
          (click)="clearSearch()"
          class="absolute right-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] hover:text-[var(--text-active)] transition-colors"
        >
          <i class="bi bi-x-lg text-xs"></i>
        </button>
      }
    </div>

    <select
      (change)="onFilterChange($event)"
      [value]="filterStatus()"
      class="px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] appearance-none pr-8 cursor-pointer transition-all"
    >
      <option value="all">📊 ทุกสถานะ</option>
      @for (status of statusOptions; track status) {
        <option [value]="status">{{ getStatusText(status) }}</option>
      }
    </select>

    <select
      (change)="onTypeChange($event)"
      [value]="filterType()"
      class="px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] appearance-none pr-8 cursor-pointer transition-all"
    >
      <option value="all">📋 ทุกประเภท</option>
      @for (type of contractTypes(); track type) {
        <option [value]="type">{{ type }}</option>
      }
    </select>
  </div>

  <!-- LOADING -->
  @if (isLoading()) {
    <div class="flex flex-col items-center justify-center py-12 gap-3">
      <div
        class="w-10 h-10 border-4 border-[var(--border)] border-t-[var(--crm-primary)] rounded-full animate-spin"
      ></div>
      <p class="text-sm text-[var(--text-muted)]">กำลังโหลดข้อมูล...</p>
    </div>
  }

  <!-- TABLE -->
  @if (!isLoading()) {
    <div
      class="overflow-x-auto rounded-xl border border-[var(--border)] bg-[var(--sidebar)] shadow-sm"
    >
      <table class="w-full text-sm">
        <thead class="bg-[var(--bg)] border-b border-[var(--border)]">
          <tr>
            <th
              (click)="onSortChange('contractNo')"
