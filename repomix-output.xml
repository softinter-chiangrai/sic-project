                วิเคราะห์ใหม่
              </button>
            </div>
          </div>

          @if (showImpactSection() && impactData(); as impact) {
            <div class="mt-3 space-y-3">
              <!-- สรุปผลกระทบ -->
              <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2">
