  apiGetLovTicketType = '/api/ma-ticket/lov-type';
  apiGetLovSeverity = '/api/ma-ticket/lov-severity';
  apiGetLovStatus = '/api/ma-ticket/lov-status';

  save(data: MATicketModel): Observable<string> {
