    priority: 'Urgent',
    foundBy: 'สมศักดิ์ รุ่งเรือง',
    assignedTo: 'สมชาย ใจดี',
    relatedTestCase: 'TC-CUS-002',
    relatedTestCaseName: 'กรอก Tax ID ซ้ำ',
    relatedTask: 'TASK-002',
