      <div>
        <h1 class="text-xl font-bold text-[var(--text-active)]">
          {{ isEdit ? 'แก้ไข Requirement' : 'สร้าง Requirement ใหม่' }}
        </h1>
        @if (isEdit) {
          <p class="text-xs text-[var(--text-muted)]">
            รหัส: {{ form.value.requirementCode }} · เวอร์ชัน: {{ form.value.version }}
          </p>
        }
      </div>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <!-- Auto-save status -->
      <span class="auto-save-indicator" [class.saving]="getAutoSaveStatus() === 'saving'" [class.saved]="getAutoSaveStatus() === 'saved'">
        {{ getAutoSaveText() }}
      </span>

      <!-- View Mode Toggle -->
      <div class="view-mode-toggle">
        <button (click)="setViewMode('edit')" [class.active]="viewMode === 'edit'" title="โหมดแก้ไข">
          <i class="bi bi-pencil"></i>
        </button>
        <button (click)="setViewMode('split')" [class.active]="viewMode === 'split'" title="แยกหน้าจอ">
          <i class="bi bi-layout-split"></i>
        </button>
        <button (click)="setViewMode('preview')" [class.active]="viewMode === 'preview'" title="โหมดดูตัวอย่าง">
          <i class="bi bi-eye"></i>
        </button>
      </div>

      <!-- Export Buttons -->
      <div class="flex gap-1">
        <button
          (click)="exportRequirement('pdf')"
          [disabled]="isSaving || form.invalid"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-red-500 hover:bg-red-600 disabled:opacity-50 transition-all"
          title="ส่งออก PDF"
        >
          <i class="bi bi-filetype-pdf"></i>
          PDF
        </button>
        <button
          (click)="exportRequirement('docx')"
          [disabled]="isSaving || form.invalid"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-blue-500 hover:bg-blue-600 disabled:opacity-50 transition-all"
          title="ส่งออก Word"
        >
          <i class="bi bi-file-word"></i>
          DOCX
        </button>
      </div>
    </div>
  </div>

  <!-- ===== LOADING ===== -->
  @if (isLoading) {
    <div class="flex flex-col items-center justify-center py-12 gap-3">
      <div class="w-10 h-10 border-4 border-[var(--border)] border-t-[var(--crm-primary)] rounded-full animate-spin"></div>
      <p class="text-sm text-[var(--text-muted)]">กำลังโหลดข้อมูล...</p>
    </div>
  }

  <!-- ===== MAIN LAYOUT ===== -->
  @if (!isLoading) {
    <div class="pmdt05-layout" [class.pmdt05-layout--split]="viewMode === 'split'" [class.pmdt05-layout--edit-only]="viewMode === 'edit'" [class.pmdt05-layout--preview-only]="viewMode === 'preview'">
      <!-- ===== EDIT PANEL ===== -->
      @if (viewMode !== 'preview') {
        <div class="pmdt05-panel pmdt05-panel--edit">
          <form [formGroup]="form" (ngSubmit)="submit()" class="space-y-4">
            <!-- Basic Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <sic-input
                label="รหัส Requirement"
                formControlName="requirementCode"
                [required]="true"
                placeholder="REQ-001"
              ></sic-input>
              <sic-input
                label="ชื่อ Requirement"
                formControlName="title"
                [required]="true"
                placeholder="ระบบ Login"
              ></sic-input>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <sic-combobox
                label="ประเภท Requirement"
                formControlName="requirementType"
                [apiUrl]="service.apiGetLovRequirementType"
                [required]="true"
              ></sic-combobox>
              <sic-combobox
                label="ลำดับความสำคัญ"
                formControlName="priority"
                [apiUrl]="service.apiGetLovPriority"
                [required]="true"
              ></sic-combobox>
              <sic-combobox
                label="สถานะ"
                formControlName="status"
                [apiUrl]="service.apiGetLovStatus"
              ></sic-combobox>
            </div>

            <!-- Description (ใช้ sic-tiptap-editor) -->
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-[var(--text-active)]">
                  รายละเอียด <span class="text-red-500">*</span>
                </span>
                <span class="text-xs text-[var(--text-muted)]">รองรับการจัดรูปแบบข้อความ</span>
              </div>
              <sic-tiptap-editor
                formControlName="description"
                placeholderInput="กรอกรายละเอียด Requirement..."
                minHeightInput="150px"
              ></sic-tiptap-editor>
              @if (form.get('description')?.touched && form.get('description')?.invalid) {
                <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุรายละเอียด</p>
              }
            </div>

            <!-- เอกสารแนบ -->
            <div class="space-y-1">
              <span class="text-sm font-medium text-[var(--text-active)]">เอกสารแนบ</span>
              <sic-upload
                formControlName="uploadGroupData"
                [uploadGroupId]="$safeNavigationMigration(form.get('uploadGroupId')?.value)"
                [multiple]="true"
                category="all"
                [visibility]="1"
                helperText="อัปโหลดรูปภาพ, PDF, Word, Excel เพื่อประกอบ Requirement"
              ></sic-upload>
            </div>

            <!-- Active -->
            <div>
              <label class="flex items-center gap-2 cursor-pointer text-sm">
                <input
                  type="checkbox"
                  formControlName="isActive"
                  class="w-4 h-4 text-[var(--crm-primary)] focus:ring-[var(--crm-primary)]/20 rounded"
                />
                <span class="text-[var(--text-active)]">เปิดใช้งาน Requirement</span>
              </label>
            </div>

            <!-- Approval Flow -->
            <div class="border-t border-[var(--border)] pt-4 mt-2">
              <div class="text-sm font-medium text-[var(--text-active)] mb-2 flex items-center gap-2">
                <i class="bi bi-check2-circle text-[var(--crm-primary)]"></i>
                การอนุมัติ
              </div>
              <div class="grid grid-cols-1 gap-4">
                <sic-combobox
                  label="กระบวนการอนุมัติ"
                  [apiUrl]="service.apiGetApprovals"
                  valueField="id"
                  textField="flowName"
                  placeholder="เลือกกระบวนการอนุมัติ"
                  [clearable]="true"
                  (selectionChanged)="selectedFlowId = $event?.id"
                ></sic-combobox>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-3 pt-2 border-t border-[var(--border)]">
              <sic-button
                [fullWidth]="false"
                type="button"
                variant="secondary"
                (click)="onBack()"
              >
                <i class="bi bi-arrow-left"></i>
                ย้อนกลับ
              </sic-button>
              <sic-button
                [fullWidth]="true"
                type="submit"
                variant="primary"
                [disabled]="isSaving || form.invalid || !selectedFlowId"
              >
                @if (isSaving) {
                  <i class="bi bi-arrow-repeat animate-spin"></i>
                } @else {
                  <i class="bi bi-floppy"></i>
                }
                {{ isSaving ? 'กำลังบันทึก...' : (isEdit ? 'บันทึก' : 'สร้าง') }}
              </sic-button>
            </div>

            <!-- Hidden fields -->
            <input type="hidden" formControlName="id" />
            <input type="hidden" formControlName="state" />
            <input type="hidden" formControlName="rowVersion" />
          </form>
        </div>
      }

      <!-- ===== PREVIEW PANEL ===== -->
      @if (viewMode !== 'edit') {
        <div class="pmdt05-panel pmdt05-panel--preview">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold text-[var(--text-active)] flex items-center gap-2">
              <i class="bi bi-eye text-[var(--crm-primary)]"></i>
              ตัวอย่างเอกสาร
            </h3>
            <span class="text-xs text-[var(--text-muted)]">อัปเดตอัตโนมัติ</span>
          </div>
          <sic-requirement-preview [data]="getPreviewData()"></sic-requirement-preview>
        </div>
      }
    </div>
  }
</div>
</file>

<file path="sic-app/src/app/feature/pm/dt/pmdt07/pmdt07.component.html">
<!-- src/app/feature/pm/dt/pmdt07/pmdt07.component.html -->
<div class="space-y-5 p-0.5">

  <!-- HEADER -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-semibold text-[var(--text-active)] flex items-center gap-2">
        <i class="bi bi-arrow-left-right text-[var(--crm-primary)]"></i>
        Change Request
      </h1>
      <span class="text-sm text-[var(--text-muted)] bg-[var(--bg)] px-3 py-0.5 rounded-full border border-[var(--border)]">
        {{ totalItems() }} รายการ
      </span>
    </div>
    <button
      (click)="goToAdd()"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all hover:shadow-md"
    >
      <i class="bi bi-plus-lg"></i>
      เพิ่ม Change Request
    </button>
  </div>

  <!-- FILTERS -->
  <div class="flex flex-wrap gap-3 items-center">
    <div class="relative flex-1 min-w-[200px]">
      <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] text-sm"></i>
      <input
        type="text"
        class="w-full pl-9 pr-9 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20 focus:border-[var(--crm-primary)] transition-all"
        placeholder="ค้นหารหัส, ชื่อ, โครงการ..."
        [value]="searchTerm()"
        (input)="onSearch($event)"
      />
      @if (searchTerm()) {
        <button
          (click)="clearSearch()"
          class="absolute right-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] hover:text-[var(--text-active)] transition-colors"
        >
          <i class="bi bi-x-lg text-xs"></i>
        </button>
      }
    </div>

    <select
      (change)="onFilterChange($event)"
      [value]="filterStatus()"
      class="px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20 appearance-none pr-8 cursor-pointer transition-all"
    >
      <option value="all">📊 ทุกสถานะ</option>
      <option value="Draft">ร่าง</option>
      <option value="Submitted">รออนุมัติ</option>
      <option value="Approved">อนุมัติ</option>
      <option value="Rejected">ปฏิเสธ</option>
      <option value="Implemented">ดำเนินการแล้ว</option>
    </select>
  </div>

  <!-- LOADING -->
  @if (isLoading()) {
    <div class="flex flex-col items-center justify-center py-12 gap-3">
      <div class="w-10 h-10 border-4 border-[var(--border)] border-t-[var(--crm-primary)] rounded-full animate-spin"></div>
      <p class="text-sm text-[var(--text-muted)]">กำลังโหลดข้อมูล...</p>
    </div>
  }

  <!-- TABLE -->
  @if (!isLoading()) {
    <div class="overflow-x-auto rounded-xl border border-[var(--border)] bg-[var(--sidebar)] shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-[var(--bg)] border-b border-[var(--border)]">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[100px]">
              รหัส
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[150px]">
              ชื่อคำขอ
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[120px]">
              โครงการ
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[150px]">
              ผู้เกี่ยวข้อง / ผู้แก้ไข
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[100px]">
              สถานะ
            </th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[250px]">
              จัดการ
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--border)]">
          @for (cr of changeRequests(); track cr.id) {
            <tr class="hover:bg-[var(--sidebar-hover)] transition-colors">
              <td class="px-4 py-3">
                <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold font-mono tracking-wide text-[var(--crm-primary)] bg-[var(--crm-primary)]/10">
                  CR-{{ cr.id.substring(0, 8).toUpperCase() }}
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="font-medium text-[var(--text-active)]">{{ cr.title }}</div>
                <div class="text-xs text-[var(--text-muted)] truncate max-w-[200px]">{{ cr.description }}</div>
              </td>
              <td class="px-4 py-3">{{ cr.projectName || '-' }}</td>
              <td class="px-4 py-3">
                <div class="space-y-1">
                  @for (assignee of cr.assignees; track assignee.id) {
                    <div class="flex items-center gap-1.5 text-xs">
                      <span class="w-1.5 h-1.5 rounded-full" [ngClass]="assignee.status === 'COMPLETED' ? 'bg-emerald-500' : 'bg-amber-500'"></span>
                      <span class="font-medium">{{ assignee.userName }}</span>
                      <span class="text-[10px] text-[var(--text-muted)]">({{ assignee.targetType }})</span>
                      @if (assignee.status !== 'COMPLETED' && cr.status === 'APPROVED') {
                        <button
                          (click)="completeAssigneeTask(cr.id, assignee.userId, assignee.targetId)"
                          class="px-1.5 py-0.5 rounded bg-[var(--crm-primary)]/10 text-[var(--crm-primary)] text-[10px] hover:bg-[var(--crm-primary)]/20 transition-all ml-1"
                        >
                          แก้ไขเสร็จแล้ว
                        </button>
                      }
                    </div>
                  } @empty {
                    <span class="text-xs text-[var(--text-muted)]">-</span>
                  }
                </div>
              </td>
              <td class="px-4 py-3">
                <span [class]="getStatusClass(cr.status) + ' inline-block px-2.5 py-0.5 rounded-full text-xs font-medium'">
                  {{ getStatusText(cr.status) }}
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <div class="flex items-center justify-center gap-1 flex-wrap">
                  <!-- Submit (Draft Only) -->
                  @if (cr.status === 'DRAFT') {
                    <button
                      (click)="submitRequest(cr.id)"
                      class="px-2 py-1 rounded text-xs font-medium text-white bg-blue-500 hover:bg-blue-600 transition-all"
                      title="ส่งขออนุมัติ"
                    >
                      ส่งขออนุมัติ
                    </button>
                  }
                  <!-- Approve / Reject (Submitted Only) -->
                  @if (cr.status === 'SUBMITTED') {
                    <button
                      (click)="approveRequest(cr.id)"
                      class="px-2 py-1 rounded text-xs font-medium text-white bg-emerald-500 hover:bg-emerald-600 transition-all"
                      title="อนุมัติ"
                    >
                      อนุมัติ
                    </button>
                    <button
                      (click)="rejectRequest(cr.id)"
                      class="px-2 py-1 rounded text-xs font-medium text-white bg-red-500 hover:bg-red-600 transition-all"
                      title="ปฏิเสธ"
                    >
                      ปฏิเสธ
                    </button>
                  }
                  <!-- Implement / Close CR (Approved Only) -->
                  @if (cr.status === 'APPROVED') {
                    <button
                      (click)="implementRequest(cr.id)"
                      class="px-2 py-1 rounded text-xs font-medium text-white bg-purple-500 hover:bg-purple-600 transition-all"
                      title="ปิด Change Request"
                    >
                      ปิด CR
                    </button>
                  }
                  <button
                    (click)="goToEdit(cr.id)"
                    [disabled]="cr.status !== 'DRAFT' && cr.status !== 'SUBMITTED'"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-all disabled:opacity-30 disabled:cursor-not-allowed"
                    title="แก้ไขรายละเอียด"
                  >
                    <i class="bi bi-pencil"></i>
                  </button>
                  <button
                    (click)="goToImpact(cr.id)"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-500/10 transition-all"
                    title="Impact Analysis"
                  >
                    <i class="bi bi-diagram-3"></i>
                  </button>
                  <button
                    (click)="deleteChangeRequest(cr.id)"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-all"
                    title="ลบ"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          } @empty {
            <tr>
              <td colspan="6" class="px-4 py-12 text-center">
                <div class="flex flex-col items-center gap-3">
                  <i class="bi bi-inbox text-5xl text-[var(--text-muted)] opacity-30"></i>
                  <p class="text-lg font-medium text-[var(--text-active)]">ไม่พบ Change Request</p>
                  <p class="text-sm text-[var(--text-muted)]">ปรับคำค้นหาหรือเพิ่ม Change Request ใหม่</p>
                  <button
                    (click)="goToAdd()"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
                  >
                    <i class="bi bi-plus-lg"></i>
                    เพิ่ม Change Request
                  </button>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  <!-- PAGINATION -->
  @if (totalItems() > 0) {
    <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
      <div class="text-sm text-[var(--text-muted)]">
        แสดง
        <strong class="text-[var(--text-active)]">{{ (currentPage() - 1) * pageSize() + 1 }}</strong>
        -
        <strong class="text-[var(--text-active)]">{{ Math.min(currentPage() * pageSize(), totalItems()) }}</strong>
        จาก
        <strong class="text-[var(--text-active)]">{{ totalItems() }}</strong>
        รายการ
      </div>

      <div class="flex gap-1">
        <button
          (click)="onPageChange(currentPage() - 1)"
          [disabled]="!hasPrevious()"
          class="min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] hover:border-[var(--crm-primary)] disabled:opacity-30 disabled:cursor-not-allowed transition-all"
        >
          <i class="bi bi-chevron-left"></i>
        </button>

        @for (page of pageNumbers(); track page) {
          <button
            (click)="onPageChange(page)"
            [class]="page === currentPage() 
              ? 'min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg bg-[var(--crm-primary)] text-white font-medium transition-all' 
              : 'min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] hover:border-[var(--crm-primary)] transition-all'"
          >
            {{ page }}
          </button>
        }

        <button
          (click)="onPageChange(currentPage() + 1)"
          [disabled]="!hasNext()"
          class="min-w-[2.25rem] h-9 flex items-center justify-center rounded-lg border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] hover:border-[var(--crm-primary)] disabled:opacity-30 disabled:cursor-not-allowed transition-all"
        >
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
    </div>
  }

</div>
</file>

<file path="sic-app/src/app/feature/pm/dt/pmdt08/pmdt08A/pmdt08A.component.html">
<!-- src/app/feature/pm/dt/pmdt08A/pmdt08A.component.html -->

@if (formData) {
    <div class="space-y-4 p-0.5">
        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <button
                    (click)="onBack()"
                    class="w-9 h-9 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/10 transition-all"
                    title="กลับ"
                >
                    <i class="bi bi-arrow-left text-xl"></i>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-[var(--text-active)]">
                        {{ isEdit ? 'แก้ไข Specification' : 'สร้าง Specification ใหม่' }}
                    </h1>
                    @if (isEdit) {
                        <p class="text-sm text-[var(--text-muted)]">
                            รหัส: {{ formData.value.specificationCode }} · เวอร์ชัน: {{ formData.value.version }}
                        </p>
                    }
                </div>
            </div>
            <div class="flex gap-2">
                <!-- AI Generator Button -->
                @if (!isEdit || formData.value.isAiGenerated) {
                    <button
                        (click)="generateDraft()"
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 transition-all"
                        [disabled]="isGenerating()"
                    >
                        @if (isGenerating()) {
                            <i class="bi bi-arrow-repeat animate-spin"></i> กำลังสร้าง...
                        } @else {
                            <i class="bi bi-magic"></i> Generate with AI
                        }
                    </button>
                }
                <button
                    (click)="submit()"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
                    [disabled]="isSaving"
                >
                    @if (isSaving) {
                        <i class="bi bi-arrow-repeat animate-spin"></i>
                    } @else {
                        <i class="bi bi-floppy"></i>
                    }
                    {{ isSaving ? 'กำลังบันทึก...' : 'บันทึก' }}
