<file path="sic-app/src/app/feature/pm/dt/pmdt02/pmdt02.component.html">
<!-- src/app/feature/pm/dt/pmdt02/pmdt02.component.html -->
<div class="space-y-5 p-4">

  <!-- ===== BACK BUTTON ===== -->
  <div class="flex items-center gap-3 flex-wrap">
    <button (click)="goBack()"
      class="w-9 h-9 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/10 transition-all"
      title="ย้อนกลับ">
      <i class="bi bi-arrow-left text-xl"></i>
    </button>
  </div>

  <!-- ===== PHASE HEADER ===== -->
  @if (phase(); as p) {
    <div class="flex flex-wrap items-center justify-between gap-4 bg-[var(--sidebar)] rounded-xl border border-[var(--border)] p-5">
      <div>
        <h1 class="text-2xl font-bold text-[var(--text-active)] flex items-center gap-3">
          {{ p.phaseName }}
          <span [class]="getStatusClass(p.status) + ' px-2.5 py-0.5 rounded-full text-xs font-medium'">
            {{ getStatusText(p.status) }}
          </span>
        </h1>
        <p class="text-sm text-[var(--text-muted)] mt-1">{{ p.description || 'ไม่มีคำอธิบาย' }}</p>
        <div class="flex items-center gap-4 text-xs text-[var(--text-muted)] mt-2">
          <span><i class="bi bi-calendar3"></i> {{ formatDate(p.startDate) }} - {{ formatDate(p.endDate) }}</span>
          <span><i class="bi bi-person"></i> {{ p.owner || '-' }}</span>
        </div>
      </div>
      <div class="flex flex-col items-end gap-2">
        <div class="flex items-center gap-3">
          <span class="text-sm font-medium text-[var(--text-active)]">{{ p.progress }}%</span>
          <span class="text-xs text-[var(--text-muted)]">{{ p.taskCompletedCount }}/{{ p.taskCount }} Tasks</span>
        </div>
        <div class="w-48 h-2 bg-[var(--bg)] rounded-full overflow-hidden">
          <div class="h-full bg-[var(--crm-primary)] rounded-full transition-all" [style.width.%]="p.progress"></div>
        </div>
      </div>
    </div>
  }

  <!-- ===== LOADING ===== -->
  @if (isLoading()) {
    <div class="flex justify-center py-12">
      <div class="w-10 h-10 border-4 border-[var(--border)] border-t-[var(--crm-primary)] rounded-full animate-spin"></div>
    </div>
  }

  @if (!isLoading() && phase(); as p) {

    <!-- ===== TAB SWITCHER ===== -->
    <div class="flex gap-1 border-b border-[var(--border)]">
      <button
        (click)="switchTab('list')"
        class="px-4 py-2 text-sm font-medium transition-colors border-b-2"
        [class]="rightTab() === 'list' ? 'border-[var(--crm-primary)] text-[var(--crm-primary)]' : 'border-transparent text-[var(--text-muted)] hover:text-[var(--text-active)]'">
        <i class="bi bi-list-task mr-1"></i> รายการ
      </button>
      <button
        (click)="switchTab('calendar')"
        class="px-4 py-2 text-sm font-medium transition-colors border-b-2"
        [class]="rightTab() === 'calendar' ? 'border-[var(--crm-primary)] text-[var(--crm-primary)]' : 'border-transparent text-[var(--text-muted)] hover:text-[var(--text-active)]'">
        <i class="bi bi-calendar3 mr-1"></i> ปฏิทิน
      </button>
      <!-- ปุ่มนำทางไป Gantt เต็มจอ -->
      <button
        (click)="goToGanttFullscreen()"
        class="px-4 py-2 text-sm font-medium transition-colors border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text-active)]">
        <i class="bi bi-bar-chart mr-1"></i> Gantt
      </button>
    </div>

    <!-- ===== TAB 1: LIST ===== -->
    @if (rightTab() === 'list') {
      <div class="bg-[var(--sidebar)] rounded-xl border border-[var(--border)] overflow-hidden flex flex-col max-h-[600px]">
        <div class="flex items-center justify-between px-5 py-3 border-b border-[var(--border)] bg-[var(--bg)]/50 flex-shrink-0">
          <h2 class="text-sm font-semibold text-[var(--text-active)] flex items-center gap-2">
            <i class="bi bi-flag text-[var(--crm-primary)]"></i>
            Milestones & Work Packages
            <span class="text-xs text-[var(--text-muted)] font-normal">({{ p.milestones?.length || 0 }} Milestones, {{ getTotalWorkPackages(p) }} Work Packages)</span>
          </h2>
          <button (click)="openCreateMilestone()" class="text-sm text-[var(--crm-primary)] hover:underline flex items-center gap-1">
            <i class="bi bi-plus-lg"></i> เพิ่ม Milestone
          </button>
        </div>
        <div class="flex-1 overflow-y-auto px-3 py-2 space-y-1">
          @for (ms of p.milestones || []; track ms.id) {
            <div class="rounded-lg border border-[var(--border)] bg-[var(--bg)] overflow-hidden">
              <!-- Milestone header -->
              <div class="flex items-center justify-between px-3 py-2 cursor-pointer hover:bg-[var(--sidebar-hover)] transition-colors" (click)="toggleMilestone(ms.id)">
                <div class="flex items-center gap-2 min-w-0">
                  <i class="bi bi-chevron-right text-xs text-[var(--text-muted)] transition-transform" [class.rotate-90]="expandedMilestone() === ms.id"></i>
                  <span class="text-sm font-medium text-[var(--text-active)] truncate">{{ ms.milestoneName }}</span>
                  <span [class]="getStatusClass(ms.status) + ' inline-block px-1.5 py-0.5 rounded-full text-[0.6rem] font-medium flex-shrink-0'">
                    {{ getStatusText(ms.status) }}
                  </span>
                  <span class="text-xs text-[var(--text-muted)]">({{ ms.workPackages?.length || 0 }} WPs)</span>
                </div>
                <div class="flex items-center gap-1 flex-shrink-0">
                  <span class="text-xs text-[var(--text-muted)]">{{ formatDate(ms.dueDate) }}</span>
                  <button (click)="editMilestone(ms, $event)" class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-primary)] p-1 rounded">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <button (click)="deleteMilestone(ms, $event)" class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-danger)] p-1 rounded">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>
              <!-- Work packages under milestone -->
              @if (expandedMilestone() === ms.id) {
                <div class="border-t border-[var(--border)] px-3 py-2 space-y-1 bg-[var(--bg)]/30">
                  @for (wp of ms.workPackages || []; track wp.id) {
                    <div class="rounded-lg border border-[var(--border)] bg-[var(--bg)] overflow-hidden">
                      <!-- Work Package header -->
                      <div class="flex items-center justify-between px-3 py-2 cursor-pointer hover:bg-[var(--sidebar-hover)] transition-colors" (click)="toggleWorkPackage(wp.id)">
                        <div class="flex items-center gap-2 min-w-0">
                          <i class="bi bi-chevron-right text-xs text-[var(--text-muted)] transition-transform" [class.rotate-90]="expandedWorkPackage() === wp.id"></i>
                          <span class="text-sm font-medium text-[var(--text-active)] truncate">📦 {{ wp.packageName }}</span>
                          <span class="text-xs text-[var(--text-muted)] flex-shrink-0">({{ wp.tasks?.length || 0 }} งาน)</span>
                        </div>
                        <div class="flex items-center gap-1 flex-shrink-0">
                          <span class="text-xs text-[var(--text-muted)]">{{ formatDate(wp.startDate) }}</span>
                          <button (click)="editWorkPackage(wp, ms.id, $event)" class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-primary)] p-1 rounded">
                            <i class="bi bi-pencil"></i>
                          </button>
                          <button (click)="deleteWorkPackage(wp, $event)" class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-danger)] p-1 rounded">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </div>
                      <!-- Tasks under work package -->
                      @if (expandedWorkPackage() === wp.id) {
                        <div class="border-t border-[var(--border)] px-3 py-2 space-y-1 bg-[var(--bg)]/30">
                          @for (task of wp.tasks || []; track task.id) {
                            <div class="flex items-center justify-between pl-4 py-1 rounded hover:bg-[var(--sidebar-hover)] transition-colors">
                              <div class="flex items-center gap-2 min-w-0">
                                <i class="bi bi-circle text-[0.55rem] text-[var(--text-muted)]"></i>
                                <span class="text-sm text-[var(--text)] truncate">{{ task.taskName }}</span>
                                <span class="text-xs text-[var(--text-muted)] flex-shrink-0">({{ task.assignedTo || '-' }})</span>
                                <span [class]="getStatusClass(task.status) + ' inline-block px-1.5 py-0.5 rounded-full text-[0.55rem] font-medium flex-shrink-0'">
                                  {{ getStatusText(task.status) }}
                                </span>
                              </div>
                              <div class="flex items-center gap-1 flex-shrink-0">
                                <button (click)="editTask(task, wp.id, $event)" class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-primary)] p-1 rounded">
                                  <i class="bi bi-pencil"></i>
                                </button>
                                <button (click)="deleteTask(task, $event)" class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-danger)] p-1 rounded">
                                  <i class="bi bi-trash"></i>
                                </button>
                              </div>
                            </div>
                          }
                          @if ((wp.tasks || []).length === 0) {
                            <p class="text-xs text-[var(--text-muted)] pl-4 py-1">ไม่มี Task</p>
                          }
                          <button (click)="openCreateTask(wp.id)" class="mt-1 text-xs text-[var(--crm-primary)] hover:underline flex items-center gap-1 pl-4">
                            <i class="bi bi-plus-lg"></i> เพิ่ม Task
                          </button>
                        </div>
                      }
                    </div>
                  }
                  @if ((ms.workPackages || []).length === 0) {
                    <p class="text-xs text-[var(--text-muted)] pl-4 py-1">ไม่มี Work Package</p>
                  }
                  <button (click)="openCreateWorkPackage(ms.id)" class="mt-1 text-xs text-[var(--crm-primary)] hover:underline flex items-center gap-1 pl-4">
                    <i class="bi bi-plus-lg"></i> เพิ่ม Work Package
                  </button>
                </div>
              }
            </div>
          }
          @if ((p.milestones || []).length === 0) {
            <div class="text-center py-8 text-[var(--text-muted)]">
              <i class="bi bi-inbox text-3xl block mb-2 opacity-30"></i>
              <p class="text-sm">ยังไม่มี Milestone</p>
            </div>
          }
        </div>
      </div>
    }

    <!-- ===== TAB 2: CALENDAR ===== -->
    @if (rightTab() === 'calendar') {
      <div class="bg-[var(--sidebar)] rounded-xl border border-[var(--border)] overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3 border-b border-[var(--border)] bg-[var(--bg)]/50">
          <h2 class="text-sm font-semibold text-[var(--text-active)] flex items-center gap-2">
            <i class="bi bi-calendar3 text-[var(--crm-primary)]"></i>
            ปฏิทินงาน
          </h2>
          <span class="text-xs text-[var(--text-muted)]">คลิกรายการเพื่อแก้ไข</span>
        </div>
        <div class="p-4">
          <sic-calendar
            [items]="calendarItems()"
            [mode]="'view'"
            [disabled]="false"
            [label]="'ปฏิทิน Phase'"
            [hint]="'คลิกรายการเพื่อไปแก้ไข'"
            (itemClick)="onCalendarItemClick($event)">
          </sic-calendar>
        </div>
      </div>
    }

    <!-- ===== (ลบส่วน Gantt Tab ออกแล้ว) ===== -->

  }
</div>
