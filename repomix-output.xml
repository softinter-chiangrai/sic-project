<file path="sic-app/src/app/feature/pm/dt/pmdt14/pmdt14.component.html">
<div class="space-y-5 p-0.5">

  <!-- ===== HEADER ===== -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-semibold text-[var(--text-active)] flex items-center gap-2">
        <i class="bi bi-chat-dots text-[var(--crm-primary)]"></i>
        Discussion Feed
      </h1>
      <span class="text-sm text-[var(--text-muted)] bg-[var(--bg)] px-3 py-0.5 rounded-full border border-[var(--border)]">
        {{ posts().length }} โพสต์
      </span>
    </div>
    <button
      (click)="onBack()"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium border border-[var(--border)] bg-transparent text-[var(--text)] hover:bg-[var(--sidebar-hover)] transition-all"
    >
      <i class="bi bi-arrow-left"></i>
      กลับ
    </button>
  </div>

  <!-- ===== LOADING ===== -->
  @if (isLoading()) {
    <div class="flex flex-col items-center justify-center py-12 gap-3">
      <div class="w-10 h-10 border-4 border-[var(--border)] border-t-[var(--crm-primary)] rounded-full animate-spin"></div>
      <p class="text-sm text-[var(--text-muted)]">กำลังโหลดข้อความ...</p>
    </div>
  }

  <!-- ===== CREATE POST ===== -->
  @if (!isLoading()) {
    <div class="bg-[var(--bg)] rounded-xl border border-[var(--border)] p-4">
      <form [formGroup]="postForm" (ngSubmit)="submitPost()">
        <sic-input-area
          label="โพสต์ข้อความ"
          formControlName="content"
          [rows]="2"
          placeholder="พูดคุยเกี่ยวกับงาน..."
          [required]="true"
        ></sic-input-area>
        @if (postForm.get('content')?.touched && postForm.get('content')?.invalid) {
          <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาใส่ข้อความ</p>
        }
        <div class="flex items-center gap-3 mt-3">
          <button
            type="button"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm border border-[var(--border)] hover:bg-[var(--sidebar-hover)] transition-all"
          >
            <i class="bi bi-paperclip"></i>
            แนบไฟล์
          </button>
          <span class="text-xs text-[var(--text-muted)]">(PDF, DOC, JPG, PNG)</span>
          <sic-button
            [fullWidth]="false"
            [type]="'submit'"
            variant="primary"
            class="ml-auto"
          >
            <i class="bi bi-send"></i>
            โพสต์
          </sic-button>
        </div>
      </form>
    </div>
  }

  <!-- ===== POSTS ===== -->
  <div class="space-y-4">
    @for (post of posts(); track post.id) {
      <div class="bg-[var(--sidebar)] rounded-xl border border-[var(--border)] p-4 shadow-sm">
        <!-- Post Header -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[var(--crm-primary)]/10 flex items-center justify-center flex-shrink-0">
            <span class="text-sm font-semibold text-[var(--crm-primary)]">
              {{ post.author.charAt(0) }}
            </span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-medium text-[var(--text-active)]">{{ post.author }}</p>
            <p class="text-xs text-[var(--text-muted)]">{{ formatDate(post.createdAt) }}</p>
          </div>
          @if (post.attachments && post.attachments.length > 0) {
            <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-[var(--bg)] text-xs text-[var(--text-muted)]">
              <i class="bi bi-paperclip"></i>
              {{ post.attachments.length }}
            </span>
          }
          <!-- ✅ ปุ่มแก้ไข/ลบ (เฉพาะเจ้าของ) -->
          @if (isAuthor(post.author)) {
            <div class="flex gap-1">
              <button
                (click)="startEditPost(post.id)"
                class="w-7 h-7 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-all"
                title="แก้ไข"
              >
                <i class="bi bi-pencil text-sm"></i>
              </button>
              <button
                (click)="deletePost(post.id)"
                class="w-7 h-7 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-all"
                title="ลบ"
              >
                <i class="bi bi-trash text-sm"></i>
              </button>
            </div>
          }
        </div>

        <!-- Post Content / Edit Form -->
        @if (editingPost() === post.id) {
          <div class="mt-3">
            <form [formGroup]="editForm" (ngSubmit)="submitEditPost(post.id)">
              <sic-input-area
                formControlName="editContent"
                [rows]="2"
                [required]="true"
              ></sic-input-area>
              <div class="flex gap-2 mt-2">
                <button
                  type="button"
                  (click)="cancelEditPost()"
                  class="px-3 py-1.5 rounded-lg text-sm border border-[var(--border)] hover:bg-[var(--sidebar-hover)] transition-all"
                >
                  ยกเลิก
                </button>
                <button
                  type="submit"
                  class="px-4 py-1.5 rounded-lg text-sm text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
                >
                  บันทึก
                </button>
              </div>
            </form>
          </div>
        } @else {
          <div class="mt-3 text-[var(--text)]">
            <p class="whitespace-pre-wrap">{{ post.content }}</p>
          </div>
        }

        <!-- Attachments -->
        @if (post.attachments && post.attachments.length > 0) {
          <div class="mt-2 flex flex-wrap gap-2">
            @for (file of post.attachments; track file) {
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded bg-[var(--bg)] border border-[var(--border)] text-xs text-[var(--text-muted)]">
                <i class="bi bi-file-earmark"></i>
                {{ file }}
              </span>
            }
          </div>
        }

        <!-- Actions -->
        <div class="mt-3 flex gap-2">
          <button
            (click)="startReply(post.id)"
            class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-primary)] transition-colors"
          >
            <i class="bi bi-reply"></i>
            ตอบกลับ
          </button>
          <span class="text-xs text-[var(--text-muted)]">•</span>
          <span class="text-xs text-[var(--text-muted)]">{{ post.replies.length }} ตอบกลับ</span>
        </div>

        <!-- Reply Form -->
        @if (replyingTo() === post.id) {
          <div class="mt-3 pl-8">
            <form [formGroup]="replyForm" (ngSubmit)="submitReply(post.id)">
              <div class="flex gap-3">
                <div class="flex-1">
                  <sic-input-area
                    formControlName="replyContent"
                    [rows]="1"
                    placeholder="พิมพ์ข้อความตอบกลับ..."
                    [required]="true"
                  ></sic-input-area>
                </div>
                <div class="flex gap-2">
                  <button
                    type="button"
                    (click)="cancelReply()"
                    class="px-3 py-2 rounded-lg text-sm border border-[var(--border)] hover:bg-[var(--sidebar-hover)] transition-all"
                  >
                    ยกเลิก
                  </button>
                  <button
                    type="submit"
                    class="px-4 py-2 rounded-lg text-sm text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
                  >
                    ตอบกลับ
                  </button>
                </div>
              </div>
              @if (replyForm.get('replyContent')?.touched && replyForm.get('replyContent')?.invalid) {
                <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาใส่ข้อความ</p>
              }
            </form>
          </div>
        }

        <!-- Replies -->
        @if (post.replies.length > 0) {
          <div class="mt-3 pl-8 space-y-2 border-l-2 border-[var(--border)] pl-4">
            @for (reply of post.replies; track reply.id) {
              <div class="bg-[var(--bg)] rounded-lg p-3">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full bg-[var(--crm-primary)]/10 flex items-center justify-center flex-shrink-0">
                    <span class="text-xs font-semibold text-[var(--crm-primary)]">
                      {{ reply.author.charAt(0) }}
                    </span>
                  </div>
                  <span class="font-medium text-sm text-[var(--text-active)]">{{ reply.author }}</span>
                  <span class="text-xs text-[var(--text-muted)]">{{ formatDate(reply.createdAt) }}</span>
                  <!-- ✅ ปุ่มแก้ไข/ลบ Reply (เฉพาะเจ้าของ) -->
                  @if (isAuthor(reply.author)) {
                    <div class="flex gap-1 ml-auto">
                      <button
                        (click)="startEditReply(post.id, reply.id)"
                        class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-all"
                        title="แก้ไข"
                      >
                        <i class="bi bi-pencil text-xs"></i>
                      </button>
                      <button
                        (click)="deleteReply(post.id, reply.id)"
                        class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-all"
                        title="ลบ"
                      >
                        <i class="bi bi-trash text-xs"></i>
                      </button>
                    </div>
                  }
                </div>

                <!-- Reply Content / Edit Form -->
                @if (editingReply()?.postId === post.id && editingReply()?.replyId === reply.id) {
                  <div class="mt-2">
                    <form [formGroup]="editForm" (ngSubmit)="submitEditReply(post.id, reply.id)">
                      <sic-input-area
                        formControlName="editContent"
                        [rows]="1"
                        [required]="true"
                      ></sic-input-area>
                      <div class="flex gap-2 mt-1">
                        <button
                          type="button"
                          (click)="cancelEditReply()"
                          class="px-2 py-1 rounded text-xs border border-[var(--border)] hover:bg-[var(--sidebar-hover)] transition-all"
                        >
                          ยกเลิก
                        </button>
                        <button
                          type="submit"
                          class="px-3 py-1 rounded text-xs text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
                        >
                          บันทึก
                        </button>
                      </div>
                    </form>
                  </div>
                } @else {
                  <p class="text-sm text-[var(--text)] mt-1">{{ reply.content }}</p>
                }
              </div>
            }
          </div>
        }
      </div>
    } @empty {
      <div class="text-center py-12 text-[var(--text-muted)]">
        <i class="bi bi-chat text-4xl block mb-3 opacity-30"></i>
        <p>ยังไม่มีข้อความ</p>
        <p class="text-sm">เริ่มโพสต์ข้อความแรกของคุณ</p>
      </div>
    }
  </div>

</div>
</file>

