                  </div>
                  <div class="text-xs text-[var(--text-muted)]">Requirement</div>
                </div>
                <div class="bg-[var(--bg)] rounded-lg p-3 border border-[var(--border)] text-center">
                  <div class="text-xl font-bold text-[var(--text-active)]">
                    {{ impact.impactedSpecIds?.length || 0 }}
                  </div>
                  <div class="text-xs text-[var(--text-muted)]">Specification</div>
                </div>
                <div class="bg-[var(--bg)] rounded-lg p-3 border border-[var(--border)] text-center">
                  <div class="text-xl font-bold text-[var(--text-active)]">
                    {{ impact.impactedTaskIds?.length || 0 }}
                  </div>
                  <div class="text-xs text-[var(--text-muted)]">Task</div>
                </div>
                <div class="bg-[var(--bg)] rounded-lg p-3 border border-[var(--border)] text-center">
                  <div class="text-xl font-bold text-[var(--text-active)]">
                    {{ impact.impactedTestCaseIds?.length || 0 }}
                  </div>
                  <div class="text-xs text-[var(--text-muted)]">Test Case</div>
                </div>
                <div class="bg-[var(--bg)] rounded-lg p-3 border border-[var(--border)] text-center">
                  <div class="text-xl font-bold text-[var(--text-active)]">
                    {{ impact.impactedBugIds?.length || 0 }}
                  </div>
                  <div class="text-xs text-[var(--text-muted)]">Bug</div>
                </div>
              </div>

              <!-- รายละเอียดเพิ่มเติม -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                <div class="bg-[var(--bg)] rounded-lg p-3 border border-[var(--border)]">
                  <span class="font-medium text-[var(--text-active)]">สถานะ:</span>
                  <span [class]="getImpactStatusClass(impact.analysisStatus) + ' ml-2 px-2 py-0.5 rounded-full text-xs'">
                    {{ getImpactStatusText(impact.analysisStatus) }}
                  </span>
                  @if (impact.analyzedAt) {
                    <span class="text-[var(--text-muted)] ml-2 text-xs">
                      {{ impact.analyzedAt | date:'dd/MM/yyyy HH:mm' }}
                    </span>
                  }
                </div>
                <div class="bg-[var(--bg)] rounded-lg p-3 border border-[var(--border)]">
                  <span class="font-medium text-[var(--text-active)]">Manday เพิ่ม:</span>
                  <span class="text-[var(--text-active)] ml-2">{{ impact.mandayImpact || 0 }} วัน</span>
                  @if (impact.timelineImpact) {
                    <span class="text-[var(--text-muted)] ml-4">
                      Timeline เลื่อน: {{ impact.timelineImpact }} วัน
                    </span>
                  }
                </div>
                @if (impact.dfdImpact || impact.erImpact || impact.uiImpact || impact.apiImpact || impact.testImpact) {
                  <div class="md:col-span-2 bg-[var(--bg)] rounded-lg p-3 border border-[var(--border)]">
                    <p class="font-medium text-[var(--text-active)] mb-1">รายละเอียดผลกระทบ:</p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-1 text-xs text-[var(--text-muted)]">
                      @if (impact.dfdImpact) { <span><span class="font-medium">DFD:</span> {{ impact.dfdImpact }}</span> }
                      @if (impact.erImpact) { <span><span class="font-medium">ER:</span> {{ impact.erImpact }}</span> }
                      @if (impact.uiImpact) { <span><span class="font-medium">UI:</span> {{ impact.uiImpact }}</span> }
                      @if (impact.apiImpact) { <span><span class="font-medium">API:</span> {{ impact.apiImpact }}</span> }
                      @if (impact.testImpact) { <span><span class="font-medium">Test:</span> {{ impact.testImpact }}</span> }
                    </div>
                  </div>
                }
              </div>

              @if (impact.impactedRequirementIds?.length || impact.impactedSpecIds?.length || impact.impactedTaskIds?.length) {
                <div class="text-xs text-[var(--text-muted)] border-t border-[var(--border)] pt-2">
                  <p class="font-medium text-[var(--text-active)]">เอกสารที่ได้รับผลกระทบ (ID):</p>
                  <div class="flex flex-wrap gap-1 mt-1">
                    @for (id of impact.impactedRequirementIds; track id) {
                      <span class="bg-blue-50 dark:bg-blue-900/20 px-2 py-0.5 rounded text-[0.6rem] text-blue-600 dark:text-blue-400">REQ: {{ id | slice:0:8 }}</span>
                    }
                    @for (id of impact.impactedSpecIds; track id) {
                      <span class="bg-purple-50 dark:bg-purple-900/20 px-2 py-0.5 rounded text-[0.6rem] text-purple-600 dark:text-purple-400">SPEC: {{ id | slice:0:8 }}</span>
                    }
                    @for (id of impact.impactedTaskIds; track id) {
                      <span class="bg-emerald-50 dark:bg-emerald-900/20 px-2 py-0.5 rounded text-[0.6rem] text-emerald-600 dark:text-emerald-400">TASK: {{ id | slice:0:8 }}</span>
                    }
                    @for (id of impact.impactedTestCaseIds; track id) {
                      <span class="bg-yellow-50 dark:bg-yellow-900/20 px-2 py-0.5 rounded text-[0.6rem] text-yellow-600 dark:text-yellow-400">TC: {{ id | slice:0:8 }}</span>
                    }
                    @for (id of impact.impactedBugIds; track id) {
                      <span class="bg-red-50 dark:bg-red-900/20 px-2 py-0.5 rounded text-[0.6rem] text-red-600 dark:text-red-400">BUG: {{ id | slice:0:8 }}</span>
                    }
                  </div>
                </div>
              }
            </div>
          } @else if (!isLoadingImpact()) {
            <div class="mt-3 text-center py-6 text-[var(--text-muted)] border border-dashed border-[var(--border)] rounded-lg">
              <i class="bi bi-inbox text-3xl block mb-2 opacity-30"></i>
              <p class="text-sm">ยังไม่มีข้อมูลผลกระทบ</p>
              <button
                type="button"
                (click)="refreshImpact()"
                class="mt-2 text-xs text-[var(--crm-primary)] hover:underline"
              >
                คลิกเพื่อวิเคราะห์อัตโนมัติ
              </button>
            </div>
          }
        </div>
      }

      <!-- Actions -->
      <div class="flex gap-3 pt-2 border-t border-[var(--border)]">
        <sic-button type="submit" variant="primary" [disabled]="isSaving">
          @if (isSaving) {
            <i class="bi bi-arrow-repeat animate-spin me-1"></i>
          }
          {{
            isSaving
              ? 'กำลังบันทึก...'
              : selectedFlowId
                ? (isEdit ? 'บันทึกและส่งขออนุมัติ' : 'สร้างและส่งขออนุมัติ')
                : (isEdit ? 'บันทึก' : 'สร้าง')
          }}
        </sic-button>
        <sic-button type="button" variant="secondary" (click)="cancel()">ยกเลิก</sic-button>
      </div>
    </form>
</div>
</file>

<file path="sic-app/src/app/feature/pm/dt/pmdt09/pmdt09.component.html">
<!-- src/app/feature/pm/dt/pmdt09/pmdt09.component.html -->
<div class="max-w-4xl mx-auto space-y-5 p-2">

  <!-- HEADER -->
  <div class="flex items-center justify-between gap-4 pb-2 border-b border-[var(--border)]">
    <div class="flex items-center gap-3">
      <button
        (click)="goBack()"
        class="w-10 h-10 rounded-full flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/10 transition-all"
        title="กลับ">
        <i class="bi bi-arrow-left text-xl"></i>
      </button>
      <div>
        <h1 class="text-2xl font-bold text-[var(--text-active)] flex items-center gap-2">
          <i class="bi bi-chat-square-quote-fill text-[var(--crm-primary)]"></i>
          กระดานสนทนาโครงการ
        </h1>
        <p class="text-xs text-[var(--text-muted)] mt-0.5">แชร์ความคิดเห็น คำถาม หรือติดตามข่าวสารสำคัญภายในโครงการ</p>
      </div>
    </div>
  </div>

  <!-- ===== CREATE POST TRIGGER ===== -->
  <div class="bg-[var(--sidebar)] rounded-2xl border border-[var(--border)] p-4 shadow-sm">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-full overflow-hidden border border-[var(--border)] bg-[var(--crm-primary)]/10 flex items-center justify-center flex-shrink-0">
        @if (currentUserAvatar()) {
          <img [src]="getAvatarUrl(currentUserAvatar()!)" [alt]="currentUserName()" class="w-full h-full object-cover" />
        } @else {
          <span class="text-base font-bold text-[var(--crm-primary)]">
            {{ currentUserName().charAt(0) || 'U' }}
          </span>
        }
      </div>
      <button
        type="button"
        (click)="openCreateModal()"
        class="flex-1 bg-[var(--bg)] hover:bg-[var(--sidebar-hover)] text-left text-[var(--text-muted)] px-4 py-2.5 rounded-full border border-[var(--border)] transition-all cursor-pointer text-sm font-medium flex items-center justify-between">
        <span>คุณกำลังคิดอะไรอยู่, {{ currentUserName() }}?</span>
        <i class="bi bi-pencil-square text-base text-[var(--crm-primary)]"></i>
      </button>
    </div>
  </div>

  <!-- ===== LOADING ===== -->
  @if (isLoading() && posts().length === 0) {
    <div class="flex flex-col items-center justify-center py-16 gap-3">
      <div class="w-10 h-10 border-4 border-[var(--border)] border-t-[var(--crm-primary)] rounded-full animate-spin"></div>
      <p class="text-sm text-[var(--text-muted)]">กำลังดึงข้อมูลโพสต์ทั้งหมด...</p>
    </div>
  }

  <!-- ===== POSTS FEED ===== -->
  <div class="space-y-5">
    @for (post of posts(); track post.id) {
      <div class="bg-[var(--sidebar)] rounded-2xl border border-[var(--border)] shadow-sm overflow-hidden transition-all hover:border-[var(--crm-primary)]/30">

        <!-- ===== POST HEADER ===== -->
        <div class="p-4 flex items-start gap-3">
          <div class="w-10 h-10 rounded-full overflow-hidden border border-[var(--border)] bg-[var(--crm-primary)]/10 flex items-center justify-center flex-shrink-0">
            @if (post.userAvatarUrl) {
              <img [src]="getAvatarUrl(post.userAvatarUrl)" [alt]="post.createdByName" class="w-full h-full object-cover" />
            } @else {
              <span class="text-sm font-bold text-[var(--crm-primary)]">
                {{ post.createdByName?.charAt(0) || '?' }}
              </span>
            }
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-sm text-[var(--text-active)] flex items-center gap-1.5">
              <span>{{ post.createdByName }}</span>
              @if (post.pinned) {
                <span class="text-xs px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 font-normal">📌 ปักหมุด</span>
              }
            </h3>
            <p class="text-xs text-[var(--text-muted)] flex items-center gap-1 mt-0.5">
              <span>{{ formatDate(post.createdDate) }}</span>
              <span>•</span>
              <i class="bi bi-globe text-[10px]"></i>
            </p>
          </div>
          @if (isAuthor(post.createdBy)) {
            <div class="flex items-center gap-1">
              <button
                (click)="openEditModal(post)"
                class="w-8 h-8 rounded-full flex items-center justify-center text-[var(--text-muted)] hover:text-amber-500 hover:bg-amber-500/10 transition-all"
                title="แก้ไขโพสต์">
                <i class="bi bi-pencil text-sm"></i>
              </button>
              <button
                (click)="deletePost(post.id)"
                class="w-8 h-8 rounded-full flex items-center justify-center text-[var(--text-muted)] hover:text-red-500 hover:bg-red-500/10 transition-all"
                title="ลบโพสต์">
                <i class="bi bi-trash text-sm"></i>
              </button>
            </div>
          }
        </div>

        <!-- ===== POST SUBJECT ===== -->
        <div class="px-4 pb-1">
          <h2 class="text-base font-bold text-[var(--text-active)] tracking-wide">
            {{ post.subject }}
          </h2>
        </div>

        <!-- ===== POST CONTENT ===== -->
        <div class="px-4 py-2 text-sm text-[var(--text-active)] leading-relaxed whitespace-pre-wrap">
          {{ post.content }}
        </div>

        <!-- ===== ATTACHMENTS ===== -->
        @if (post.attachmentGroupId) {
          <div class="px-4 pb-3">
            <div class="grid grid-cols-1 gap-2">
              @for (file of getAttachments(post.attachmentGroupId); track file.id) {
                <div
                  class="rounded-xl overflow-hidden border border-[var(--border)] bg-[var(--bg)] hover:border-[var(--crm-primary)]/30 transition-all"
                  [class.cursor-pointer]="isImage(file) || isVideo(file)"
                  (click)="previewFile(file)"
                >
                  @if (isImage(file)) {
                    <img
                      [src]="file.accessUrl"
                      [alt]="file.fileName"
                      class="w-full max-h-[400px] object-contain bg-black/5"
                      loading="lazy"
                    />
                    <div class="p-2 text-xs text-[var(--text-muted)] flex items-center justify-between bg-[var(--bg)]/50">
                      <span class="flex items-center gap-1.5">
                        <i class="bi bi-image text-emerald-500"></i>
                        {{ file.fileName }}
                      </span>
                      <span class="flex items-center gap-1.5">
                        <span>{{ formatFileSize(file.fileSize) }}</span>
                        <button
                          (click)="$event.stopPropagation(); downloadFile(file.accessUrl, file.fileName)"
                          class="text-[var(--crm-primary)] hover:underline text-xs"
                        >
                          <i class="bi bi-download"></i>
                        </button>
                      </span>
                    </div>
                  } @else if (isVideo(file)) {
                    <video
                      controls
                      preload="metadata"
                      class="w-full max-h-[400px] bg-black/5"
                      [src]="file.accessUrl"
                      playsinline
                    ></video>
                    <div class="p-2 text-xs text-[var(--text-muted)] flex items-center justify-between bg-[var(--bg)]/50">
                      <span class="flex items-center gap-1.5">
                        <i class="bi bi-play-circle text-blue-500"></i>
                        {{ file.fileName }}
                      </span>
                      <span class="flex items-center gap-1.5">
                        <span>{{ formatFileSize(file.fileSize) }}</span>
                        <button
                          (click)="$event.stopPropagation(); downloadFile(file.accessUrl, file.fileName)"
                          class="text-[var(--crm-primary)] hover:underline text-xs"
                        >
                          <i class="bi bi-download"></i>
                        </button>
                      </span>
                    </div>
                  } @else if (isAudio(file)) {
                    <div class="p-4 bg-[var(--bg)]">
                      <audio controls class="w-full" [src]="file.accessUrl" preload="metadata"></audio>
                      <div class="mt-2 text-xs text-[var(--text-muted)] flex items-center justify-between">
                        <span class="flex items-center gap-1.5">
                          <i class="bi bi-music-note text-purple-500"></i>
                          {{ file.fileName }}
                        </span>
                        <span class="flex items-center gap-1.5">
                          <span>{{ formatFileSize(file.fileSize) }}</span>
                          <button
                            (click)="downloadFile(file.accessUrl, file.fileName)"
                            class="text-[var(--crm-primary)] hover:underline text-xs"
                          >
                            <i class="bi bi-download"></i>
                          </button>
                        </span>
                      </div>
                    </div>
                  } @else {
                    <div class="flex items-center gap-3 p-3 hover:bg-[var(--sidebar-hover)] transition-colors">
                      <div class="w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0"
                           [class.bg-red-100]="isPdf(file)"
                           [class.bg-blue-100]="isWord(file)"
                           [class.bg-green-100]="isExcel(file)"
                           [class.bg-yellow-100]="isPowerPoint(file)"
                           [class.bg-gray-100]="isOtherDocument(file)"
                      >
                        <i class="bi text-2xl"
                           [class.bi-filetype-pdf]="isPdf(file)"
                           [class.bi-file-word]="isWord(file)"
                           [class.bi-file-excel]="isExcel(file)"
                           [class.bi-file-ppt]="isPowerPoint(file)"
                           [class.bi-file-earmark]="isOtherDocument(file)"
                           [class.text-red-600]="isPdf(file)"
                           [class.text-blue-600]="isWord(file)"
                           [class.text-green-600]="isExcel(file)"
                           [class.text-yellow-600]="isPowerPoint(file)"
                           [class.text-gray-600]="isOtherDocument(file)"
                        ></i>
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-[var(--text-active)] truncate">{{ file.fileName }}</p>
                        <p class="text-xs text-[var(--text-muted)]">{{ formatFileSize(file.fileSize) }}</p>
                      </div>
                      <button
                        (click)="downloadFile(file.accessUrl, file.fileName)"
                        class="px-3 py-1.5 rounded-lg text-xs font-medium text-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/10 transition-all"
                      >
                        <i class="bi bi-download"></i> ดาวน์โหลด
                      </button>
                    </div>
                  }
                </div>
              }
            </div>
          </div>
        }

        <!-- ===== POST STATS ===== -->
        <div class="px-4 py-2 border-t border-[var(--border)]/60 flex items-center justify-between text-xs text-[var(--text-muted)]">
          <span class="flex items-center gap-1">ความคิดเห็น</span>
        </div>

        <!-- ===== ACTION BAR ===== -->
        <div class="px-2 py-1 bg-[var(--bg)]/30 border-t border-[var(--border)] flex items-center gap-1">
          <button
            type="button"
            (click)="toggleExpand(post.id)"
            class="flex-1 py-1.5 rounded-lg hover:bg-[var(--sidebar-hover)] flex items-center justify-center gap-2 text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--crm-primary)] transition-all">
            <i class="bi" [class.bi-chevron-up]="expandedPostId() === post.id" [class.bi-chevron-down]="expandedPostId() !== post.id"></i>
            <span>{{ expandedPostId() === post.id ? 'ซ่อนความคิดเห็น' : 'แสดงความคิดเห็น' }}</span>
          </button>
        </div>

        <!-- ===== COMMENTS SECTION ===== -->
        @if (expandedPostId() === post.id) {
          <div class="p-4 bg-[var(--bg)]/40 border-t border-[var(--border)] space-y-4">

            <!-- รายการความคิดเห็น -->
            @if (post.replies && post.replies.length > 0) {
              <div class="space-y-3">
                @for (reply of post.replies; track reply.id) {
                  <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-full overflow-hidden border border-[var(--border)] bg-[var(--crm-primary)]/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                      @if (reply.userAvatarUrl) {
                        <img [src]="getAvatarUrl(reply.userAvatarUrl)" [alt]="reply.createdByName" class="w-full h-full object-cover" />
                      } @else {
                        <span class="text-xs font-bold text-[var(--crm-primary)]">
                          {{ reply.createdByName?.charAt(0) || '?' }}
                        </span>
                      }
                    </div>
                    <div class="flex-1 min-w-0">
                      @if (editingCommentId() === reply.id) {
                        <div class="bg-[var(--sidebar)] p-3 rounded-2xl border border-[var(--border)]">
                          <form [formGroup]="editForm" (ngSubmit)="submitEdit()">
                            <sic-input-area formControlName="content" [rows]="2" [required]="true"></sic-input-area>
                            <div class="flex justify-end gap-2 mt-2">
                              <button type="button" (click)="cancelEdit()" class="px-3 py-1 rounded-full text-xs border border-[var(--border)] hover:bg-[var(--sidebar-hover)]">ยกเลิก</button>
                              <button type="submit" class="px-3 py-1 rounded-full text-xs text-white bg-[var(--crm-primary)] hover:opacity-90" [disabled]="isSubmitting()">บันทึก</button>
                            </div>
                          </form>
                        </div>
                      } @else {
                        <div class="bg-[var(--sidebar)] px-3.5 py-2 rounded-2xl border border-[var(--border)] inline-block max-w-full">
                          <div class="flex items-center justify-between gap-4">
                            <span class="font-semibold text-xs text-[var(--text-active)]">{{ reply.createdByName }}</span>
                          </div>
                          <p class="text-xs text-[var(--text-active)] mt-0.5 whitespace-pre-wrap leading-normal">{{ reply.content }}</p>
                        </div>

                        <!-- แสดงไฟล์แนบของ reply -->
                        @if (reply.attachmentGroupId) {
                          <div class="mt-1.5 ml-2">
                            @for (file of getAttachments(reply.attachmentGroupId); track file.id) {
                              <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-xs text-[var(--text-muted)] mr-1.5 mb-1">
                                @if (isImage(file)) {
                                  <img [src]="file.accessUrl" class="w-6 h-6 rounded object-cover" [alt]="file.fileName" />
                                } @else {
                                  <i class="bi" [class]="isVideo(file) ? 'bi-play-circle' : 'bi-file-earmark'"></i>
                                }
                                <span class="truncate max-w-[120px]">{{ file.fileName }}</span>
                                <button
                                  (click)="downloadFile(file.accessUrl, file.fileName)"
                                  class="text-[var(--crm-primary)] hover:underline"
                                  title="ดาวน์โหลด"
                                >
                                  <i class="bi bi-download"></i>
                                </button>
                              </div>
                            }
                          </div>
                        }
                      }

                      <!-- ปุ่ม action ของ reply -->
                      <div class="flex items-center gap-3 text-[11px] text-[var(--text-muted)] mt-1 ml-2">
                        <span>{{ formatDate(reply.createdDate) }}</span>
                        <span>•</span>
                        <button type="button" (click)="startReply(post.id, reply.createdByName)" class="font-semibold hover:underline hover:text-[var(--crm-primary)]">ตอบกลับ</button>
                        @if (isAuthor(reply.createdBy)) {
                          <span>•</span>
                          <button type="button" (click)="startEditReply(post.id, reply.id)" class="hover:underline hover:text-amber-500">แก้ไข</button>
                          <span>•</span>
                          <button type="button" (click)="deleteReply(post.id, reply.id)" class="hover:underline hover:text-red-500">ลบ</button>
                        }
                      </div>
                    </div>
                  </div>
                }
              </div>
            }

            <!-- ===== ฟอร์มแสดงความคิดเห็น (comment) หรือ ตอบกลับ (reply) ===== -->
            @if (replyingPostId() !== post.id) {
              <!-- ===== ฟอร์มแสดงความคิดเห็น (comment) ===== -->
              <div class="flex items-start gap-2.5 pt-2 border-t border-[var(--border)]/50">
                <div class="w-8 h-8 rounded-full overflow-hidden border border-[var(--border)] bg-[var(--crm-primary)]/10 flex items-center justify-center flex-shrink-0 mt-1">
                  @if (currentUserAvatar()) {
                    <img [src]="getAvatarUrl(currentUserAvatar()!)" [alt]="currentUserName()" class="w-full h-full object-cover" />
                  } @else {
                    <span class="text-xs font-bold text-[var(--crm-primary)]">
                      {{ currentUserName().charAt(0) || 'U' }}
                    </span>
                  }
                </div>
                <div class="flex-1 min-w-0">
                  <form [formGroup]="commentForm" class="space-y-2">
                    <div class="relative">
                      <sic-input-area
                        formControlName="content"
                        [rows]="2"
                        placeholder="เขียนความคิดเห็นของคุณ..."
                        [required]="true"
                      ></sic-input-area>
                    </div>

                    <!-- แนบไฟล์ -->
                    <div class="mt-1">
                      <sic-input-upload
                        label=""
                        formControlName="attachmentGroupId"
                        [multiple]="true"
                        category="all"
                        [visibility]="1"
                        helperText=""
                        emptyText="คลิกเพื่อแนบไฟล์"
                      ></sic-input-upload>
                    </div>

                    <div class="flex justify-end">
                      <button
                        type="button"
                        (click)="submitComment()"
                        class="px-4 py-1.5 rounded-full text-xs font-semibold text-white bg-[var(--crm-primary)] hover:opacity-90 transition-all flex items-center gap-1"
                        [disabled]="isSubmitting() || commentForm.invalid"
                      >
                        @if (isSubmitting()) {
                          <i class="bi bi-arrow-repeat animate-spin"></i>
                        } @else {
                          <i class="bi bi-send"></i>
                        }
                        ส่งความคิดเห็น
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            } @else {
              <!-- ===== ฟอร์มตอบกลับ (reply) – แทนที่ฟอร์มเดิมเมื่อ replyingPostId ตรงกับ post.id ===== -->
              <div class="flex items-start gap-2.5 pt-2 border-t border-[var(--border)]/50">
                <div class="w-8 h-8 rounded-full overflow-hidden border border-[var(--border)] bg-[var(--crm-primary)]/10 flex items-center justify-center flex-shrink-0 mt-1">
                  @if (currentUserAvatar()) {
                    <img [src]="getAvatarUrl(currentUserAvatar()!)" [alt]="currentUserName()" class="w-full h-full object-cover" />
                  } @else {
                    <span class="text-xs font-bold text-[var(--crm-primary)]">
                      {{ currentUserName().charAt(0) || 'U' }}
                    </span>
                  }
                </div>
                <div class="flex-1 min-w-0">
                  <form [formGroup]="replyForm" class="space-y-2">
                    <div class="relative">
                      <sic-input-area
                        formControlName="content"
                        [rows]="2"
                        placeholder="พิมพ์ข้อความตอบกลับ..."
                        [required]="true"
                      ></sic-input-area>
                    </div>

                    <!-- แนบไฟล์ -->
                    <div class="mt-1">
                      <sic-input-upload
                        label=""
                        formControlName="attachmentGroupId"
                        [multiple]="true"
                        category="all"
                        [visibility]="1"
                        helperText=""
                        emptyText="คลิกเพื่อแนบไฟล์"
                      ></sic-input-upload>
                    </div>

                    <div class="flex items-center justify-between gap-2">
                      <span class="text-xs text-[var(--text-muted)]">
                        @if (replyToUser()) {
                          ตอบกลับไปยัง <b class="text-[var(--crm-primary)]">@{{ replyToUser() }}</b>
                        }
                      </span>
                      <div class="flex items-center gap-2">
                        <button
                          type="button"
                          (click)="cancelReply()"
                          class="px-3 py-1 rounded-full text-xs border border-[var(--border)] hover:bg-[var(--sidebar-hover)]"
                        >
                          ยกเลิก
                        </button>
                        <button
                          type="button"
                          (click)="submitReply()"
                          class="px-4 py-1.5 rounded-full text-xs font-semibold text-white bg-[var(--crm-primary)] hover:opacity-90 transition-all flex items-center gap-1"
                          [disabled]="isSubmitting() || replyForm.invalid"
                        >
                          @if (isSubmitting()) {
                            <i class="bi bi-arrow-repeat animate-spin"></i>
                          } @else {
                            <i class="bi bi-send"></i>
                          }
                          ตอบกลับ
                        </button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            }

          </div>
        }

      </div>
    } @empty {
      @if (!isLoading()) {
        <div class="text-center py-16 bg-[var(--sidebar)] rounded-2xl border border-[var(--border)] text-[var(--text-muted)]">
          <i class="bi bi-chat-square-dots text-5xl block mb-3 text-[var(--crm-primary)]/40"></i>
          <p class="text-base font-semibold text-[var(--text-active)]">ยังไม่มีหัวข้อพูดคุยในโครงการนี้</p>
          <p class="text-xs text-[var(--text-muted)] mt-1">มาร่วมเริ่มสร้างโพสต์แรกเพื่อแลกเปลี่ยนความคิดเห็นกับทีมงาน</p>
          <button
            type="button"
            (click)="openCreateModal()"
            class="mt-4 px-5 py-2 rounded-full text-xs font-semibold text-white bg-[var(--crm-primary)] hover:opacity-90 inline-flex items-center gap-1.5 transition-all"
          >
            <i class="bi bi-plus-circle"></i> สร้างโพสต์แรก
          </button>
        </div>
      }
    }
  </div>

  <!-- ===== LOAD MORE ===== -->
  @if (totalElements() > 0 && currentPage() < totalPages() - 1) {
    <div class="flex justify-center pt-2">
      <button
        (click)="loadMore()"
        class="px-6 py-2.5 rounded-full text-xs font-semibold border border-[var(--border)] bg-[var(--sidebar)] text-[var(--text-active)] hover:bg-[var(--sidebar-hover)] transition-all shadow-sm flex items-center gap-2"
        [disabled]="isLoading()"
      >
        @if (isLoading()) {
          <i class="bi bi-arrow-repeat animate-spin"></i> Loading...
        } @else {
          <i class="bi bi-arrow-down-circle"></i> โหลดโพสต์เพิ่มเติม
        }
      </button>
    </div>
  }

  <!-- ===== PMDT09A MODAL ===== -->
  @if (isModalOpen()) {
    <app-pmdt09a
      [projectId]="projectId()!"
      [postToEdit]="postToEdit()"
      [currentUserAvatar]="getAvatarUrl(currentUserAvatar()!)"
      [currentUserName]="currentUserName()"
      (saved)="onPostSaved($event)"
      (closed)="closeModal()"
    ></app-pmdt09a>
  }

</div>
</file>

<file path="sic-app/src/app/feature/pm/dt/pmdt06/pmdt06A/pmdt06A.component.html">
<!-- src/app/feature/pm/dt/pmdt06/pmdt06A/pmdt06A.component.html -->

<div class="h-full flex flex-col bg-[var(--bg)]">
  <div
    class="flex items-center justify-between px-4 py-2 border-b border-[var(--border)] bg-[var(--sidebar)] flex-shrink-0"
  >
    <h3 class="text-sm font-medium">AI Assistant</h3>
    <button
      (click)="clearChat()"
      class="text-xs text-[var(--text-muted)] hover:text-[var(--crm-danger)] transition-colors"
    >
      Clear
    </button>
  </div>
  <div #chatContainer class="flex-1 overflow-y-auto p-3 space-y-3">
    @for (message of messages(); track message.id) {
      <div class="flex" [class.justify-end]="message.role === 'user'">
        <div
          class="max-w-[80%] px-4 py-2 rounded-xl relative"
          [class.bg-[var(--crm-primary)]]="message.role === 'user'"
          [class.text-white]="message.role === 'user'"
          [class.bg-[var(--sidebar)]]="message.role === 'assistant'"
        >
          <div
            [class.text-sm]="message.role === 'user'"
            [class.prose]="message.role === 'assistant'"
          >
            <markdown
              [data]="message.content"
              [class.text-white]="message.role === 'user'"
            ></markdown>
          </div>
          <div class="text-xs mt-1 opacity-60 flex justify-between items-center">
            <span>{{ message.createdAt | date: 'shortTime' }}</span>
            <!-- ✅ ปุ่ม Copy Mermaid ที่เปลี่ยนข้อความตามสถานะ -->
            @if (message.role === 'assistant' && getMermaidCode(message.content)) {
              @if (copiedStatus()[message.id]) {
                <span class="text-green-500 text-xs font-medium">Copied!</span>
              } @else {
                <button
                  (click)="copyMermaidCode(message.content, message.id)"
                  class="text-[var(--crm-primary)] hover:underline flex items-center gap-1 text-xs"
                  title="คัดลอก Mermaid Code"
                >
                  <i class="bi bi-clipboard"></i> Copy Mermaid
                </button>
              }
            }
          </div>
        </div>
      </div>
    }
    @if (isLoading()) {
      <div class="flex justify-start">
        <div class="bg-[var(--sidebar)] px-4 py-2 rounded-xl text-sm">
          <span class="animate-pulse">AI is thinking...</span>
        </div>
      </div>
    }
  </div>
  <div class="p-3 border-t border-[var(--border)] bg-[var(--sidebar)] flex-shrink-0">
    <div class="flex gap-2">
      <input
        [(ngModel)]="userInput"
        (keydown.enter)="sendMessage()"
        placeholder="Ask AI to create or modify diagrams..."
        class="flex-1 px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-sm outline-none focus:border-[var(--crm-primary)] transition-colors"
      />
      <button
        (click)="sendMessage()"
        class="px-4 py-2 rounded-lg bg-[var(--crm-primary)] text-white text-sm font-medium disabled:opacity-50"
        [disabled]="isLoading() || !userInput.trim()"
      >
        Send
      </button>
    </div>
  </div>
</div>
</file>

