        <sic-input
          label="ชื่อโครงการ"
          formControlName="projectName"
          [required]="true"
          placeholder="ระบบ CRM"
        ></sic-input>
        @if (form.get('projectName')?.touched && form.get('projectName')?.invalid) {
          <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุชื่อโครงการ</p>
        }
      </div>

      <!-- ✅ Hidden fields -->
      <input type="hidden" formControlName="customerId" />
      <input type="hidden" formControlName="contractId" />
      <input type="hidden" formControlName="contractNo" />

      <!-- Dates -->
      <div class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3 flex gap-6">
        <div class="flex-1">
          <sic-datepicker
            label="วันที่เริ่ม"
            formControlName="startDate"
            [required]="true"
            placeholder="เลือกวันที่เริ่ม"
          ></sic-datepicker>
          @if (form.get('startDate')?.touched && form.get('startDate')?.invalid) {
            <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุวันที่เริ่ม</p>
          }
        </div>
        <div class="flex-1">
          <sic-datepicker
            label="วันที่สิ้นสุดตามแผน"
            formControlName="plannedEndDate"
            [required]="true"
            placeholder="เลือกวันที่สิ้นสุด"
          ></sic-datepicker>
          @if (form.get('plannedEndDate')?.touched && form.get('plannedEndDate')?.invalid) {
            <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุวันที่สิ้นสุด</p>
          }
        </div>
      </div>

      <!-- Actual End Date (Optional) -->
      <div class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3">
        <sic-datepicker
          label="วันที่สิ้นสุดจริง"
          formControlName="actualEndDate"
          placeholder="เลือกวันที่สิ้นสุดจริง"
        ></sic-datepicker>
      </div>

      <!-- Mandays -->
      <div class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3 flex gap-6">
        <div class="flex-1">
          <sic-number
            label="Manday ตามแผน"
            formControlName="budgetManday"
            [required]="true"
            placeholder="0"
          ></sic-number>
          @if (form.get('budgetManday')?.touched && form.get('budgetManday')?.invalid) {
            <p class="text-xs text-[var(--crm-danger)] mt-1">กรุณาระบุ Manday</p>
          }
        </div>
        <div class="flex-1">
          <sic-number
            label="Manday ที่ใช้จริง"
            formControlName="usedManday"
            placeholder="0"
          ></sic-number>
        </div>
      </div>

      <!-- ✅ Status & Priority (ใช้ Select ธรรมดาแทน Combobox) -->
      <div class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3 flex gap-6">
        <div class="flex-1">
          <label class="block text-sm font-medium text-[var(--text-active)] mb-1">สถานะโครงการ</label>
          <select
            formControlName="status"
            class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20"
          >
            @for (status of statusOptions; track status) {
              <option [value]="status">{{ status }}</option>
            }
          </select>
        </div>
        <div class="flex-1">
          <label class="block text-sm font-medium text-[var(--text-active)] mb-1">ระดับความสำคัญ</label>
          <select
            formControlName="priority"
            class="w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--crm-primary)]/20"
          >
            @for (priority of priorityOptions; track priority) {
              <option [value]="priority">{{ priority }}</option>
            }
          </select>
        </div>
      </div>

      <!-- Description -->
      <div class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3">
        <sic-input-area
          label="คำอธิบายเพิ่มเติม"
          formControlName="description"
          [rows]="3"
          placeholder="รายละเอียดเพิ่มเติมเกี่ยวกับโครงการ"
        ></sic-input-area>
      </div>

      <!-- Active Status -->
      <div class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3">
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input
            type="checkbox"
            formControlName="isActive"
            class="w-4 h-4 text-[var(--crm-primary)] focus:ring-[var(--crm-primary)]/20 rounded"
          />
          <span class="text-[var(--text-active)]">เปิดใช้งานโครงการ</span>
        </label>
      </div>

      <!-- Buttons -->
      <div class="col-span-11 col-start-1 md:col-span-4 md:col-start-2 lg:col-span-2 lg:col-start-3 flex gap-6 mt-5">
        <div class="flex-1">
          <sic-button [fullWidth]="true" [type]="'button'" variant="secondary" (click)="onBack()">
            <i class="bi bi-arrow-left"></i> ย้อนกลับ
          </sic-button>
        </div>
        <div class="flex-1">
          <sic-button [fullWidth]="true" [type]="'submit'" variant="primary">
            <i class="bi bi-floppy"></i>
            {{ isEdit ? 'บันทึก' : 'สร้าง' }}
          </sic-button>
        </div>
      </div>

    </div>
  </form>
}
</file>

