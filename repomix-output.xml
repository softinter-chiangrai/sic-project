<!-- sic-app/src/app/feature/bu/rt/burt06/burt06.component.html -->
<div class="space-y-5 p-0.5">
  <!-- HEADER -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-semibold text-[var(--text-active)] flex items-center gap-2">
        <i class="bi bi-check2-circle text-[var(--crm-primary)]"></i>
        จัดการ Approval Flow
      </h1>
      <span class="text-sm text-[var(--text-muted)] bg-[var(--bg)] px-3 py-0.5 rounded-full border border-[var(--border)]">
        {{ flows().length }} รายการ
      </span>
    </div>
    <button
      (click)="openCreateForm()"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
    >
      <i class="bi bi-plus-lg"></i>
      สร้าง Approval Flow
    </button>
  </div>

  <!-- LOADING -->
  @if (isLoading()) {
    <div class="flex flex-col items-center justify-center py-12 gap-3">
      <div class="w-10 h-10 border-4 border-[var(--border)] border-t-[var(--crm-primary)] rounded-full animate-spin"></div>
      <p class="text-sm text-[var(--text-muted)]">กำลังโหลดข้อมูล...</p>
    </div>
  }

  <!-- TABLE -->
  @if (!isLoading()) {
    <div class="overflow-x-auto rounded-xl border border-[var(--border)] bg-[var(--sidebar)] shadow-sm">
      <table class="w-full text-sm">
        <thead class="bg-[var(--bg)] border-b border-[var(--border)]">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[150px]">
              รหัส Flow
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[180px]">
              ชื่อ Flow
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[130px]">
              ประเภทเอกสาร
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[100px]">
              โหมด
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[60px]">
              Steps
            </th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[80px]">
              สถานะ
            </th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider min-w-[200px]">
              จัดการ
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--border)]">
          @for (flow of flows(); track flow.id) {
            <tr class="hover:bg-[var(--sidebar-hover)] transition-colors">
              <td class="px-4 py-3">
                <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold font-mono tracking-wide text-[var(--crm-primary)] bg-[var(--crm-primary)]/10">
                  {{ flow.flowCode }}
                </span>
              </td>
              <td class="px-4 py-3">
                <span class="font-medium text-[var(--text-active)]">{{ flow.flowName }}</span>
                @if (flow.description) {
                  <div class="text-xs text-[var(--text-muted)] truncate max-w-[200px]">{{ flow.description }}</div>
                }
              </td>
              <td class="px-4 py-3">
                <span class="text-[var(--text)]">{{ getDocumentTypeText(flow.documentType) }}</span>
              </td>
              <td class="px-4 py-3">
                <span class="text-[var(--text-muted)] text-xs">{{ getApprovalModeText(flow.approvalMode) }}</span>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[var(--crm-primary)]/10 text-[var(--crm-primary)] text-sm font-semibold">
                  {{ flow.steps?.length || 0 }}
                </span>
              </td>
              <td class="px-4 py-3">
                <span [class]="getStatusClass(flow.active) + ' inline-block px-2.5 py-0.5 rounded-full text-xs font-medium'">
                  {{ getStatusText(flow.active) }}
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <div class="flex items-center justify-center gap-1">
                  <button
                    (click)="openEditForm(flow)"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-all"
                    title="แก้ไข"
                  >
                    <i class="bi bi-pencil"></i>
                  </button>
                  <button
                    (click)="deleteFlow(flow)"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-muted)] hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-all"
                    title="ลบ"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          } @empty {
            <tr>
              <td colspan="7" class="px-4 py-12 text-center">
                <div class="flex flex-col items-center gap-3">
                  <i class="bi bi-inbox text-5xl text-[var(--text-muted)] opacity-30"></i>
                  <p class="text-lg font-medium text-[var(--text-active)]">ไม่พบ Approval Flow</p>
                  <p class="text-sm text-[var(--text-muted)]">คลิก "สร้าง Approval Flow" เพื่อเริ่มต้น</p>
                  <button
                    (click)="openCreateForm()"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-[var(--crm-primary)] hover:bg-[var(--crm-primary)]/80 transition-all"
                  >
                    <i class="bi bi-plus-lg"></i>
                    สร้าง Approval Flow
                  </button>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
