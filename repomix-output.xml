        <div class="flex-1">
          <sic-button
            [fullWidth]="true"
            [type]="'submit'"
            variant="primary"
          >
            <i class="bi bi-floppy"></i>
            อัปเดตสถานะ
          </sic-button>
        </div>
      </div>
    </div>
  </form>
}
