flowchart TB
  user[ผู้ใช้งานระบบ<br/>PM / SA / Developer / Tester / Admin]
  customer[ลูกค้า / ผู้เกี่ยวข้อง]
  keycloak[Keycloak<br/>Authentication Server]
  ai[AI Provider<br/>Gemini / Claude]
  report[Report Service]

  p1([1<br/>จัดการผู้ใช้ สิทธิ์<br/>และองค์กร])
  p2([2<br/>จัดการลูกค้า<br/>โครงการ และสัญญา])
  p3([3<br/>วิเคราะห์ Requirement<br/>และออกแบบ DFD/ER])
  p4([4<br/>จัดทำเอกสาร<br/>Spec Test และ Manual])
  p5([5<br/>จัดการงาน<br/>อนุมัติ และสื่อสาร])
  p6([6<br/>จัดการไฟล์<br/>และออกรายงาน])
  p7([7<br/>ค้นหา Dashboard<br/>และข้อมูลอ้างอิง])

  d1[(D1 ข้อมูลผู้ใช้ / Profile / Business / Role)]
  d2[(D2 ข้อมูลลูกค้า / Project / Contract)]
  d3[(D3 Requirement / Diagram / Trace Link)]
  d4[(D4 Specification / Test / Manual)]
  d5[(D5 Task / Approval / Chat / Notification)]
  d6[(D6 File Metadata / Object Storage)]
  d7[(D7 Reference / Master Data)]

  user -->|Username Password / Token| p1
  p1 -->|ผลการเข้าสู่ระบบ / เมนูตามสิทธิ์| user
  p1 -->|ตรวจสอบ Token| keycloak
  keycloak -->|ข้อมูลตัวตนและสิทธิ์| p1
  p1 <-->|ข้อมูลผู้ใช้ องค์กร บทบาท สิทธิ์| d1

  user -->|ข้อมูลลูกค้า โครงการ สัญญา MA Invoice| p2
  customer -->|ข้อมูลลูกค้า Requirement Sign-off| p2
  p2 -->|สถานะโครงการ สัญญา Delivery Invoice| user
  p2 -->|เอกสารและสถานะโครงการ| customer
  p2 <-->|ข้อมูลลูกค้า โครงการ สัญญา การชำระเงิน| d2

  p2 -->|ข้อมูลโครงการ / ขอบเขตงาน| p3
  user -->|Requirement / DFD / ER / Design Request| p3
  p3 -->|Requirement ที่จัดหมวดหมู่ / Diagram / Impact| user
  p3 <-->|Requirement Diagram Version Trace Link| d3
  p3 -->|Prompt สร้าง Requirement หรือ Diagram| ai
  ai -->|Draft Requirement / Mermaid / Design Content| p3

  p3 -->|Requirement และ Diagram ที่ยืนยันแล้ว| p4
  user -->|คำขอสร้าง Spec Test Manual| p4
  p4 -->|Specification Test Case User Manual| user
  p4 <-->|Spec Test Scenario Test Case Manual| d4
  p4 -->|Prompt สร้างเอกสาร| ai
  ai -->|Draft Spec Test Manual| p4

  p2 -->|แผนงาน Phase Milestone Work Package| p5
  p3 -->|เอกสารที่ต้อง Review / Approve| p5
  p4 -->|เอกสารที่ต้อง Approve| p5
  user -->|Update Task / Comment / Approve / Chat| p5
  p5 -->|งานที่ได้รับมอบหมาย แจ้งเตือน ประวัติอนุมัติ| user
  p5 <-->|Task Approval Chat Notification Audit Log| d5
  p5 -->|สถานะอนุมัติเอกสาร| p3
  p5 -->|สถานะอนุมัติเอกสาร| p4

  user -->|Upload / Download / Export PDF| p6
  p3 -->|Diagram / Requirement สำหรับ Export| p6
  p4 -->|Spec Test Manual สำหรับ Export| p6
  p6 -->|ไฟล์ Download URL / PDF Report| user
  p6 -->|คำขอสร้าง PDF| report
  report -->|ไฟล์ PDF| p6
  p6 <-->|ข้อมูลไฟล์และที่เก็บไฟล์| d6

  user -->|คำค้นหา / เงื่อนไข Dashboard / Combobox| p7
  p7 -->|ผลค้นหา Dashboard Summary LOV| user
  p7 <-->|ประเทศ จังหวัด Parameter Title| d7
  p7 -->|อ่านข้อมูล Project Summary| d2
  p7 -->|อ่านข้อมูล Document Summary| d3
  p7 -->|อ่านข้อมูล Task Approval Summary| d5

  classDef entity fill:#fff2a8,stroke:#111,stroke-width:1px,color:#111;
  classDef process fill:#fff2a8,stroke:#111,stroke-width:1px,color:#111;
  classDef store fill:#fff2a8,stroke:#111,stroke-width:1px,color:#111;
  class user,customer,keycloak,ai,report entity;
  class p1,p2,p3,p4,p5,p6,p7 process;
  class d1,d2,d3,d4,d5,d6,d7 store;
