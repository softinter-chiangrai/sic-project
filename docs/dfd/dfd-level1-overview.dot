digraph DFD {
  rankdir=LR; newrank=true; nodesep=0.6; ranksep=1.9; splines=true; pad=0.2;
  node [shape=box, style="filled", fontname="Tahoma", fontsize=18, margin="0.25,0.14"];
  edge [fontname="Tahoma", fontsize=15, color="#444444", arrowsize=0.8];
  user [label="ผู้ใช้งานภายในระบบ", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  customer [label="ลูกค้า", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  keycloak [label="Keycloak", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  ai [label="AI Provider", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  report [label="Report Service", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  p1 [label="1.0\nAuth / Business / Access", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p2 [label="2.0\nChat / Notification", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p3 [label="3.0\nCustomer / Project / Finance", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p4 [label="4.0\nRequirement / Design / Trace", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p5 [label="5.0\nTask / Approval / Bug", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p6 [label="6.0\nFile Storage / Report", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p7 [label="7.0\nSearch / Dashboard", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  d1 [label="D1\nAuth/Business", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d2 [label="D2\nChat/Notification", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d3 [label="D3\nCustomer/Project/Finance", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d4 [label="D4\nRequirement/Design", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d5 [label="D5\nTask/Approval/Bug", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d6 [label="D6\nFile Metadata", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d7 [label="D7\nReference/Master", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d8 [label="D8\nObject Files", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  { rank=same; user; customer; }
  user -> customer [style=invis];
  { rank=same; p1; p2; p3; p4; p5; p6; p7; }
  p1 -> p2 [style=invis];
  p2 -> p3 [style=invis];
  p3 -> p4 [style=invis];
  p4 -> p5 [style=invis];
  p5 -> p6 [style=invis];
  p6 -> p7 [style=invis];
  { rank=same; d1; d2; d3; d4; d5; d6; d7; d8; keycloak; ai; report; }
  d1 -> d2 [style=invis];
  d2 -> d3 [style=invis];
  d3 -> d4 [style=invis];
  d4 -> d5 [style=invis];
  d5 -> d6 [style=invis];
  d6 -> d7 [style=invis];
  d7 -> d8 [style=invis];
  d8 -> keycloak [style=invis];
  keycloak -> ai [style=invis];
  ai -> report [style=invis];
  user -> p1 [style=invis, weight=10];
  p1 -> d1 [style=invis, weight=10];
  user -> p1 [constraint=false, label="auth/profile/business request / auth/profile/business result", dir=both];
  p1 -> keycloak [constraint=false, label="JWKS request / signing keys", dir=both];
  p1 -> d1 [constraint=false, label="read/write D1", dir=both];
  user -> p2 [constraint=false, label="chat/notification request / chat/notification result", dir=both];
  p2 -> d2 [constraint=false, label="read/write D2", dir=both];
  p1 -> p2 [constraint=false, label="identity", style=dashed];
  user -> p3 [constraint=false, label="customer/project/finance request / customer/project/finance result", dir=both];
  customer -> p3 [constraint=false, label="delivery sign-off"];
  p3 -> d3 [constraint=false, label="read/write D3", dir=both];
  p3 -> p5 [constraint=false, label="approval", dir=both];
  p3 -> ai [constraint=false, label="AI draft"];
  p3 -> report [constraint=false, label="export"];
  user -> p4 [constraint=false, label="requirement/design request / requirement/design result", dir=both];
  p4 -> d4 [constraint=false, label="read/write D4", dir=both];
  p4 -> ai [constraint=false, label="generate"];
  p4 -> p5 [constraint=false, label="review", dir=both];
  p3 -> p4 [constraint=false, label="project ctx", style=dashed];
  user -> p5 [constraint=false, label="task/approval/bug request / task/approval/bug result", dir=both];
  p5 -> d5 [constraint=false, label="read/write D5", dir=both];
  p5 -> p2 [constraint=false, label="notify"];
  user -> p6 [constraint=false, label="file/report request / file/report result", dir=both];
  p6 -> d6 [constraint=false, label="read/write D6", dir=both];
  p6 -> d8 [constraint=false, label="file bytes", dir=both];
  p6 -> report [constraint=false, label="report"];
  p3 -> p6 [constraint=false, label="attach", style=dashed];
  p4 -> p6 [constraint=false, label="attach", style=dashed];
  user -> p7 [constraint=false, label="search/dashboard request / search/dashboard result", dir=both];
  p7 -> d7 [constraint=false, label="read/write D7", dir=both];
  p7 -> d1 [constraint=false, label="read", style=dashed];
  p7 -> d3 [constraint=false, label="read", style=dashed];
  p7 -> d4 [constraint=false, label="read", style=dashed];
  p7 -> d5 [constraint=false, label="read", style=dashed];
}