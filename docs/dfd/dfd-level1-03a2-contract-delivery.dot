digraph DFD {
  rankdir=LR; newrank=true; nodesep=0.6; ranksep=1.9; splines=true; pad=0.2;
  node [shape=box, style="filled", fontname="Tahoma", fontsize=18, margin="0.25,0.14"];
  edge [fontname="Tahoma", fontsize=15, color="#444444", arrowsize=0.8];
  user [label="ผู้ใช้งานภายในระบบ\nPM / SA / Dev / Tester / Admin", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  customer [label="ลูกค้า / ผู้เกี่ยวข้องภายนอก", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  ai [label="AI Provider\nGemini / Claude", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  report [label="Report Service", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  p33 [label="3.3\nCustomer Contract\nManagement", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p34 [label="3.4\nDelivery and\nAcceptance", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p35ext [label="3.5\nInvoice and Billing\n(see part 2)", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  d3 [label="D3\nCustomer / Project / Contract /\nDelivery / Finance Data", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d5ext [label="D5\nTask / Approval / Bug\n(external)", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  { rank=same; user; customer; }
  user -> customer [style=invis];
  { rank=same; p33; p34; }
  p33 -> p34 [style=invis];
  { rank=same; p35ext; d3; d5ext; ai; report; }
  p35ext -> d3 [style=invis];
  d3 -> d5ext [style=invis];
  d5ext -> ai [style=invis];
  ai -> report [style=invis];
  user -> p33 [style=invis, weight=10];
  p33 -> p35ext [style=invis, weight=10];
  user -> p33 [constraint=false, label="manage contract / contract list", dir=both];
  p33 -> d3 [constraint=false, label="save contract / contract data", dir=both];
  p33 -> ai [constraint=false, label="draft prompt / AI draft", dir=both];
  p33 -> report [constraint=false, label="export request / contract PDF", dir=both];
  p33 -> d5ext [constraint=false, label="revision request / approval status", dir=both];
  user -> p34 [constraint=false, label="manage delivery / delivery list", dir=both];
  p34 -> d3 [constraint=false, label="save delivery / delivery data", dir=both];
  customer -> p34 [constraint=false, label="sign-off"];
  p34 -> ai [constraint=false, label="draft prompt / AI draft", dir=both];
  p34 -> report [constraint=false, label="export request / delivery PDF", dir=both];
  p34 -> d5ext [constraint=false, label="revision request / approval status", dir=both];
  p34 -> p35ext [constraint=false, label="create invoice"];
}