%% title: DFD Level 1 - Process 5.0 (Part 1) - Phase, Milestone, Work Package & Task
%% notation: Gane-Sarson box style (rectangle=process/entity, grey rectangle=data store)
%%{init: {'flowchart': {'nodeSpacing': 22, 'rankSpacing': 50, 'curve': 'basis'}}}%%
flowchart TD
  classDef entity fill:#FFF2CC,stroke:#D6B656,stroke-width:1.5px,color:#333;
  classDef process fill:#FFE6CC,stroke:#D79B00,stroke-width:2px,color:#333;
  classDef store fill:#F5F5F5,stroke:#666666,stroke-width:1px,color:#333;

  user["ผู้ใช้งานภายในระบบ<br/>PM / SA / Dev / Tester / Admin"]

  d5["D5<br/>Phase / Milestone / Task /<br/>Approval / Bug Data"]
  d3ext["D3<br/>Customer/Project/Finance<br/>(external)"]

  p51["5.1<br/>วางแผน<br/>Phase"]
  p52["5.2<br/>วางแผน<br/>Milestone"]
  p53["5.3<br/>จัดการ<br/>Work Package"]
  p54["5.4<br/>มอบหมาย/ติดตาม<br/>Task"]

  %% ===== 5.1 Phase Planning =====
  user -->|"จัดการ Phase"| p51
  p51 -->|"บันทึก Phase"| d5
  d5 -->|"รายการ Phase"| p51
  p51 -->|"ตรวจสอบโครงการ"| d3ext
  d3ext -->|"ข้อมูลโครงการ"| p51
  p51 -->|"รายการ Phase"| user

  %% ===== 5.2 Milestone Planning =====
  user -->|"จัดการ Milestone"| p52
  p52 -->|"บันทึก Milestone"| d5
  d5 -->|"รายการ Milestone"| p52
  p52 -->|"รายการ Milestone"| user

  %% ===== 5.3 Work Package Management =====
  user -->|"จัดการ Work Package"| p53
  p53 -->|"บันทึก Work Package"| d5
  d5 -->|"รายการ Work Package"| p53
  p53 -->|"รายการ Work Package"| user

  %% ===== 5.4 Task Assignment & Tracking =====
  user -->|"จัดการ Task"| p54
  p54 -->|"บันทึก Task"| d5
  d5 -->|"รายการ Task"| p54
  p54 -->|"ตรวจสอบโครงการ"| d3ext
  d3ext -->|"ข้อมูลโครงการ"| p54
  p54 -->|"รายการ Task"| user

  class user entity
  class p51,p52,p53,p54 process
  class d5,d3ext store
