  classDef process fill:#FFE6CC,stroke:#D79B00,stroke-width:2px,color:#333;
  classDef store fill:#F5F5F5,stroke:#666666,stroke-width:1px,color:#333;

  user["ผู้ใช้งานภายในระบบ<br/>PM / SA / Dev / Tester / Admin"]
