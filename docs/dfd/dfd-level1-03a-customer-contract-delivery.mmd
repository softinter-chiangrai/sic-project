  ai["AI Provider<br/>Gemini / Claude"]
  report["Report Service"]

  p31["3.1<br/>Customer Master<br/>Data"]
  p32["3.2<br/>Customer Project<br/>Setup"]
  p33["3.3<br/>Customer Contract<br/>Management"]
  p34["3.4<br/>Delivery and<br/>Acceptance"]
  p35ext["3.5<br/>Invoice and Billing<br/>(see part 2)"]

  d3["D3<br/>Customer / Project / Contract /<br/>Delivery / Finance Data"]
  d5ext["D5<br/>Task / Approval / Bug<br/>(external)"]

  %% ===== 3.1 Customer Master Data =====
  user -->|"manage customer"| p31
