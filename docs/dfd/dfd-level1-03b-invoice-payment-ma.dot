digraph DFD {
  rankdir=LR; newrank=true; nodesep=0.6; ranksep=1.9; splines=true; pad=0.2;
  node [shape=box, style="filled", fontname="Tahoma", fontsize=18, margin="0.25,0.14"];
  edge [fontname="Tahoma", fontsize=15, color="#444444", arrowsize=0.8];
  user [label="ผู้ใช้งานภายในระบบ\nPM / SA / Dev / Tester / Admin", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  ai [label="AI Provider\nGemini / Claude", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  report [label="Report Service", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  p34ext [label="3.4\nDelivery and Acceptance\n(see part 1)", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p35 [label="3.5\nInvoice and\nBilling", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p36 [label="3.6\nPayment\nRecording", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p37 [label="3.7\nMA Renewal and\nSupport Ticket", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  d3 [label="D3\nCustomer / Project / Contract /\nDelivery / Finance Data", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  d5ext [label="D5\nTask / Approval / Bug\n(external)", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  { rank=same; user; }
  { rank=same; p35; p36; p37; }
  p35 -> p36 [style=invis];
  p36 -> p37 [style=invis];
  { rank=same; p34ext; d3; d5ext; ai; report; }
  p34ext -> d3 [style=invis];
  d3 -> d5ext [style=invis];
  d5ext -> ai [style=invis];
  ai -> report [style=invis];
  user -> p35 [style=invis, weight=10];
  p35 -> p34ext [style=invis, weight=10];
  p34ext -> p35 [constraint=false, label="create invoice"];
  user -> p35 [constraint=false, label="manage invoice / invoice list", dir=both];
  p35 -> d3 [constraint=false, label="save invoice / invoice data", dir=both];
  p35 -> ai [constraint=false, label="draft prompt / AI draft", dir=both];
  p35 -> report [constraint=false, label="export request / invoice PDF", dir=both];
  p35 -> d5ext [constraint=false, label="revision request / approval status", dir=both];
  user -> p36 [constraint=false, label="record payment / payment list", dir=both];
  p36 -> d3 [constraint=false, label="save payment / payment data", dir=both];
  user -> p37 [constraint=false, label="manage renewal/ticket / renewal list", dir=both];
  p37 -> d3 [constraint=false, label="save record / renewal/ticket data", dir=both];
  p37 -> ai [constraint=false, label="draft prompt / AI draft", dir=both];
  p37 -> report [constraint=false, label="export request / renewal PDF", dir=both];
  p37 -> d5ext [constraint=false, label="revision request / approval status", dir=both];
}