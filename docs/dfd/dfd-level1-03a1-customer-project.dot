digraph DFD {
  rankdir=LR; newrank=true; nodesep=0.6; ranksep=1.9; splines=true; pad=0.2;
  node [shape=box, style="filled", fontname="Tahoma", fontsize=18, margin="0.25,0.14"];
  edge [fontname="Tahoma", fontsize=15, color="#444444", arrowsize=0.8];
  user [label="ผู้ใช้งานภายในระบบ\nPM / SA / Dev / Tester / Admin", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  ai [label="AI Provider\nGemini / Claude", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  report [label="Report Service", fillcolor="#FFF2CC", color="#D6B656", penwidth=1.5];
  p31 [label="3.1\nCustomer Master\nData", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  p32 [label="3.2\nCustomer Project\nSetup", fillcolor="#FFE6CC", color="#D79B00", penwidth=2];
  d3 [label="D3\nCustomer / Project / Contract /\nDelivery / Finance Data", fillcolor="#F5F5F5", color="#666666", penwidth=1];
  { rank=same; user; }
  { rank=same; p31; p32; }
  p31 -> p32 [style=invis];
  { rank=same; d3; ai; report; }
  d3 -> ai [style=invis];
  ai -> report [style=invis];
  user -> p31 [style=invis, weight=10];
  p31 -> d3 [style=invis, weight=10];
  user -> p31 [constraint=false, label="manage customer / customer directory", dir=both];
  p31 -> d3 [constraint=false, label="save customer / customer list", dir=both];
  user -> p32 [constraint=false, label="manage project / project list", dir=both];
  p32 -> d3 [constraint=false, label="save project / project data", dir=both];
  p32 -> ai [constraint=false, label="draft prompt / AI draft", dir=both];
  p32 -> report [constraint=false, label="export request / project PDF", dir=both];
}