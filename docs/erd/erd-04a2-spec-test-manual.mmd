%% title: ERD 04a2 - Specification / Test / User Manual
%% Module: SIC Requirement / Analysis / Design / Diagram / Specification / Test (part 2 of 2, see erd-04a1-requirement-diagram.mmd for Requirement/Diagram)
%% NOTE: All entities extend BaseEntity or BaseBusinessEntity (Lombok @Data), which contribute these audit/base
%%       columns not repeated per-entity below: id (PK, UUID), created_by, created_date, updated_by, updated_date,
%%       is_delete, delete_by, delete_date, rowVersion (xmin). BaseBusinessEntity additionally adds business_id (UUID).
%%       Only business-specific columns are listed in each entity box.
%% NOTE: Relationships marked "(inferred)" come from a plain *_id UUID column that follows FK naming convention but
%%       has NO @ManyToOne/@JoinColumn mapping in the Java source (no JPA object graph, DB-level FK only/assumed).
%%       Relationships marked "(mapped)" come from an actual @ManyToOne/@JoinColumn in the entity.

erDiagram
    direction LR

%%{init: {"er": {"diagramPadding": 6, "entityPadding": 8, "minEntityWidth": 70, "minEntityHeight": 30, "fontSize": 16}}}%%

    PmSpecification {
        string specification_code UK
        string specification_type
        string title
        string version
        string status
        string priority
        string owner
        int estimated_manday
        text description
        uuid upload_group_id
        uuid project_id FK "-> PmCustomerProject (mapped, required)"
        uuid requirement_id FK "-> PmRequirement (mapped, optional)"
        boolean is_active
    }

    PmTestScenario {
        uuid project_id "(inferred) -> PmCustomerProject"
        uuid test_plan_id
        uuid task_id FK "-> PmTask (mapped, read-only join)"
        string scenario_code
        string scenario_name
        string priority
        string status
        string test_type "SIT default"
        text description
    }

    PmTestCase {
        uuid project_id
        uuid scenario_id FK "-> PmTestScenario (mapped, read-only join)"
        string scenario_name
        uuid task_id FK "-> PmTask (mapped, read-only join)"
        string test_case_code
        string title
        string priority
        text test_step
        text expected_result
        text actual_result
        string test_status
        string test_type "SIT default"
        string tester
        datetime test_date
        text related_requirement
        text related_spec
        text related_task
    }

    PmUserManual {
        uuid project_id
        string manual_code
        string manual_title
        string manual_type "USER/ADMIN/INSTALLATION/OPERATION/TROUBLESHOOT"
        string version
        uuid related_spec_id
        uuid delivery_id
        string status "DRAFT/REVIEW/APPROVED/PUBLISHED"
        uuid attachment_group_id
    }

    PmUserManualSection {
        uuid manual_id "(inferred) -> PmUserManual, no JPA object mapping"
        string section_code
        string section_title
        text content
        int sort_order
        text permission_roles
        uuid screenshot_group_id
    }

    %% external entity, defined in another module diagram
    PmCustomerProject {
    }

    %% external entity, defined in another module diagram
    PmTask {
    }

    %% external entity, defined in erd-04a1-requirement-diagram.mmd (same module)
    PmRequirement {
    }

    PmCustomerProject ||--o{ PmSpecification : "owns (project_id, mapped)"
    PmCustomerProject ||--o{ PmTestScenario : "owns (project_id, inferred)"
    PmCustomerProject ||--o{ PmUserManual : "owns (project_id, inferred)"

    PmRequirement ||--o{ PmSpecification : "documented by (requirement_id, optional)"

    PmTask ||--o{ PmTestScenario : "verified by (task_id)"
    PmTask ||--o{ PmTestCase : "verified by (task_id)"
    PmSpecification ||--o{ PmTask : "implemented by (spec_id, from PmTask)"

    PmTestScenario ||--o{ PmTestCase : "has test cases (scenario_id)"

    PmUserManual ||--o{ PmUserManualSection : "has sections (manual_id, inferred)"
